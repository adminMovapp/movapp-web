---
import Layout from '@layouts/Layout.astro';
import DirectorioHero from '@sections/aplicaciones-prestamo/DirectorioHero.astro';
import DirectorioBuscador from '@sections/aplicaciones-prestamo/DirectorioBuscador.astro';
import DirectorioReportadas from '@sections/aplicaciones-prestamo/DirectorioReportadas.astro';
import DirectorioReguladas from '@sections/aplicaciones-prestamo/DirectorioReguladas.astro';
import DirectorioComoIdentificamos from '@sections/aplicaciones-prestamo/DirectorioComoIdentificamos.astro';
import DirectorioSenalesAlerta from '@sections/aplicaciones-prestamo/DirectorioSenalesAlerta.astro';
import DirectorioQueHacer from '@sections/aplicaciones-prestamo/DirectorioQueHacer.astro';
import DirectorioMasDudas from '@sections/aplicaciones-prestamo/DirectorioMasDudas.astro';
---

<Layout
   title="Apps de préstamos legales e ilegales en México | Movapp"
   description='Encuentra un listado actualizado con el estatus legal de las apps de crédito en México. Te mostramos las señales de alerta para detectar fraudes o "montadeudas" y una guía directa con qué hacer para proteger tu información o realizar denuncias de forma segura.'
   type="website"
   showGrid={false}
>
   <DirectorioHero />
   <DirectorioBuscador />
   <DirectorioReportadas />
   <DirectorioReguladas />
   <DirectorioComoIdentificamos />
   <DirectorioSenalesAlerta />
   <DirectorioQueHacer />
   <DirectorioMasDudas />
</Layout>
