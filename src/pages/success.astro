---
import Layout from '@layouts/Layout.astro';
---

<Layout title="¡Gracias por tu compra!">
   <section class="mt-32 mb-20 flex flex-col items-center justify-center px-6 text-center" data-aos="zoom-in">
      <!-- Ícono de éxito -->
      <div class="text-green-500 mb-6">
         <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-20 h-20"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
         >
            <path
               stroke-linecap="round"
               stroke-linejoin="round"
               stroke-width="2"
               d="M9 12l2 2 4-4M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"></path>
         </svg>
      </div>

      <!-- Título -->
      <h1 class="text-3xl sm:text-4xl font-bold text-green-500 mb-2">¡Pago realizado con éxito!</h1>

      <!-- Mensaje -->
      <p class="text-lg text-gray-700 dark:text-white max-w-2xl mb-2">
         Gracias por tu compra. Hemos recibido tu pago correctamente. En breve recibirás un correo electrónico con la
         confirmación y los detalles.
      </p>

      <!-- Folio (si Stripe redirige con payment_intent) -->
      <p id="order-folio" class="text-sm text-text_banner font-semibold mb-6"></p>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-4">
         <a
            href="/"
            class="px-6 py-3 bg-background_bottom text-white rounded-full font-semibold shadow hover:bg-background_bottom/80 transition"
         >
            Volver al inicio
         </a>

         <!-- <a
        href="mailto:soporte@movapp.org"
        class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg font-semibold shadow hover:bg-gray-300 transition"
      >
        Contactar soporte
      </a> -->
      </div>
   </section>

   <script>
      // Vaciar el carrito tras un pago exitoso
      try {
         localStorage.removeItem('cart');
         window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: [] } }));
      } catch (e) {}

      // Mostrar folio consultando el pago por payment_intent (si viene en la URL)
      (async function () {
         try {
            const params = new URLSearchParams(window.location.search);
            const pi = params.get('payment_intent');
            if (!pi) return;
            const api = import.meta.env.PUBLIC_API_LINK;
            const res = await fetch(`${api}/payments/web/stripe/intent/${pi}`);
            if (!res.ok) return;
            const data = await res.json();
            const orderId = data?.payment?.order_id;
            if (orderId) {
               const el = document.getElementById('order-folio');
               if (el) el.textContent = `Referencia de pago: ${pi}`;
            }
         } catch (e) {}
      })();
   </script>
</Layout>
