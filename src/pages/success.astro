---
import Layout from '@layouts/Layout.astro';
---

<Layout title="¡Gracias por tu compra!">
   <section class="mt-32 mb-20 flex flex-col items-center justify-center px-6 text-center" data-aos="zoom-in">
      <!-- Ícono de éxito -->
      <div class="text-green-500 mb-6">
         <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-20 h-20"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
         >
            <path
               stroke-linecap="round"
               stroke-linejoin="round"
               stroke-width="2"
               d="M9 12l2 2 4-4M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"></path>
         </svg>
      </div>

      <!-- Título -->
      <h1 class="text-3xl sm:text-4xl font-bold text-green-500 mb-2">¡Pago realizado con éxito!</h1>

      <!-- Mensaje -->
      <p class="text-lg text-gray-700 dark:text-white max-w-2xl mb-2">
         Gracias por tu compra. Hemos recibido tu pago correctamente. En breve recibirás un correo electrónico con la
         confirmación y los detalles.
      </p>

      <!-- Folio (si Stripe redirige con payment_intent) -->
      <p id="order-folio" class="text-sm text-text_banner font-semibold mb-6"></p>

      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-4">
         <a
            href="/"
            class="px-6 py-3 bg-background_bottom text-white rounded-full font-semibold shadow hover:bg-background_bottom/80 transition"
         >
            Volver al inicio
         </a>

         <!-- <a
        href="mailto:soporte@movapp.org"
        class="px-6 py-3 bg-gray-200 text-gray-800 rounded-lg font-semibold shadow hover:bg-gray-300 transition"
      >
        Contactar soporte
      </a> -->
      </div>
   </section>

   <script>
      import { pushToDataLayer, mapCartItemToGA4 } from '@utils/dataLayer.js';
      import { buildPurchasePayload } from '@utils/metaPixelPayloads.js';

      // Snapshot del carrito ANTES de vaciarlo: currency/value/items del
      // purchase de GA4 salen de acá (shape ya conocido). El GET
      // .../stripe/intent/:pi no tiene su shape completo documentado en el
      // repo más allá de payment.order_id, así que no se inventan otros
      // campos de esa respuesta para value/currency/items.
      let purchasedCart = [];
      try {
         purchasedCart = JSON.parse(localStorage.getItem('cart') || '[]');
      } catch (e) {}

      // Vaciar el carrito tras un pago exitoso
      try {
         localStorage.removeItem('cart');
         window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: [] } }));
      } catch (e) {}

      // Mostrar folio consultando el pago por payment_intent (si viene en la URL)
      (async function () {
         try {
            const params = new URLSearchParams(window.location.search);
            const pi = params.get('payment_intent');
            if (!pi) return;
            const api = import.meta.env.PUBLIC_API_LINK;
            const res = await fetch(`${api}/payments/web/stripe/intent/${pi}`);
            if (!res.ok) return;
            const data = await res.json();
            const orderId = data?.payment?.order_id;
            if (orderId) {
               const el = document.getElementById('order-folio');
               if (el) el.textContent = `Referencia de pago: ${pi}`;
            }

            // Anti-duplicado (QA-029): un refresh/back con el mismo
            // payment_intent no debe reemitir purchase.
            const dedupKey = `ga4_purchase_${pi}`;
            if (purchasedCart.length > 0 && !localStorage.getItem(dedupKey)) {
               const value = purchasedCart.reduce(
                  (sum, it) => sum + (Number.parseFloat(it.precio) || 0) * (it.quantity ?? 1),
                  0,
               );
               pushToDataLayer('purchase', {
                  // pi (payment_intent de Stripe) nunca se reinicia; orderId es
                  // un entero secuencial interno que sí (QA de tracking,
                  // sept. 2026: usar el order_id arriesga que GA4 descarte
                  // compras reales como duplicadas tras un reset de la BD).
                  transaction_id: pi || orderId,
                  currency: purchasedCart[0]?.moneda,
                  value,
                  items: purchasedCart.map((it) => mapCartItemToGA4(it)),
               });
               localStorage.setItem(dedupKey, '1');
            }

            // "Purchase" de Meta Pixel, con el mismo anti-duplicado por
            // payment_intent. El snapshot lo dejó ShopIsland.onIntentCreated
            // en sessionStorage (ahí se explica por qué no se emite al crear
            // el intent). window.metaPixel lo crea MetaPixelScript en
            // DOMContentLoaded -- a este punto ya pasó (hubo un fetch en
            // medio); si no existe es porque no hay PUBLIC_META_PIXEL_ID
            // (stage/local) y no se emite nada.
            const metaDedupKey = `meta_purchase_${pi}`;
            let pending = null;
            try {
               pending = JSON.parse(sessionStorage.getItem('meta_pending_purchase') || 'null');
            } catch (e) {}
            if (pending && !localStorage.getItem(metaDedupKey) && window.metaPixel) {
               const { value: metaValue, currency: metaCurrency, contentIds, ...additionalData } = pending;
               const { customData, userData } = buildPurchasePayload(metaValue, metaCurrency, contentIds, {
                  ...additionalData,
                  orderId: orderId || pi,
               });
               await window.metaPixel.track('Purchase', customData, userData);
               localStorage.setItem(metaDedupKey, '1');
               try {
                  sessionStorage.removeItem('meta_pending_purchase');
               } catch (e) {}
            }
         } catch (e) {}
      })();
   </script>
</Layout>
