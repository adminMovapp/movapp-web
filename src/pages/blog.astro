---
import Layout from '@layouts/Layout.astro';
import BlogHero from '@sections/blog/BlogHero.astro';
import BlogCategorySection from '@sections/blog/BlogCategorySection.astro';
import BlogCategoryCTA from '@sections/blog/BlogCategoryCTA.astro';
import { BLOG_HOME_SECTIONS } from '@constants/blog.ts';
---

<Layout
   title="Blog: alertas y noticias sobre apps montadeudas | Movapp"
   description="Entérate de las últimas alertas sobre apps de préstamos montadeudas en México. Casos reales, reportes de usuarios y consejos de Movapp para protegerte."
   type="website"
   showGrid={false}
>
   <BlogHero />
   {
      BLOG_HOME_SECTIONS.map((section) => (
         <BlogCategorySection id={section.id} title={section.title} articles={section.articles} />
      ))
   }
   <BlogCategoryCTA categorySlug="general" />
</Layout>
