---
import Layout from '@layouts/Layout.astro';
import StarprestaHero from '@sections/starpresta/StarprestaHero.astro';
import StarprestaInfo from '@sections/starpresta/StarprestaInfo.astro';
import StarprestaSenalesRiesgo from '@sections/starpresta/StarprestaSenalesRiesgo.astro';
import StarprestaQueHacer from '@sections/starpresta/StarprestaQueHacer.astro';
import StarprestaDondeDenunciar from '@sections/starpresta/StarprestaDondeDenunciar.astro';
import StarprestaFaqs from '@sections/starpresta/StarprestaFaqs.astro';
import StarprestaOtrasApps from '@sections/starpresta/StarprestaOtrasApps.astro';
import StarprestaCTA from '@sections/starpresta/StarprestaCTA.astro';
---

<Layout
   title="Starpresta crea grupos de WhatsApp con contactos | Movapp"
   description="Starpresta arma grupos de WhatsApp con tus contactos para presionar el pago. Conoce las señales de riesgo y qué hacer si ya te está pasando."
   type="website"
   showGrid={false}
   disableCopy
>
   <StarprestaHero />
   <StarprestaInfo />
   <StarprestaSenalesRiesgo />
   <StarprestaQueHacer />
   <StarprestaDondeDenunciar />
   <StarprestaFaqs />
   <StarprestaOtrasApps />
   <StarprestaCTA />
</Layout>
