---
import ButtonContact from '@/components/ButtonContact.astro';
import Layout from '@layouts/Layout.astro';

import ImgFacebook from '@assets/Icono-Facebook.png';
import ImgInstagram from '@assets/Icono-Instagram.png';
import ImgTiktok from '@assets/Icono-Tik-Tok.png';

const ICONS = {
   'Icono-Facebook.png': ImgFacebook,
   'Icono-Instagram.png': ImgInstagram,
   'Icono-Tik-Tok.png': ImgTiktok,
};

import { SOCIALS, VIDEOS } from '@constants/socials.ts';
import { Picture } from 'astro:assets';

// Card glassfrost (mismo lenguaje visual que el index, ver .glass-card en global.css)
const cardHover =
   'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';

// Cómo nació Movapp
const story = [
   {
      title: 'El problema',
      text: 'La idea surgió de una necesidad real. Hace algunos años, Erik Mann pidió un préstamo en una app, pero pronto se vio atrapado en un ciclo de hostigamiento digital que afectó a él y a sus contactos.',
   },
   {
      title: 'Erik sufrió las amenazas',
      text: 'Su tranquilidad fue anulada por las amenazas y deudas generadas por apps no reguladas. Al llegar al límite, Erik compartió su experiencia en el podcast Urban Arts y conectó con otras personas que pasaban por lo mismo.',
   },
   {
      title: 'Creación de El Hack',
      text: 'Erik se dio a la tarea de crear El Hack, una herramienta que protege a los usuarios de aplicaciones fraudulentas, ofreciéndoles una solución confiable y efectiva.',
   },
];

import { generateServiceSchema } from '@/utils/seo.jsx';
const serviceSchema = generateServiceSchema({
   name: 'Asesoría para víctimas de aplicaciones de préstamo fraudulentas',
   description: 'Ayudamos a personas víctimas de montadeudas con apoyo psicológico y asesoría legal',
});
---

<Layout
   title="Movapp"
   description="Movapp es una organización que ayuda a personas víctimas de las aplicaciones de préstamo no reguladas mediante apoyo psicológico, asesoría personalizada y la aplicación de El Hack."
   type="website"
   schema={serviceSchema}
   showGrid={false}
>
   <!-- ───────────────────── HERO ───────────────────── -->
   <section class="relative mx-auto flex max-w-5xl flex-col items-center justify-center px-4 pt-32 pb-12 text-center">
      <div
         class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple_mv/30 bg-purple_mv/10 px-4 py-1.5 text-xs md:text-sm font-medium text-text_banner animate-fadeIn"
      >
         <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple_mv opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-purple_mv"></span>
         </span>
         Protegiéndote desde 2021
      </div>

      <h1 class="mx-auto max-w-4xl text-4xl font-bold leading-tight text-gray-900 dark:text-white md:text-6xl animate-fadeIn">
         Bienvenido a <span class="text-text_banner drop-shadow-[0_0_25px_rgba(129,73,226,0.35)]">Movapp</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-700 dark:text-white/80 md:text-xl">
         Somos tu aliado digital en la lucha contra las aplicaciones no reguladas, también llamadas montadeudas, que
         amenazan tu bienestar financiero y personal.
      </p>

      <div class="mt-8">
         <ButtonContact />
      </div>
   </section>

   <!-- ───────────────── QUIÉNES SOMOS ───────────────── -->
   <section class="relative mx-auto my-12 w-full max-w-4xl px-4" data-aos="fade-up">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
         <div class={`rounded-2xl p-8 shadow-lg ${cardHover}`}>
            <h2 class="mb-3 text-lg md:text-xl font-bold text-text_banner">Acerca de nosotros</h2>
            <p class="text-sm md:text-base text-gray-700 dark:text-white/90">
               Desde 2021 hemos estado brindando apoyo constante a las personas que buscan recuperar el control de sus
               vidas digitales, protegiendo su información personal y evitando el pago de deudas injustas generadas por
               estas aplicaciones.
            </p>
         </div>
         <div class={`rounded-2xl p-8 shadow-lg ${cardHover}`}>
            <h2 class="mb-3 text-lg md:text-xl font-bold text-text_banner">Nuestra misión es clara: PROTEGERTE</h2>
            <p class="text-sm md:text-base text-gray-700 dark:text-white/90">
               Queremos ayudar a personas que han sido víctimas de las aplicaciones no reguladas (montadeudas) que operan
               con un malware llamado SpyLoan, a través de un software especializado cuyo objetivo es evitar que los
               montadeudas tengan acceso a tu información.
            </p>
         </div>
      </div>
   </section>

   <!-- ───────────────── CÓMO NACIÓ MOVAPP (timeline) ───────────────── -->
   <section class="relative mx-auto my-20 w-full max-w-3xl px-4" data-aos="fade-up">
      <div class="mb-12 text-center">
         <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Nuestra historia</span>
         <h2 class="mt-1 text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">
            ¿Cómo nació <span class="text-text_banner">Movapp</span>?
         </h2>
      </div>

      <!-- Línea de tiempo vertical -->
      <div id="storyGrid" class="reveal-stagger relative">
         <!-- Línea conectora -->
         <div
            class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-purple_mv via-purple_mv/40 to-transparent md:left-1/2"
            aria-hidden="true"
         >
         </div>

         {
            story.map((s, i) => (
               <div
                  class:list={[
                     'relative mb-10 flex items-start gap-6 md:mb-12 md:w-1/2',
                     i % 2 === 0
                        ? 'md:ml-0 md:pr-12 md:flex-row-reverse md:text-right'
                        : 'md:ml-auto md:pl-12 md:flex-row',
                  ]}
               >
                  {/* Punto en la línea */}
                  <span
                     class:list={[
                        'absolute left-0 top-1 z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border-2 border-purple_mv bg-gray-50 dark:bg-[#050505]',
                        i % 2 === 0 ? 'md:-right-4 md:left-auto' : 'md:-left-4',
                     ]}
                  >
                     <span class="h-2.5 w-2.5 rounded-full bg-text_banner" />
                  </span>

                  {/* Contenido */}
                  <div class="ml-12 md:ml-0 flex-1">
                     <h3 class="mb-2 text-lg font-bold text-text_banner">{s.title}</h3>
                     <p class="text-sm text-gray-700 dark:text-white/90">{s.text}</p>
                  </div>
               </div>
            ))
         }
      </div>
   </section>

   <!-- ───────────────── VIDEO ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-3xl px-4" data-aos="fade-up">
      <div class={`overflow-hidden rounded-2xl p-2 shadow-lg ${cardHover}`}>
         <div class="aspect-video w-full overflow-hidden rounded-xl">
            <iframe
               src={VIDEOS.movapp}
               title="Conoce Movapp"
               class="h-full w-full"
               loading="lazy"
               frameborder="0"
               referrerpolicy="strict-origin-when-cross-origin"
               allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
               allowfullscreen></iframe>
         </div>
      </div>
   </section>

   <!-- ───────────────── REDES DEL CEO ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-4xl px-4" data-aos="fade-up">
      <div class="mb-10 text-center">
         <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Síguenos</span>
         <h2 class="mt-1 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
            Redes Sociales de Nuestro CEO - Erik Mann
         </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
         {
            SOCIALS.filter((social) => social.name !== 'YouTube').map((social) => (
               <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`flex flex-col items-center rounded-2xl p-8 text-center shadow-lg ${cardHover}`}
               >
                  <div class="mb-4">
                     <Picture
                        src={social.icon ? ICONS[social.icon] : undefined}
                        alt={social.name}
                        class="h-14 w-14"
                     />
                  </div>
                  <div class="text-lg font-bold text-gray-900 dark:text-white">{social.name}</div>
                  <span
                     class="counter mt-1 text-2xl font-bold text-text_banner drop-shadow-[0_0_20px_rgba(129,73,226,0.4)]"
                     data-target={social.count ?? 0}
                  >
                     0
                  </span>
               </a>
            ))
         }
      </div>
   </section>

   <script>
      // Contador animado
      document.querySelectorAll('.counter').forEach((counter) => {
         const updateCounter = () => {
            const target = +counter.getAttribute('data-target');
            let current = +counter.textContent.replace(/,/g, '');
            const increment = target / 500;

            if (current < target) {
               current = Math.ceil(current + increment);
               counter.textContent = current.toLocaleString();
               setTimeout(updateCounter, 1);
            } else {
               counter.textContent = target.toLocaleString();
            }
         };
         updateCounter();
      });

      // Reveal escalonado de la historia (también en móvil, AOS está off <768px)
      const grid = document.getElementById('storyGrid');
      if (grid) {
         const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
         if (reduce || !('IntersectionObserver' in window)) {
            grid.classList.add('in-view');
         } else {
            const io = new IntersectionObserver(
               (entries) => {
                  entries.forEach((entry) => {
                     if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        io.unobserve(entry.target);
                     }
                  });
               },
               { threshold: 0.15 }
            );
            io.observe(grid);
         }
      }
   </script>
</Layout>
