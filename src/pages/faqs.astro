---
import { Picture } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import ImgElHack from '@assets/elhack-blanco.png';
import { FAQS_PAGE_TITLE, FAQS_PAGE_ITEMS as faqs } from '@constants/faqs.ts';
const cardHover =
   'border border-white/10 transition duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:scale-105 cursor-pointer';
---

<Layout title="Preguntas frecuentes">
   <!-- Título principal -->
   <div
      class="mt-32 mb-6 flex flex-col md:flex-row items-center justify-center space-y-4 md:space-y-0 md:space-x-4 text-center md:text-left"
      data-aos="fade-down"
   >
      <h2 class="text-xl md:text-3xl font-bold text-white">Preguntas frecuentes sobre</h2>
      <Picture src={ImgElHack} alt="Movapp Logo" class="w-28 md:w-32 h-auto" />
   </div>

   <!-- Contenedor de las tarjetas (Ajustado para móviles y escritorio) -->
   <div class="grid grid-cols-1 gap-6 mx-8 md:mx-auto mt-10 max-w-xl">
      <!-- Card 1 -->
      <div class={`card p-4 rounded-xl shadow-lg ${cardHover}`}>
         <h2 class="text-xl md:text-2xl font-bold text-white">{FAQS_PAGE_TITLE}</h2>
         {
            faqs.map((item, i) => (
               <div class="mt-4">
                  <div class="subtitle cursor-pointer flex items-center justify-between" id={`title${i}`}>
                     <span class="text-sm md:text-lg text-white font-semibold">{item.q}</span>
                     <span class="text-white" id={`icon${i}`}>
                        +
                     </span>
                  </div>
                  <div id={`detail${i}`} class="detail hidden mt-2 text-white text-justify text-xs md:text-sm">
                     <p class="italic">
                        {item.lines.map((line, j) => (
                           <>
                              {j > 0 && <br />}
                              {line}
                           </>
                        ))}
                     </p>
                  </div>
               </div>
            ))
         }
      </div>

      {
         /*
            Tarjetas pendientes de contenido, se mantienen como borrador. Van
            en comentario de Astro y no en comentario HTML: así no viajan al
            navegador en cada request, que es lo que pasaba al dejarlas con
            la sintaxis de HTML después del bloque de preguntas.

            <div class={`card bg-white p-4 rounded-xl shadow-lg ${cardHover}`}>
               <h2 class="text-xl md:text-2xl font-bold text-white">Funcionamiento Del Hack</h2>
               <div class="mt-4">
                  <div class="subtitle cursor-pointer flex items-center justify-between" id="title4">
                     <span class="text-sm md:text-lg text-white font-semibold"> ¿Cómo empezar el proceso? </span>
                     <span class="text-white" id="icon4">+</span>
                  </div>
                  <div id="detail4" class="detail hidden mt-2 text-white text-justify text-xs md:text-sm">
                     <p>
                        Este es el detalle de cómo empezar el proceso. <br />
                        Aquí proporcionamos los pasos iniciales para que puedas empezar rápidamente.
                     </p>
                  </div>
               </div>
            </div>

            <div class={`card bg-white p-4 rounded-xl shadow-lg ${cardHover}`}>
               <h2 class="text-xl md:text-2xl font-bold text-white">Costos</h2>
               <div class="mt-4">
                  <div class="subtitle cursor-pointer flex items-center justify-between" id="title4">
                     <span class="text-lg text-white font-semibold"> ¿Cómo empezar el proceso? </span>
                     <span class="text-white" id="icon4">+</span>
                  </div>
                  <div id="detail4" class="detail hidden mt-2 text-white text-justify">
                     <p>
                        Este es el detalle de cómo empezar el proceso. <br />
                        Aquí proporcionamos los pasos iniciales para que puedas empezar rápidamente.
                     </p>
                  </div>
               </div>
            </div>

            <div class={`card bg-white p-4 rounded-xl shadow-lg ${cardHover}`}>
               <h2 class="text-xl md:text-2xl font-bold text-white">Seguridad De Tus Datos</h2>
               <div class="mt-4">
                  <div class="subtitle cursor-pointer flex items-center justify-between" id="title4">
                     <span class="text-lg text-white font-semibold"> ¿Cómo empezar el proceso? </span>
                     <span class="text-white" id="icon4">+</span>
                  </div>
                  <div id="detail4" class="detail hidden mt-2 text-white text-justify">
                     <p>
                        Este es el detalle de cómo empezar el proceso. <br />
                        Aquí proporcionamos los pasos iniciales para que puedas empezar rápidamente.
                     </p>
                  </div>
               </div>
            </div>
         */
      }
   </div>

   <script type="module">
      // Función para alternar los detalles
      const toggleDetail = (index) => {
         const detail = document.getElementById(`detail${index}`);
         const icon = document.getElementById(`icon${index}`);

         // Alternar la visibilidad del detalle
         detail.classList.toggle('hidden');

         // Cambiar el icono de '+' a '-' dependiendo del estado
         if (detail.classList.contains('hidden')) {
            icon.textContent = '+';
         } else {
            icon.textContent = '-';
         }
      };

      // Asignar el evento click para cada subtítulo
      document.querySelectorAll('.subtitle[id^="title"]').forEach((el) => {
         const index = el.id.replace('title', '');
         el.addEventListener('click', () => toggleDetail(index));
      });
   </script>
</Layout>
