---
import Layout from '@layouts/Layout.astro';
import HomeHero from '@sections/home/HomeHero.astro';
import HomeCTA from '@sections/home/HomeCTA.astro';
import HomeStats from '@sections/home/HomeStats.astro';
import HomeCollaborations from '@sections/home/HomeCollaborations.astro';
import HomeBenefits from '@sections/home/HomeBenefits.astro';
import HomeTestimonials from '@sections/home/HomeTestimonials.astro';
import HomeFeatured from '@sections/home/HomeFeatured.astro';
import HomeAppDownload from '@sections/home/HomeAppDownload.astro';

import { generateServiceSchema } from '@/utils/config.jsx';
const serviceSchema = generateServiceSchema({
   name: 'Asesoría para víctimas de aplicaciones de préstamo fraudulentas',
   description: 'Ayudamos a personas víctimas de montadeudas con apoyo psicológico y asesoría legal',
});
---

<Layout
   title="Movapp - El Hack hacia un nuevo inicio"
   description="Movapp es una organización que ayuda a personas víctimas de las aplicaciones de préstamo no reguladas mediante apoyo psicológico, asesoría personalizada y la aplicación de El Hack."
   type="website"
   schema={serviceSchema}
>
   <HomeHero />
   <HomeCTA />
   <HomeStats />
   <HomeCollaborations />
   <HomeBenefits />
   <HomeTestimonials />
   <HomeFeatured />
   <HomeAppDownload />
</Layout>
