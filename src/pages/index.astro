---
import ButtonContact from '@/components/ButtonContact.astro';
import Layout from '@layouts/Layout.astro';

import { generateServiceSchema } from '@/utils/seo.jsx';
const serviceSchema = generateServiceSchema({
   name: 'Asesoría para víctimas de aplicaciones de préstamo fraudulentas',
   description: 'Ayudamos a personas víctimas de montadeudas con apoyo psicológico y asesoría legal',
});

// Card base glassfrost, visible y con glow en ambos temas (ver .glass-card en global.css)
const cardHover =
   'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';

// ── Hero: 3 promesas con check ──────────────────────────────
const heroChecks = [
   'Detén las llamadas y los mensajes de acoso a ti, así como a tus contactos.',
   'Recupera tu estabilidad emocional.',
   'Protege a tus contactos, tu familia y tu trabajo.',
];

// ── Estadísticas ────────────────────────────────────────────
const stats = [
   { number: '+1 Millón', label: 'De Personas Han Confiado En Nosotros' },
   { number: '+10 Millones', label: 'De Hacks Instalados' },
];

// ── Colaboraciones (logos) ──────────────────────────────────
const collaborations = [
   { src: '/img/migracion/cenepred.webp', alt: 'Cenepred' },
   { src: '/img/migracion/mvs-noticias.webp', alt: 'MVS Noticias' },
   { src: '/img/migracion/werevertumorro.webp', alt: 'Werevertumorro' },
   { src: '/img/migracion/oye.webp', alt: 'Oye' },
];

// ── Beneficios: "Esto es lo que obtienes al instalar El Hack" ─
const benefits = [
   {
      title: 'Asesores especializados',
      text: 'Tienen toda la experiencia porque pasaron por lo mismo, y han ayudado a miles de víctimas.',
   },
   {
      title: 'Empatía',
      text: 'En Movapp también pasamos por lo que estás pasando y te entendemos, por lo que nuestro trato es humano y personal.',
   },
   {
      title: 'Recuperas la paz',
      text: 'Ya no más llamadas insistentes, te enseñamos cómo bloquear a los montadeudas.',
   },
   {
      title: 'Tu trabajo a salvo',
      text: 'Los montadeudas contactan a tus colaboradores, El Hack evita que los contacten.',
   },
   {
      title: 'Protección de tu información',
      text: 'En Movapp somos conscientes de tu privacidad y somos extremadamente cuidadosos con ella.',
   },
   {
      title: 'Familia tranquila',
      text: 'Ya no permites que sigan molestando a tus familiares cuando aplicas El Hack.',
   },
   {
      title: 'Software comprobado',
      text: 'El Hack es de Movapp, y como creadores hemos probado su eficacia hasta perfeccionarlo.',
   },
   {
      title: 'Equipo especializado',
      text: 'Contamos con años de experiencia y trabajamos más aplicaciones que nadie más, nuestro servicio es el mejor.',
   },
   {
      title: 'Asesoría gratuita',
      text: 'La asesoría no te compromete a nada y te llevas tips garantizados.',
   },
];

// ── Testimonios ─────────────────────────────────────────────
const testimonials = [
   {
      name: 'Diego',
      text: 'Estoy muy agradecida con el equipo Movapp. Ellos me han ayudado bastante. Les recomiendo mucho contactarse y no tener miedo, son de suma confianza. Cada uno de sus asesores te van a brindar información y aclararán tus dudas. Ya verás que en tu proceso en Movapp sentirás de nuevo la paz y tranquilidad que tenías.',
   },
   {
      name: 'Testimonio',
      text: 'Estoy muy agradecido que me ayudaron a salir de ese círculo del que nunca iba a salir. Estoy más que agradecido, mucho, con ustedes y todo su equipo.',
   },
   {
      name: 'Testimonio',
      text: 'Estoy muy agradecida con ustedes y con Dios porque desde que me dieron el apoyo ya no me han mandado mensajes. Les agradezco el apoyo, Dios me los bendiga.',
   },
   {
      name: 'Testimonio',
      text: 'Ya las llamadas son menos y ya no me mandan mensajes, tenían razón. Ya no molestan a mis contactos. Son lo máximo, gracias por ayudarme, sin duda los recomendaría.',
   },
   {
      name: 'Testimonio',
      text: 'Ha bajado 100% el hostigamiento por whatsapp y correos así que estoy muy feliz con los resultados y el apoyo que se me ha brindado en todo este proceso. Movapp, son lo mejor.',
   },
];

// ── Contenido Destacado ─────────────────────────────────────
const featured = [
   { title: '¿Qué Tan Confiable Es Movapp?', desc: 'Conoce quiénes somos y por qué confían en nosotros.', href: '/nosotros' },
   { title: 'Noticias de montadeudas', desc: 'Mantente informado sobre el acoso y cómo combatirlo.', href: '/red' },
   { title: 'Pagos de El Hack', desc: 'Todo lo que necesitas para adquirir El Hack.', href: '/tienda' },
   { title: 'Sección Mente Digital', desc: 'Cuida tu bienestar emocional en el mundo digital.', href: '/mind' },
   { title: 'Historias reales', desc: 'Testimonios de quienes recuperaron su paz.', href: '/testimonials' },
   { title: 'Aclara tus dudas', desc: 'Respuestas a las preguntas más frecuentes.', href: '/faqs' },
];
---

<Layout
   title="Movapp - El Hack hacia un nuevo inicio"
   description="Movapp es una organización que ayuda a personas víctimas de las aplicaciones de préstamo no reguladas mediante apoyo psicológico, asesoría personalizada y la aplicación de El Hack."
   type="website"
   schema={serviceSchema}
>
   <!-- ───────────────────── HERO con scroll reveal ───────────────────── -->
   <!-- Contenedor alto: dentro vive una "portada" sticky que se desvanece al hacer scroll -->
   <div id="heroScroll" class="relative h-[200vh]">
      <div class="sticky top-0 flex h-screen items-center justify-center overflow-hidden">
         <!-- Imagen de portada (se desvanece con el scroll) -->
         <div id="heroCover" class="absolute inset-0 z-20 will-change-[opacity,transform]" aria-hidden="true">
            <img src="/img/hero_bk.png" alt="" class="h-full w-full object-cover" />
            <div
               class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/20 to-gray-50 dark:to-[#050505]"
            >
            </div>
            <!-- Indicador de scroll -->
            <div
               id="scrollHint"
               class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/80"
            >
               <span class="text-xs uppercase tracking-widest">Desplázate</span>
               <svg class="h-6 w-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
               </svg>
            </div>
         </div>

         <!-- Contenido del hero (aparece con el scroll) -->
         <section
            id="heroContent"
            class="relative z-10 mx-auto flex max-w-5xl flex-col items-center justify-center px-4 text-center opacity-0 will-change-[opacity,transform]"
         >
            <!-- Badge -->
            <div
               class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple_mv/30 bg-purple_mv/10 px-4 py-1.5 text-xs md:text-sm font-medium text-text_banner"
            >
               <span class="relative flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple_mv opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-purple_mv"></span>
               </span>
               +1 millón de personas confían en Movapp
            </div>

            <!-- Título -->
            <h1 class="mx-auto max-w-4xl text-4xl font-bold leading-tight text-gray-900 dark:text-white md:text-6xl">
               Recupera Tu Tranquilidad <span class="text-text_banner drop-shadow-[0_0_25px_rgba(129,73,226,0.35)]"
                  >HOY</span
               >, adiós aplicaciones de
               <span class="text-text_banner drop-shadow-[0_0_25px_rgba(129,73,226,0.35)]">préstamos montadeudas</span>
            </h1>

            <!-- Subtítulo -->
            <h2 class="mx-auto mt-6 max-w-2xl text-lg text-gray-700 dark:text-white/80 md:text-xl">
               Detén las llamadas y los mensajes de acoso a ti, así como a tus contactos.
               <span class="font-semibold text-text_banner">¡Recupera tu estabilidad emocional!</span>
            </h2>

            <!-- Checks -->
            <ul class="mx-auto mt-8 flex max-w-3xl flex-col flex-wrap justify-center gap-3 sm:flex-row">
               {
                  heroChecks.map((item) => (
                     <li class="glass-card inline-flex items-center gap-2 rounded-full border border-purple_mv/20 px-4 py-2 text-sm text-gray-700 dark:border-white/10 dark:text-white/90">
                        <img src="/img/migracion/check-purple.webp" alt="check" class="h-4 w-4 flex-shrink-0" />
                        <span>{item}</span>
                     </li>
                  ))
               }
            </ul>
         </section>
      </div>
   </div>

   <!-- ───────────── CTA Contáctanos ───────────── -->
   <section class="relative mx-auto my-8 w-full max-w-5xl px-4" data-aos="fade-up">
      <div
         class="glass-card relative overflow-hidden rounded-3xl border border-purple_mv/30 p-10 shadow-[0_0_40px_rgba(129,73,226,0.15)] md:p-14"
      >
         <!-- Resplandor decorativo -->
         <div class="pointer-events-none absolute -right-16 -top-8 h-56 w-56 rounded-full bg-purple_mv/30 blur-3xl"></div>
         <div
            class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-purple_mv/20 blur-3xl"
         >
         </div>

         <div
            class="relative z-10 flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left"
         >
            <div class="max-w-xl">
               <span
                  class="mb-3 inline-flex items-center gap-2 rounded-full border border-purple_mv/30 bg-purple_mv/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-text_banner"
               >
                  Asesoría gratuita
               </span>
               <h2 class="text-2xl font-bold leading-tight text-gray-900 dark:text-white md:text-3xl">
                  ¿Quieres recuperar tu paz <span class="text-text_banner">hoy</span>?
               </h2>
               <p class="mt-3 text-sm text-gray-600 dark:text-white/80 md:text-base">
                  Habla con un asesor que pasó por lo mismo. Sin compromiso y de forma confidencial.
               </p>
            </div>

            <div class="flex-shrink-0">
               <ButtonContact />
            </div>
         </div>
      </div>
   </section>

   <!-- ───────────────── ESTADÍSTICAS ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-5xl px-4" data-aos="fade-up">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
         {
            stats.map((s) => (
               <div class={`flex flex-col items-center text-center p-10 rounded-2xl shadow-lg ${cardHover}`}>
                  <div class="text-3xl md:text-5xl font-bold text-text_banner drop-shadow-[0_0_20px_rgba(129,73,226,0.4)]">
                     {s.number}
                  </div>
                  <p class="mt-3 text-base md:text-lg text-gray-700 dark:text-white">{s.label}</p>
               </div>
            ))
         }
      </div>
   </section>

   <!-- ───────────────── COLABORACIONES (CARRUSEL) ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-4xl px-4 text-center" data-aos="fade-up">
     <h3 class="mt-16 mb-8 text-center text-xl md:text-2xl font-bold text-white">
Algunas de nuestras colaboraciones         </h3>

      <!-- Carrusel marquee horizontal (se desplaza a la izquierda) -->
      <div class="marquee relative w-full overflow-hidden">
         <!-- Difuminado en los bordes -->
         <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-gray-50 to-transparent dark:from-[#050505]"></div>
         <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-gray-50 to-transparent dark:from-[#050505]"></div>

         <div class="marquee-track flex w-max items-center gap-8">
            {
               [...collaborations, ...collaborations].map((logo) => (
                  <div class="flex h-20 flex-shrink-0 items-center justify-center rounded-xl bg-white/90 px-8 py-4 shadow-md">
                     <img src={logo.src} alt={logo.alt} class="h-10 md:h-14 w-auto object-contain" />
                  </div>
               ))
            }
         </div>
      </div>
   </section>

   <!-- ───────── EL HACK HACIA UN NUEVO INICIO ───────── -->
   <section
      class="dark-section relative my-16 w-full overflow-hidden bg-gradient-to-b from-[#1a0b33] to-[#0a0414] py-20 md:py-28"
      data-aos="fade-up"
   >
      <!-- Patrón de puntos -->
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
         <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
               <pattern id="dots" width="30" height="30" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1.5" fill="white"></circle>
               </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#dots)"></rect>
         </svg>
      </div>

      <!-- Glow central morado -->
      <div
         class="pointer-events-none absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple_mv/25 blur-[120px]"
         aria-hidden="true"
      >
      </div>

      <div class="relative z-10 mx-auto max-w-6xl px-4">
         <div class="mx-auto max-w-3xl text-center">
            <span
               class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-medium text-white/70"
            >
               <span class="h-1.5 w-1.5 rounded-full bg-purple_mv"></span>
               La solución
            </span>
            <h2 class="mt-6 text-3xl md:text-5xl font-bold leading-tight tracking-tight text-white">
               El Hack hacia un nuevo inicio,
               <span class="block bg-gradient-to-r from-purple-300 to-purple_mv bg-clip-text text-transparent">
                  recupera tu vida
               </span>
            </h2>
            <p class="mt-6 text-base md:text-lg leading-relaxed text-white/70">
               Creamos una solución al acoso de los montadeudas. El Hack es un software con el que hemos ayudado a
               millones de víctimas y hace que dejen de llamar a tus contactos.
               <strong class="text-white">El Hack funciona hoy.</strong>
            </p>
         </div>

         <!-- Beneficios -->
         <h3 class="mt-16 mb-8 text-center text-xl md:text-2xl font-bold text-white">
            Esto es lo que obtienes al instalar El Hack de Movapp
         </h3>
         <div id="benefitsGrid" class="reveal-stagger grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
               benefits.map((b) => (
                  <div class="group flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-purple_mv/50 hover:bg-white/10 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)]">
                     <div class="mb-2 flex items-center gap-3">
                        <img
                           src="/img/migracion/checkmark-circle.webp"
                           alt="check"
                           class="h-6 w-6 flex-shrink-0 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
                        />
                        <span class="text-lg font-bold text-purple-300">{b.title}</span>
                     </div>
                     <p class="text-sm text-white/70">{b.text}</p>
                  </div>
               ))
            }
         </div>
      </div>
   </section>


   <!-- ───────────────── TESTIMONIOS ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-6xl px-4" data-aos="fade-up">
      <div class="mb-10 text-center">
         <h2 class="text-2xl md:text-3xl font-bold text-text_banner">Únete a los millones que ya disfrutan de paz</h2>
         <p class="mt-3 text-sm md:text-base text-gray-700 dark:text-white/80">
            Historias reales de personas que recuperaron su tranquilidad con Movapp.
         </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
         {
            testimonials.map((t, i) => (
               <div
                  class:list={[
                     'glass-card relative flex flex-col justify-between overflow-hidden rounded-2xl border border-purple_mv/30 p-6 shadow-[0_0_30px_rgba(129,73,226,0.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_0_40px_rgba(129,73,226,0.3)]',
                     i === 0 ? 'lg:col-span-2' : '',
                  ]}
               >
                  <span class="pointer-events-none absolute -top-4 left-3 select-none text-7xl font-serif text-purple_mv/30">
                     “
                  </span>
                  <p class="relative z-10 mt-6 text-sm text-gray-700 dark:text-white/90">{t.text}</p>
                  <p class="relative z-10 mt-4 text-right font-bold text-text_banner">— {t.name}</p>
               </div>
            ))
         }
      </div>

      <div class="mt-10 flex justify-center">
         <a
            href="/testimonials"
            class="inline-block rounded-3xl border border-text_banner px-8 py-3 text-sm md:text-base font-bold uppercase text-text_banner transition hover:scale-105 hover:bg-text_banner hover:text-white"
         >
            Ver más testimonios
         </a>
      </div>
   </section>

   <!-- ───────────────── CONTENIDO DESTACADO ───────────────── -->
   <section class="relative mx-auto my-24 w-full max-w-5xl px-4" data-aos="fade-up">
      <!-- Encabezado alineado a la izquierda (rompe el patrón centrado) -->
      <div class="mb-8 flex items-end justify-between gap-4 border-b border-purple_mv/20 pb-4">
         <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Explora</span>
            <h2 class="mt-1 text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">Contenido Destacado</h2>
         </div>
         <span class="hidden text-sm text-gray-500 dark:text-white/50 sm:block">{featured.length} secciones</span>
      </div>

      <!-- Lista tipo índice numerado -->
      <ul class="flex flex-col">
         {
            featured.map((f, i) => (
               <li>
                  <a
                     href={f.href}
                     class="group relative flex items-center gap-5 border-b border-gray-200/70 py-5 transition-colors dark:border-white/10 md:gap-8"
                  >
                     {/* Barra de acento que aparece al hover */}
                     <span class="absolute left-0 top-1/2 h-0 w-0.5 -translate-y-1/2 bg-text_banner transition-all duration-300 group-hover:h-2/3" />

                     {/* Número */}
                     <span class="w-10 flex-shrink-0 text-2xl font-bold tabular-nums text-gray-300 transition-colors group-hover:text-text_banner dark:text-white/20 md:text-3xl">
                        {String(i + 1).padStart(2, '0')}
                     </span>

                     {/* Título + descripción */}
                     <div class="flex-1">
                        <h3 class="text-lg font-semibold text-gray-900 transition-colors group-hover:text-text_banner dark:text-white md:text-xl">
                           {f.title}
                        </h3>
                        <p class="mt-0.5 text-sm text-gray-500 dark:text-white/60">{f.desc}</p>
                     </div>

                     {/* Flecha */}
                     <span class="flex-shrink-0 text-text_banner transition-transform duration-300 group-hover:translate-x-1.5">
                        <svg class="h-5 w-5 md:h-6 md:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                     </span>
                  </a>
               </li>
            ))
         }
      </ul>
   </section>

   <!-- ───────────────── DESCARGA NUESTRA APP ───────────────── -->
   <section class="relative mx-auto my-16 w-full max-w-6xl px-4" data-aos="fade-up">
      <div class={`flex flex-col items-center gap-8 md:flex-row rounded-2xl p-8 shadow-lg ${cardHover}`}>
         <!-- Mockup -->
         <div class="flex-1 flex justify-center">
            <img
               src="/img/migracion/Mockup-celular-movapp-1.webp"
               alt="App Movapp"
               class="max-h-96 w-auto drop-shadow-[0_0_40px_rgba(129,73,226,0.35)]"
            />
         </div>

         <!-- Texto + badges -->
         <div class="flex-1 text-center md:text-left">
            <img src="/img/migracion/Logo-Movapp_calado-5.webp" alt="Movapp" class="mx-auto md:mx-0 mb-4 h-12 w-auto" />
            <h2 class="mb-5 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Descarga nuestra app</h2>
            <p class="mb-6 text-sm md:text-base text-gray-700 dark:text-white/90">
               Únete a los millones que ya disfrutan de paz. Descarga la app de Movapp y aplica El Hack hoy.
            </p>
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
               <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
                  <img src="/img/migracion/play-store-v2.webp" alt="Google Play" class="h-12 w-auto" />
               </a>
               <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
                  <img src="/img/migracion/app-store-v2.webp" alt="App Store" class="h-12 w-auto" />
               </a>
            </div>
         </div>
      </div>
   </section>


</Layout>

<script is:inline>
   (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Hero scroll-reveal: la portada se desvanece y el texto aparece ──
      var heroScroll = document.getElementById('heroScroll');
      var heroCover = document.getElementById('heroCover');
      var heroContent = document.getElementById('heroContent');
      var scrollHint = document.getElementById('scrollHint');

      if (heroScroll && heroCover && heroContent) {
         if (reduce) {
            // Sin movimiento: mostrar el texto directamente y ocultar la portada
            heroContent.style.opacity = '1';
            heroCover.style.opacity = '0';
            if (scrollHint) scrollHint.style.display = 'none';
         } else {
            var ticking = false;
            var update = function () {
               var rect = heroScroll.getBoundingClientRect();
               var total = heroScroll.offsetHeight - window.innerHeight;
               // progreso 0 → 1 a lo largo del scroll dentro del contenedor
               var progress = Math.min(1, Math.max(0, -rect.top / total));

               // Portada: visible al inicio, desaparece hacia la mitad
               var coverOpacity = 1 - Math.min(1, progress / 0.5);
               heroCover.style.opacity = String(coverOpacity);
               heroCover.style.transform = 'scale(' + (1 + progress * 0.1) + ')';
               if (scrollHint) scrollHint.style.opacity = String(coverOpacity);

               // Texto: aparece desde la mitad en adelante, subiendo levemente
               var contentProgress = Math.min(1, Math.max(0, (progress - 0.4) / 0.4));
               heroContent.style.opacity = String(contentProgress);
               heroContent.style.transform = 'translateY(' + (1 - contentProgress) * 30 + 'px)';

               ticking = false;
            };
            var onScroll = function () {
               if (!ticking) {
                  window.requestAnimationFrame(update);
                  ticking = true;
               }
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
            update();
         }
      }

      // ── Reveal escalonado de beneficios (funciona también en móvil) ──
      var grid = document.getElementById('benefitsGrid');
      if (grid) {
         if (reduce || !('IntersectionObserver' in window)) {
            grid.classList.add('in-view');
         } else {
            var io = new IntersectionObserver(
               function (entries) {
                  entries.forEach(function (entry) {
                     if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                        io.unobserve(entry.target);
                     }
                  });
               },
               { threshold: 0.15 }
            );
            io.observe(grid);
         }
      }
   })();
</script>
