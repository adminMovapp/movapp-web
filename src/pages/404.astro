---
import Layout from '@layouts/Layout.astro';
import StarField from '@components/decorative/StarField.astro';

// output: 'server' (SSR) no aplica el 404 automáticamente en todos los
// adaptadores/entornos solo por el nombre del archivo (a diferencia del modo
// 'static') -- se fija explícito para que el status sea correcto sin
// depender de que Netlify/Astro lo infieran por convención.
Astro.response.status = 404;
Astro.response.statusText = 'Not Found';

// Diseño del sitio (StarField + texto con degradado, mismo lenguaje que
// PrensaHero.astro). A pedido (2026-10-07) solo el mensaje y el botón de
// volver al inicio: se quitó la lista "¿A dónde ir desde aquí?".
---

<Layout title="Página no encontrada" showGrid={false}>
   <section class="relative mx-auto flex min-h-[70svh] flex-col items-center justify-center px-4 py-16 text-center">
      <StarField id="not-found" ambientCount={45} />

      <p
         class="gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-8xl font-bold leading-none text-transparent dark:from-white dark:to-purple_mv md:text-9xl"
      >
         404
      </p>

      <h1 class="mx-auto mt-6 max-w-3xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
         Página no encontrada
      </h1>

      <p class="mx-auto mt-4 max-w-md text-base text-gray-600 dark:text-white/70 md:text-lg">
         Lo sentimos, el enlace que buscas no existe o fue movido.
      </p>

      <a
         id="cta-404-inicio"
         href="/"
         data-cta="404_volver_inicio"
         data-page-type="404"
         data-section-name="contenido"
         data-destination-type="internal_page"
         class="mt-10 inline-flex items-center justify-center rounded-full bg-purple_mv px-8 py-4 text-base font-bold text-white shadow-card transition hover:bg-purple_mv/85 hover:shadow-card-hover md:text-lg"
      >
         Volver al inicio
      </a>
   </section>
</Layout>
