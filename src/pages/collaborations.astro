---
import Layout from '@layouts/Layout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { VIDEOS } from '@utils/config.jsx';

const cardHover =
   'border border-white/10 transition duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1 hover:scale-105 cursor-pointer';
---

<Layout title="Colaboraciones">
   <!-- El "mt-32" (despeje del header fijo) se movió acá -- antes vivía en
        el div de la tarjeta de abajo, que ahora arranca en "mt-0" para que
        el margen entre el breadcrumb y la tarjeta sea el "mb-4" del propio
        breadcrumb, no el mt-32 colapsando con él. -->
   <div class="mx-auto mt-32 max-w-2xl px-4 text-center md:px-0">
      <Breadcrumbs />
   </div>

   <div class="mx-auto mb-4 max-w-2xl px-4 md:px-0" data-aos="fade-down">
      <div
         class={`flex flex-col p-6 rounded-xl shadow-md


    ${cardHover}`}
      >
         <h2 class="mb-4 text-center text-xl font-bold text-transparent bg-clip-text text-white md:text-4xl">
            Colaboraciones
         </h2>
      </div>
   </div>

   <div class="mx-auto my-8 w-full max-w-full sm:max-w-xl md:max-w-md lg:max-w-2xl px-4 md:px-0" data-aos="fade-up">
      <div class="w-full aspect-video overflow-hidden rounded-lg">
         <iframe
            src={VIDEOS.colaboraciones}
            class="w-full h-full sm:w-full lg:w-full max-w-full"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
         >
         </iframe>
      </div>
   </div>
</Layout>
