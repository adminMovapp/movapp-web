---
import Layout from '@layouts/Layout.astro';
import ShopIsland from '@components/ShopIsland.jsx';
---

<Layout title="Tienda">
   <section class="relative overflow-hidden">
      <!-- Orbes de fondo -->
      <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden" aria-hidden="true">
         <div class="absolute -left-32 top-10 h-[380px] w-[380px] rounded-full bg-purple_mv/15 blur-3xl dark:bg-purple_mv/25 animate-floatSlow"></div>
         <div
            class="absolute -right-32 top-1/2 h-[420px] w-[420px] rounded-full bg-purple_mv/10 blur-3xl dark:bg-purple_mv/20 animate-floatSlow"
            style="animation-delay: -4s;"
         >
         </div>
      </div>

      <div class="relative z-10 mx-auto max-w-6xl px-4 pt-32 pb-16">
         <!-- Encabezado -->
         <div class="mb-12 text-center" data-aos="fade-down">
           
            <h1 class="mt-5 text-3xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white">
               Nuestros
               productos
            </h1>
         </div>

         <!-- Tienda dinámica (catálogo + carrito + checkout) -->
         <div data-aos="fade-up">
            <ShopIsland client:load />
         </div>
      </div>
   </section>
</Layout>
