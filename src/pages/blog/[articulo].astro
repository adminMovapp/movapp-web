---
// Página de detalle de UN artículo del blog -- un nivel más adentro que
// [categoria].astro (esa es el listado de una categoría; ésta es el
// artículo en sí, con cuerpo completo). Mismo criterio de plantilla única:
// agregar un artículo nuevo es agregar una entrada a
// @constants/blogArticles.ts, nada que tocar acá.
//
// Convive con [categoria].astro bajo el mismo "/blog/[x]" sin generar rutas
// duplicadas: los slugs de artículo (blogArticles.ts) y de categoría
// (blogCategoryPages.ts) son conjuntos disjuntos, y ambas rutas son
// prerender=true -- cada getStaticPaths() resuelve a páginas estáticas
// concretas distintas (verificado en dev y build, sin colisión).
import Layout from '@layouts/Layout.astro';
import BlogArticleHero from '@sections/blog/BlogArticleHero.astro';
import BlogArticleBody from '@sections/blog/BlogArticleBody.astro';
import BlogArticleGrid from '@sections/blog/BlogArticleGrid.astro';
import BlogArticleCTA from '@sections/blog/BlogArticleCTA.astro';
import { BLOG_ARTICLES } from '@constants/blogArticles.ts';
import { getSiteConfig } from '@utils/config.jsx';

// Mismo motivo que [categoria].astro: el sitio corre en SSR (output:
// 'server'), así que sin este flag "getStaticPaths" se ignora por completo.
export const prerender = true;

export function getStaticPaths() {
   return BLOG_ARTICLES.map((article) => ({
      params: { articulo: article.slug },
      props: { article },
   }));
}

const { article } = Astro.props;

const shareUrl = `${getSiteConfig(Astro.request).siteUrl}/blog/${article.slug}`;

// Primer párrafo del cuerpo, sin importar cuántos bloques "appGrid" haya
// antes -- usado como meta description.
const firstParagraph = article.sections[0].blocks.find((b) => b.type === 'paragraph')?.text ?? '';
---

<Layout title={`${article.title} | Movapp`} description={firstParagraph} type="article" showGrid={false}>
   <BlogArticleHero
      slug={article.slug}
      title={article.title}
      breadcrumbLabel={article.breadcrumbLabel}
      author={article.author}
      publishDate={article.publishDate}
      readingMinutes={article.readingMinutes}
      mobileAuthor={article.mobileAuthor}
      mobileReadingMinutes={article.mobileReadingMinutes}
   />
   <BlogArticleBody
      slug={article.slug}
      sections={article.sections}
      authorBio={article.authorBio}
      shareUrl={shareUrl}
      shareTitle={article.title}
   />
   <BlogArticleGrid
      id={`articulo-${article.slug}-relacionados`}
      title="Artículos relacionados"
      articles={article.relatedArticles}
   />
   <BlogArticleCTA slug={article.slug} />
</Layout>
