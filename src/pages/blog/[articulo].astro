---
// Página de detalle de UN artículo del blog -- un nivel más adentro que
// [categoria].astro (esa es el listado de una categoría; ésta es el
// artículo en sí, con cuerpo completo). Mismo criterio de plantilla única:
// agregar un artículo nuevo es agregar una entrada a
// @constants/blogArticles.ts, nada que tocar acá.
//
// Convive con [categoria].astro bajo el mismo "/blog/[x]" sin generar rutas
// duplicadas: los slugs de artículo (blogArticles.ts) y de categoría
// (blogCategoryPages.ts) son conjuntos disjuntos, y ambas rutas son
// prerender=true -- cada getStaticPaths() resuelve a páginas estáticas
// concretas distintas (verificado en dev y build, sin colisión).
//
// title/description del <Layout> vienen de "article.metaTitle"/
// "article.metaDescription" (2026-09-03, a pedido explícito de Santiago
// tras auditar las 42 URLs del sitio contra el brief maestro de SEO) --
// ANTES se armaban solos a partir del H1 ("${article.title} | Movapp") y
// del primer párrafo del cuerpo, y ninguno de los 27 artículos coincidía
// con el meta title/description planeado (el H1 es un titular de lectura,
// no un meta title de ≤60 caracteres; el primer párrafo es una intro de
// 200-300 caracteres, no una meta description de SERP). Cada entrada de
// BLOG_ARTICLES ahora trae su propio copy de SEO, independiente del H1.
import { getImage } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import BlogArticleHero from '@sections/blog/BlogArticleHero.astro';
import BlogArticleBody from '@sections/blog/BlogArticleBody.astro';
import BlogRelatedArticles from '@sections/blog/BlogRelatedArticles.astro';
import BlogArticleCTA from '@sections/blog/BlogArticleCTA.astro';
import { BLOG_ARTICLES } from '@constants/blogArticles.ts';
import { BLOG_IMAGES } from '@constants/blogImages.ts';
import { getSiteConfig } from '@utils/config.jsx';
import { generateBlogPostingSchema, generateBreadcrumbSchema } from '@utils/schema.js';

// Mismo motivo que [categoria].astro: el sitio corre en SSR (output:
// 'server'), así que sin este flag "getStaticPaths" se ignora por completo.
export const prerender = true;

export function getStaticPaths() {
   return BLOG_ARTICLES.map((article) => ({
      params: { articulo: article.slug },
      props: { article },
   }));
}

const { article } = Astro.props;

// Trailing slash a mano: política de sitio (GOLIVE, sept. 2026), toda URL
// interna termina en "/" para evitar el doble redirect.
const siteConfig = getSiteConfig(Astro.request);
const shareUrl = `${siteConfig.siteUrl}/blog/${article.slug}/`;

// Imagen destacada como og:image/twitter:image y como "image" del
// BlogPosting (2026-11-05, ficha SEO/GEO de Octopus Conference 2026: Google
// pide "image" para el rich result de artículo y ninguno de los artículos la
// traía; las redes sociales mostraban la imagen genérica del sitio).
// Se pide a 1200x630 porque Layout.astro declara og:image:width/height fijos
// con esas medidas; ojo: el Image CDN de Netlify encaja (fit=contain), no
// recorta, así que solo sale exacta si la imagen ya tiene esa proporción
// (la de Octopus sí; las 27 anteriores salen un poco más angostas, sin
// deformarse). URL absoluta: los crawlers no resuelven relativas.
const coverSource = BLOG_IMAGES[article.slug];
const coverImageUrl = coverSource
   ? new URL((await getImage({ src: coverSource, width: 1200, height: 630, format: 'jpg' })).src, siteConfig.canonicalUrl).href
   : undefined;

// Schema propio del artículo (BlogPosting + BreadcrumbList) -- pasado por la
// prop "schema" del Layout, la escotilla de escape para páginas dinámicas de
// pSEO (ver @utils/schema.js): esta ruta no puede vivir en PAGE_SCHEMA
// porque no es una ruta fija, es una por cada slug de BLOG_ARTICLES.
// 2026-09-03: hallazgo de la auditoría de schema -- ninguno de los 27
// artículos tenía BlogPosting, solo el Organization del fallback genérico.
const articlePath = `/blog/${article.slug}/`;
const articleSchema = [
   generateBlogPostingSchema(
      {
         headline: article.schemaHeadline ?? article.metaTitle,
         description: article.metaDescription,
         path: articlePath,
         publishDate: article.publishDate,
         authorName: article.author,
         image: coverImageUrl,
      },
      Astro.request,
   ),
   generateBreadcrumbSchema(
      [
         { name: 'Blog', path: '/blog/' },
         { name: article.breadcrumbLabel, path: articlePath },
      ],
      Astro.request,
   ),
];
---

<Layout
   title={article.metaTitle}
   description={article.metaDescription}
   image={coverImageUrl}
   type="article"
   showGrid={false}
   schema={articleSchema}
>
   <BlogArticleHero
      slug={article.slug}
      title={article.title}
      breadcrumbLabel={article.breadcrumbLabel}
      author={article.author}
      publishDate={article.publishDate}
      readingMinutes={article.readingMinutes}
      mobileAuthor={article.mobileAuthor}
      mobileReadingMinutes={article.mobileReadingMinutes}
      subtitle={article.subtitle}
      heroAlt={article.heroAlt}
      heroCaption={article.heroCaption}
   />
   <BlogArticleBody
      slug={article.slug}
      sections={article.sections}
      authorBio={article.authorBio}
      shareUrl={shareUrl}
      shareTitle={article.title}
   />
   <BlogRelatedArticles id={`articulo-${article.slug}-relacionados`} articles={article.relatedArticles} />
   <BlogArticleCTA slug={article.slug} />
</Layout>
