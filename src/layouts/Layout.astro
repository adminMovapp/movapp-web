---
// Importado como URL (no como hoja de estilos auto-inyectada): así el <link>
// se agrega a mano vía JS más abajo y solo se descarga cuando hay JavaScript.
// Sin JS, el sitio se sirve como HTML semántico sin CSS de Tailwind: mismo
// texto, sin el peso del diseño.
import stylesheetHref from '@styles/global.css?url';
// Este sí se importa normal (siempre se carga, con o sin JS): es una hoja de
// estilos mínima y liviana que le da estructura al HTML cuando Tailwind no
// está disponible. Ver src/styles/no-js.css.
import '@styles/no-js.css';
// CSS de la librería AOS (animaciones on-scroll): solo tiene efecto si AOS.init()
// corre (dentro de InitAOS, un componente client:only), así que se carga igual
// que Tailwind, vía el script condicionado a JavaScript de más abajo.
import aosHref from 'aos/dist/aos.css?url';
// Solo lo usa la isla de React de la tienda (bandera de país); sin JS esa
// isla ni siquiera se hidrata, así que también se difiere a este script.
const flagIconsHref = 'https://cdn.jsdelivr.net/npm/flag-icons/css/flag-icons.min.css';
import Header from '@components/layout/Header.astro';
import MobileBottomNav from '@components/layout/MobileBottomNav.astro';
import MenuMobilePanel from '@components/layout/MenuMobilePanel.astro';
import Footer from '@components/layout/Footer.astro';
import HeaderLayer from '@/components/layout/HeaderLayer.astro';
import Preloader from '@/components/layout/Preloader.astro';
import BackgroundGrid from '@components/layout/BackgroundGrid.astro';
import InitAOS from '@/utils/InitAOS.jsx';

import { getSiteConfig, generateSEOTags, generateOrganizationSchema } from '@/utils/config.jsx';

import GoogleTagManager from '@components/layout/GoogleTagManager.astro';
import GoogleAnalytics from '@components/layout/GoogleAnalytics.astro';

import MetaPixelScript from '@components/layout/MetaPixelScript.astro';

const showHeaderLayer = import.meta.env.PUBLIC_SHOW_HEADER_LAYER === 'true';
const showPreloader = import.meta.env.PUBLIC_SHOW_PRELOADER === 'true';
// DIAGNÓSTICO TEMPORAL -- borrar junto con el resto del diagnóstico de
// "navdebug" una vez resuelto el flote de la barra inferior. ?nochat=1 ya
// descartó al widget de LeadConnector como causa (mismo bug con o sin él).
// ?minimal=1 apaga TAMBIÉN GTM/GA4/Meta Pixel de una sola vez -- GTM en
// particular puede estar inyectando tags de terceros (heatmaps, session
// recording, etc.) que no se ven en este código porque viven en la
// configuración del contenedor de GTM, no en el repo.
const disableChatWidget = Astro.url.searchParams.get('nochat') === '1' || Astro.url.searchParams.get('minimal') === '1';
const disableThirdPartyScripts = Astro.url.searchParams.get('minimal') === '1';

interface Props {
   title?: string;
   description?: string;
   keywords?: string;
   image?: string;
   type?: string;
   noIndex?: boolean;
   schema?: object;
   showGrid?: boolean;
}
const { title, showGrid = true } = Astro.props;

const siteConfig = getSiteConfig(Astro.request);

// Generar tags SEO
const seoTags = generateSEOTags(
   {
      ...Astro.props,
      url: new URL(Astro.url.pathname, siteConfig.canonicalUrl).href,
   },
   Astro.request,
);
const organizationSchema = generateOrganizationSchema(Astro.request);
---

<!doctype html>
<html lang={siteConfig.site.language} class="no-js dark">
   <head>
      <!--
         Carga del CSS condicionada a JavaScript: si el navegador (o el bot)
         no ejecuta este script, la hoja de estilos de Tailwind nunca se pide
         y la página se sirve como HTML plano, mucho más ligero. Con
         JavaScript, se agrega el <link> y la página luce con el diseño
         completo (colores, animaciones, etc.).
      -->
      <script is:inline define:vars={{ stylesheetHref, aosHref, flagIconsHref }}>
         (function () {
            document.documentElement.classList.remove('no-js');
            document.documentElement.classList.add('js');

            [stylesheetHref, aosHref, flagIconsHref].forEach(function (href) {
               var link = document.createElement('link');
               link.rel = 'stylesheet';
               link.href = href;
               document.head.appendChild(link);
            });
         })();
      </script>

      <!-- Tema: aplicar antes del paint para evitar flash (default DARK) -->
      <script is:inline>
         (function () {
            try {
               var t = localStorage.getItem('theme');
               if (t === 'light') document.documentElement.classList.remove('dark');
               else document.documentElement.classList.add('dark');
            } catch (e) {
               document.documentElement.classList.add('dark');
            }
         })();
      </script>
      {showPreloader && (
         <script is:inline>
            (function () {
               try {
                  var navEntry = performance.getEntriesByType("navigation")[0];
                  var isReload = navEntry && navEntry.type === 'reload';
                  var isFirstVisit = !sessionStorage.getItem('movapp_preloader_seen');
                  if (!isReload && !isFirstVisit) {
                     document.documentElement.classList.add('skip-preloader');
                  }
               } catch(e) {}
            })();
         </script>
      )}

      <!-- Charset y viewport -->
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />

      <meta http-equiv="X-UA-Compatible" content="IE=edge" />

      <!-- SEO básico -->
      <title>{seoTags.title}</title>
      <meta name="description" content={seoTags.description} />
      <meta name="keywords" content={seoTags.keywords} />
      <meta name="author" content={seoTags.author} />
      {!siteConfig.isProduction && <meta name="robots" content={seoTags.robots} />}

      <!-- Canonical URL -->
      <link rel="canonical" href={seoTags.canonical} />

      <!-- Open Graph -->
      <meta property="og:type" content={seoTags.type} />
      <meta property="og:url" content={seoTags.canonical} />
      <meta property="og:title" content={seoTags.title} />
      <meta property="og:description" content={seoTags.description} />
      <meta property="og:image" content={seoTags.image} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:site_name" content={siteConfig.site.name} />
      <meta property="og:locale" content={siteConfig.site.locale} />

      <!-- Twitter Card -->
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:url" content={seoTags.canonical} />
      <meta name="twitter:title" content={seoTags.title} />
      <meta name="twitter:description" content={seoTags.description} />
      <meta name="twitter:image" content={seoTags.image} />
      <meta name="twitter:site" content={siteConfig.social.twitter} />
      <meta name="twitter:creator" content={siteConfig.social.twitter} />

      <!-- Favicon -->
      <!-- <link rel="icon" type="image/png" href="/ico-movapp.ico" /> -->
      <link rel="icon" type="image/x-icon" href={siteConfig.assets.favicon} />
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
      <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
      <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      <!-- <link rel="manifest" href="/site.webmanifest" /> -->
      <meta name="theme-color" content={siteConfig.seo.themeColor} />

      <!-- Headers de seguridad -->
      <meta http-equiv="X-Content-Type-Options" content="nosniff" />
      <!-- <meta http-equiv="X-Frame-Options" content="SAMEORIGIN" /> -->
      <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
      <meta name="generator" content={Astro.generator} />

      <!-- Schema.org JSON-LD -->
      <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

      <!-- Header meta-pixel  -->
      <meta name="facebook-domain-verification" content="uffghfhff1th1z040abwzgjgjto9mi" />

      {!disableThirdPartyScripts && <GoogleTagManager />}
      {!disableThirdPartyScripts && <GoogleAnalytics />}
      <noscript>
         <style>
            [data-aos] {
               opacity: 1 !important;
               transform: none !important;
            }
            #global-preloader {
               display: none !important;
            }
         </style>
      </noscript>
   </head>

   <!--
      min-h-[100svh], NO min-h-screen (100vh) ni min-h-[100dvh]: evita que el
      body cambie de tamaño cada vez que el navegador anima su barra de
      direcciones/gestos al hacer scroll -- "100vh" es un valor fijo (el
      tamaño máximo, barra oculta) que no se recalcula con el scroll;
      "100dvh" sí se recalcularía en cada frame de esa animación, generando
      reflow. Nótese que MobileBottomNav ya NO es "fixed" (ver ese
      componente) así que no necesita padding-bottom en el body para
      reservarle espacio -- al ser "sticky" reserva su propio espacio en el
      flujo normal.
   -->
   <body
      class="bg-gray-50 text-gray-900 dark:bg-[#050505] dark:text-white min-h-[100svh] flex flex-col overflow-x-hidden transition-colors duration-300"
   >
      {showPreloader && <Preloader />}
      <InitAOS client:only="react" />
      {!disableThirdPartyScripts && <MetaPixelScript pixelId={import.meta.env.PUBLIC_META_PIXEL_ID} />}

      {showHeaderLayer ? <HeaderLayer /> : null}

      <Header />

      <main class="relative min-h-[100svh] isolate">
         {showGrid && <BackgroundGrid />}
         <div class="relative z-10">
            <slot />
            <Footer />
         </div>
      </main>

      <MobileBottomNav />
      <MenuMobilePanel />

      <!--
         DIAGNÓSTICO TEMPORAL (v2) -- borrar una vez resuelto. Solo se activa
         con ?navdebug=1 en la URL. A diferencia de la v1, esta vez también
         registra el "transform" que el script de compensación de
         MobileBottomNav.astro le está aplicando en cada momento, para
         confirmar si esa corrección realmente se está aplicando y aun así
         no alcanza, o si nunca llega a aplicarse.
      -->
      <script is:inline>
         (function () {
            if (!/[?&]navdebug=1(&|$)/.test(location.search)) return;

            var nav = document.getElementById('mobileBottomNav');
            if (!nav) return;

            // Duración fija de la prueba -- al terminar, muestra un resumen
            // con números (no "a simple vista") para poder comparar
            // condiciones distintas de forma objetiva. Se puede ajustar con
            // ?navdebugsec=60 en la URL.
            var TEST_SECONDS = parseInt(new URLSearchParams(location.search).get('navdebugsec') || '45', 10);

            var log = document.createElement('div');
            log.style.cssText =
               'position:fixed;top:0;left:0;right:0;z-index:2147483647;max-height:55vh;overflow:auto;' +
               'background:rgba(0,0,0,0.88);color:#0f0;font:10px/1.4 monospace;padding:6px;white-space:pre-wrap;';
            document.body.appendChild(log);

            var startTime = performance.now();
            function line(msg, color) {
               var t = ((performance.now() - startTime) / 1000).toFixed(2);
               var p = document.createElement('div');
               if (color) p.style.color = color;
               p.textContent = '[' + t + 's] ' + msg;
               log.insertBefore(p, log.firstChild);
               while (log.childNodes.length > 80) log.removeChild(log.lastChild);
            }

            var jumpCount = 0;
            var longtaskCount = 0;
            var longtaskTotalMs = 0;
            var maxJumpPx = 0;

            line('nav debug v3 activo. prueba de ' + TEST_SECONDS + 's. rect inicial top=' + nav.getBoundingClientRect().top.toFixed(2));

            if (window.PerformanceObserver) {
               try {
                  new PerformanceObserver(function (list) {
                     list.getEntries().forEach(function (entry) {
                        longtaskCount++;
                        longtaskTotalMs += entry.duration;
                        line('LONGTASK duración=' + entry.duration.toFixed(0) + 'ms (total: ' + longtaskCount + ')');
                     });
                  }).observe({ type: 'longtask', buffered: true });
               } catch (e) {
                  line('PerformanceObserver longtask no soportado: ' + e.message);
               }
            }

            var lastTop = nav.getBoundingClientRect().top;
            var finished = false;
            function tick() {
               if (finished) return;
               var rect = nav.getBoundingClientRect();
               var delta = Math.abs(rect.top - lastTop);
               if (delta > 0.5) {
                  jumpCount++;
                  if (delta > maxJumpPx) maxJumpPx = delta;
                  line(
                     'POSICION #' +
                        jumpCount +
                        ' top ' +
                        lastTop.toFixed(1) +
                        ' -> ' +
                        rect.top.toFixed(1) +
                        ' (Δ' +
                        delta.toFixed(1) +
                        'px) | innerH=' +
                        window.innerHeight +
                        ' | vvH=' +
                        (window.visualViewport ? window.visualViewport.height.toFixed(1) : 'n/a'),
                  );
                  lastTop = rect.top;
               }

               var elapsedSec = (performance.now() - startTime) / 1000;
               if (elapsedSec >= TEST_SECONDS) {
                  finished = true;
                  line(
                     '===== RESULTADO (' +
                        TEST_SECONDS +
                        's): ' +
                        jumpCount +
                        ' saltos de posición (máx ' +
                        maxJumpPx.toFixed(0) +
                        'px), ' +
                        longtaskCount +
                        ' longtasks (' +
                        longtaskTotalMs.toFixed(0) +
                        'ms totales) =====',
                     '#ff0',
                  );
                  return;
               }
               requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
         })();
      </script>

      <!-- Widget de chat LeadConnector -->
      {!disableChatWidget && (
         <script
            is:inline
            src="https://widgets.leadconnectorhq.com/loader.js"
            data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
            data-widget-id="6a629fdd6f3b01a586db9391"></script>
      )}

      <!--
         El widget de LeadConnector se posiciona a sí mismo dentro de su
         propio shadow DOM (no llega el CSS normal) fijando "right: 20px"
         inline UNA SOLA VEZ al montar. En móvil lo reubicamos por JS -- y,
         a pedido, también lo pasamos de la derecha a la izquierda. Ojo con
         esto: si al volver a escritorio simplemente LIMPIÁBAMOS ese
         left/right (pensando que así "vuelve al default"), no vuelve solo
         -- el widget no lo recalcula en resize, así que queda pegado a la
         izquierda para siempre (confirmado). Por eso, al volver a
         escritorio, hay que RESTAURAR explícitamente "right: 20px" en vez
         de solo limpiar.
      -->
      <script is:inline>
         (function () {
            function repositionChatWidget() {
               var host = document.querySelector('chat-widget');
               var root = host && host.shadowRoot;
               var box = root && root.getElementById('lc_text-widget');
               var btn = root && root.getElementById('lc_text-widget--btn');
               if (!box || !btn) return false;
               var isMobile = window.matchMedia('(max-width: 1023px)').matches;
               var bottomOffset = isMobile ? 'calc(4.5rem + env(safe-area-inset-bottom))' : '20px';
               var leftOffset = 'calc(20px + env(safe-area-inset-left))';
               [box, btn].forEach(function (el) {
                  // El widget trae su propia transición CSS (para su
                  // animación de apertura/cierre) que no controlamos desde
                  // afuera (vive en su shadow DOM). Si la dejamos activa
                  // mientras reescribimos bottom/left/right en cada resize,
                  // cualquier cambio -aunque sea mínimo, por redondeo de
                  // env(safe-area-inset-*) al mostrarse/ocultarse la barra
                  // del navegador- se anima como un salto visible justo al
                  // lado de la barra inferior (el "flote" reportado). La
                  // apagamos solo para este cambio de posición puntual y la
                  // restauramos en el siguiente frame para no romper la
                  // animación propia de apertura/cierre del widget.
                  var prevTransition = el.style.transitionProperty;
                  el.style.transitionProperty = 'none';

                  el.style.bottom = bottomOffset;
                  if (isMobile) {
                     el.style.right = 'auto';
                     el.style.left = leftOffset;
                     el.dataset.lcForcedLeft = '1';
                  } else if (el.dataset.lcForcedLeft) {
                     // Volvimos de móvil a escritorio sin recargar: restauramos
                     // el default real del widget (right:20px), no lo dejamos
                     // "sin setear" -- eso no alcanza, ver comentario arriba.
                     el.style.left = '';
                     el.style.right = '20px';
                     delete el.dataset.lcForcedLeft;
                  }

                  void el.offsetWidth; // fuerza reflow para que "none" aplique a este cambio puntual
                  requestAnimationFrame(function () {
                     el.style.transitionProperty = prevTransition;
                  });
               });
               return true;
            }

            // Los eventos resize en móvil pueden dispararse varias veces
            // seguidas (barra de direcciones animándose, rotación, etc.) --
            // los agrupamos en uno por frame en vez de reposicionar en cada
            // uno, para no reescribir el estilo del widget de más.
            var repositionScheduled = false;
            function scheduleReposition() {
               if (repositionScheduled) return;
               repositionScheduled = true;
               requestAnimationFrame(function () {
                  repositionScheduled = false;
                  repositionChatWidget();
               });
            }

            window.addEventListener('resize', scheduleReposition);
            if (window.visualViewport) {
               window.visualViewport.addEventListener('resize', scheduleReposition);
            }

            var attempts = 0;
            var poll = setInterval(function () {
               attempts++;
               if (repositionChatWidget() || attempts > 30) clearInterval(poll);
            }, 300);
         })();
      </script>
   </body>
</html>

<!-- bust cache -->
