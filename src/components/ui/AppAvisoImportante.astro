---
// "Aviso importante" visible en las fichas de apps (wireframes de
// CrediSeguro/Tala, 2026-11-16): bloque H2 + párrafo justo debajo del hero.
// Mismo texto que el modal de no afiliación (AppDisclaimerModal.astro), que
// se mantiene; este bloque lo deja además como contenido de la página.
import StarField from '@components/decorative/StarField.astro';

interface Props {
   id: string;
}

const { id } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4 text-center" data-aos="fade-up">
   <StarField id={`${id}-aviso`} ambientCount={25} />

   <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Aviso importante
   </h2>
   <p class="mx-auto mt-4 max-w-2xl text-gray-700 dark:text-white/80">
      Movapp no está afiliado, asociado ni respaldado por ninguna de las aplicaciones mencionadas en este sitio. El uso,
      registro o contratación de dichas aplicaciones es responsabilidad exclusiva del usuario.
   </p>
</section>
