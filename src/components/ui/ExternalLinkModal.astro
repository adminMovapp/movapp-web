---
// Modal de confirmación reutilizable para cualquier botón que lleve a un
// sitio externo (fuera de movapp.org) -- pedido explícito de Santiago en los
// comentarios del wireframe de "Dónde denunciar" (PrestaFácil/FortaPrest):
// antes de salir del sitio, avisar al usuario. Un solo modal compartido por
// página: cualquier link con el atributo `data-external-warn` (+
// `data-external-label`, opcional, el nombre visible del destino) dispara
// este mismo modal en vez de que cada botón tenga su propio diálogo.
//
// Progresivo sin JS: el <a> real conserva su href siempre -- sin JS, el
// click navega directo (degradación correcta, ver skill Diseño). Con JS, el
// script de abajo intercepta el click, muestra el modal, y solo navega si
// el usuario confirma.
//
// Animación "trueno" + card glass (2026-09-02, tres vueltas de feedback
// explícito hasta llegar a esta secuencia):
// 1. "una animación como si 'cayera' un trueno, y luego aparece el modal"
// 2. "me refiero a que el modal debe 'aparecer' de un trueno" (se probó que
//    la card cayera ella misma, y luego que parpadeara en el propio
//    destello -- ninguna de las dos era lo pedido)
// 3. "la animación debe 'salir' del modal. o sea, un tipo 'rayo' cae al
//    centro de la pantalla, y después ya aparece el modal" -- secuencia
//    final: un rayo (SVG, decorativo) cae del borde superior de la
//    pantalla hasta el centro, el impacto dispara el destello del
//    ::backdrop, el rayo se desvanece, y RECIÉN AHÍ aparece la card -- dos
//    eventos en orden, no simultáneos.
//
// El rayo vive dentro de <dialog> (no como hermano suelto) porque los
// diálogos abiertos con showModal() se pintan en el "top layer" del
// navegador, por encima de todo lo demás incluyendo su propio ::backdrop --
// un div fuera del <dialog> quedaría tapado por ese backdrop. Al ser
// descendiente, "position: fixed" en el rayo sigue centrando contra el
// viewport (el <dialog> no mete transform/filter que cree un nuevo
// contenedor), no contra la card.
//
// Glass más tenue que el .glass-card estándar del sitio (ese es casi
// opaco, pensado para FAQ/Contacto sobre fondo con StarField) -- acá se
// baja la opacidad para que se note el blur/vidrio sin oscurecer tanto el
// texto del propio modal.
---

<dialog id="external-link-modal" class="external-link-modal">
   <svg class="external-link-bolt" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
      <path
         fill-rule="evenodd"
         clip-rule="evenodd"
         d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z"
      />
   </svg>
   <div class="external-link-modal-card rounded-2xl p-7">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white">Vas a salir de Movapp</h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-white/70">
         Estás a punto de visitar <span id="external-link-target" class="font-semibold text-gray-900 dark:text-white" />, un
         sitio externo a Movapp. ¿Deseas continuar?
      </p>
      <div class="mt-6 flex justify-end gap-3">
         <button
            type="button"
            id="external-link-cancel"
            class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-white/20 dark:text-white/80 dark:hover:bg-white/10"
         >
            Cancelar
         </button>
         <a
            id="external-link-confirm"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-purple_mv px-5 py-2.5 text-sm font-bold text-white transition hover:bg-purple_mv/85"
         >
            Continuar
         </a>
      </div>
   </div>
</dialog>

<style>
   .external-link-modal {
      max-width: 26rem;
      width: calc(100% - 2rem);
      border: none;
      border-radius: 1rem;
      padding: 0;
      background: transparent;
      overflow: visible;
   }

   /* Glass más tenue que el .glass-card estándar (global.css usa 0.85/0.9
      de opacidad, pensado para ir sobre un fondo con StarField) -- acá se
      baja para que el efecto vidrio se note sin restarle lectura al texto,
      que va directo sobre el ::backdrop oscuro/claro. */
   .external-link-modal-card {
      background-color: rgba(255, 255, 255, 0.72);
      border: 1px solid rgba(124, 58, 237, 0.18);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      position: relative;
      z-index: 0;
      animation: external-modal-card-appear 0.35s ease-out 0.45s both;
   }
   html.dark .external-link-modal-card {
      background-color: rgba(17, 17, 17, 0.6);
      border-color: rgba(255, 255, 255, 0.12);
   }

   .external-link-modal::backdrop {
      background: rgba(0, 0, 0, 0.6);
      animation: external-modal-thunder-flash 0.6s ease-out 0.18s both;
   }

   /* El rayo: nace arriba del viewport, cae en línea recta hasta el centro
      (0%-45%), "impacta" con un breve estallido de tamaño (45%-60%, mismo
      instante en que el ::backdrop de abajo destella) y se apaga (60%-100%)
      antes de que la card empiece a aparecer. */
   .external-link-bolt {
      position: fixed;
      top: 50%;
      left: 50%;
      z-index: 1;
      width: 4rem;
      height: 4rem;
      color: #fff;
      filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.9)) drop-shadow(0 0 22px rgba(255, 255, 255, 0.75));
      opacity: 0;
      pointer-events: none;
      animation: external-modal-bolt-strike 0.5s cubic-bezier(0.55, 0, 0.85, 0.2) both;
   }

   @keyframes external-modal-bolt-strike {
      0% {
         opacity: 0;
         transform: translate(-50%, calc(-50% - 65vh)) scaleY(1.5);
      }
      40% {
         opacity: 1;
         transform: translate(-50%, -50%) scaleY(1);
      }
      55% {
         opacity: 1;
         transform: translate(-50%, -50%) scale(1.4);
      }
      100% {
         opacity: 0;
         transform: translate(-50%, -50%) scale(0.5);
      }
   }

   /* La card ya no cae ni parpadea -- solo aparece, y recién después de que
      el rayo terminó de impactar (animation-delay 0.45s, ver arriba). */
   @keyframes external-modal-card-appear {
      0% {
         opacity: 0;
         transform: scale(0.92);
      }
      100% {
         opacity: 1;
         transform: scale(1);
      }
   }

   @keyframes external-modal-thunder-flash {
      0% {
         background: rgba(255, 255, 255, 0);
      }
      8% {
         background: rgba(255, 255, 255, 0.85);
      }
      16% {
         background: rgba(255, 255, 255, 0.15);
      }
      24% {
         background: rgba(255, 255, 255, 0.75);
      }
      45% {
         background: rgba(0, 0, 0, 0.6);
      }
      100% {
         background: rgba(0, 0, 0, 0.6);
      }
   }

   @media (prefers-reduced-motion: reduce) {
      .external-link-modal-card {
         animation: none;
      }
      .external-link-modal::backdrop {
         animation: none;
      }
      .external-link-bolt {
         display: none;
      }
   }
</style>

<script>
   function initExternalLinkModal(modal: HTMLDialogElement) {
      if (modal.dataset.ready === 'true') return;
      modal.dataset.ready = 'true';

      const targetLabel = modal.querySelector('#external-link-target');
      const confirmLink = modal.querySelector<HTMLAnchorElement>('#external-link-confirm');
      const cancelBtn = modal.querySelector('#external-link-cancel');
      if (!targetLabel || !confirmLink || !cancelBtn) return;

      document.querySelectorAll<HTMLAnchorElement>('a[data-external-warn]').forEach((link) => {
         link.addEventListener('click', (e) => {
            e.preventDefault();
            confirmLink.href = link.href;
            targetLabel.textContent = link.dataset.externalLabel || link.href;
            modal.showModal();
         });
      });

      cancelBtn.addEventListener('click', () => modal.close());
      confirmLink.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (e) => {
         if (e.target === modal) modal.close();
      });
   }

   const initAllExternalLinkModals = () => {
      document.querySelectorAll<HTMLDialogElement>('#external-link-modal').forEach(initExternalLinkModal);
   };

   initAllExternalLinkModals();
   document.addEventListener('astro:page-load', initAllExternalLinkModals);
</script>
