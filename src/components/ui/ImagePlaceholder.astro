---
// Campo reservado para una foto real pendiente de Marketing/diseño -- no es
// contenido, así que va aria-hidden (el texto real de cada sección no
// depende de esta imagen). Tamaño se controla desde afuera con `class`.
interface Props {
   class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
   class={`flex items-center justify-center overflow-hidden rounded-2xl border border-dashed border-purple_mv/30 bg-purple_mv/5 dark:border-white/15 dark:bg-white/5 ${className}`}
   aria-hidden="true"
>
   <svg class="h-7 w-7 text-purple_mv/40 dark:text-white/25" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path
         stroke-linecap="round"
         stroke-linejoin="round"
         d="M2.25 15.75l5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
      ></path>
   </svg>
</div>
