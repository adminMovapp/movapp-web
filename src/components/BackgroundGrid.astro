---
// Fondo global reutilizable: rejilla graph-paper SOLO en la parte superior
// (se desvanece hacia abajo con una máscara) + orbes morados difuminados.
// Se monta una sola vez (en Layout.astro) detrás del contenido (-z-10).
---

<div class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[800px] overflow-hidden" aria-hidden="true">
   <!-- Rejilla graph-paper, difuminada hacia abajo y hacia los lados -->
   <div
      class="absolute inset-0 text-gray-900 opacity-[0.12] dark:text-white dark:opacity-[0.14]"
      style="-webkit-mask-image: radial-gradient(120% 80% at 50% 0%, black 0%, black 30%, transparent 75%); mask-image: radial-gradient(120% 80% at 50% 0%, black 0%, black 30%, transparent 75%);"
   >
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
         <defs>
            <pattern id="bgGrid" width="44" height="44" patternUnits="userSpaceOnUse">
               <path d="M 44 0 L 0 0 0 44" fill="none" stroke="currentColor" stroke-width="1"></path>
            </pattern>
         </defs>
         <rect width="100%" height="100%" fill="url(#bgGrid)"></rect>
      </svg>
   </div>

   <!-- Resplandor morado central detrás del hero -->
   <div
      class="absolute left-1/2 top-[-120px] h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-purple_mv/15 blur-[120px] dark:bg-purple_mv/25"
   >
   </div>

   <!-- Orbes morados difuminados -->
   <div
      class="absolute -left-32 top-10 h-[400px] w-[400px] rounded-full bg-purple_mv/20 blur-3xl dark:bg-purple_mv/25 animate-floatSlow"
   >
   </div>
   <div
      class="absolute -right-40 top-32 h-[450px] w-[450px] rounded-full bg-purple_mv/15 blur-3xl dark:bg-purple_mv/20 animate-floatSlow"
      style="animation-delay: -4s;"
   >
   </div>
</div>
