---
// Línea de tiempo de scroll reutilizable (2026-09-01) -- extraída de la
// primera implementación en StarprestaSenalesRiesgo.astro para no duplicar
// ~150 líneas de CSS/JS casi idénticas en cada app "montadeudas"
// (Starpresta/Prestafacil/Mexicash/Fortapresta -- las 4 tienen una sección
// "Señales de riesgo" con la misma mecánica, solo cambian el título y los
// textos). Réplica del mecanismo visual de la sección "Evaluación
// preclínica" en bioaltaris.netlify.app: línea central con relleno de
// progreso animado al hacer scroll, tarjetas alternadas izquierda/derecha
// en escritorio, una sola columna con la línea a la izquierda en móvil (ver
// memoria "seo_landings_build_status" para el detalle de esa
// investigación). No se replicaron los íconos/categorías/sub-listas por
// tarjeta que trae la referencia -- esos datos no existen en el contenido
// real de este sitio y no hay que inventarlos.
//
// Ícono de nave espacial (2026-09-01, a pedido explícito: "que vaya
// bajando con el scroll") -- viaja sobre la línea seguida al mismo % de
// progreso que el relleno, calculado en el mismo listener de scroll (que
// solo LEE la posición -- nunca preventDefault()/scrollTo(), no es
// scroll-jacking).
import StarField from '@components/decorative/StarField.astro';

interface RiskItem {
   title?: string;
   text: string;
   // Excepción confirmada con Santiago (PrestafacilSenalesRiesgo.astro,
   // 2026-08-28): un texto distinto SOLO en móvil para una tarjeta puntual,
   // el de escritorio no se toca.
   textMobile?: string;
}

interface Props {
   id: string;
   heading: string;
   items: RiskItem[];
}

const { id, heading, items } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <StarField id={`${id}-senales-riesgo`} ambientCount={35} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      {heading}
   </h2>

   <div class="riesgo-track relative mt-12 md:mt-16">
      <div class="riesgo-linea" aria-hidden="true"></div>
      <div class="riesgo-progreso" aria-hidden="true"></div>
      <div class="riesgo-nave" aria-hidden="true">
         <!-- El ícono se dibujó con la nariz hacia arriba (orientación de
              despegue) -- se rota 180° para que apunte hacia abajo, en el
              sentido en el que realmente viaja (desciende con el scroll). -->
         <svg class="rotate-180" viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg">
            <path
               d="M12 2 C9.2 5.3 7.6 9.1 7.6 12.8 C7.6 14.3 7.9 15.7 8.4 17 L15.6 17 C16.1 15.7 16.4 14.3 16.4 12.8 C16.4 9.1 14.8 5.3 12 2 Z"
               fill="currentColor"
            />
            <circle cx="12" cy="10.5" r="1.6" fill="#130b1e" />
            <path d="M8.4 15.5 L4.8 19.5 L6.3 21.3 L9.3 17.3 Z" fill="currentColor" />
            <path d="M15.6 15.5 L19.2 19.5 L17.7 21.3 L14.7 17.3 Z" fill="currentColor" />
            <path
               d="M10.2 17.3 C10.7 17.7 11.3 17.9 12 17.9 C12.7 17.9 13.3 17.7 13.8 17.3 C14.1 18.7 13.3 20.8 12 22.2 C10.7 20.8 9.9 18.7 10.2 17.3 Z"
               fill="#ffb84d"
            />
         </svg>
      </div>

      <ul class="flex flex-col gap-8 md:gap-10">
         {
            items.map((item, i) => (
               <li class="riesgo-fila relative" data-lado={i % 2 === 0 ? 'izq' : 'der'}>
                  <span class="riesgo-nodo" aria-hidden="true" />
                  <div
                     class="riesgo-tarjeta rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30"
                     data-aos="fade-up"
                     data-aos-delay={Math.min(i * 60, 300)}
                  >
                     {item.title && <h3 class="font-bold text-text_banner">{item.title}</h3>}
                     {item.textMobile ? (
                        <>
                           <p class="mt-2 text-sm text-gray-700 dark:text-white/80 md:hidden">{item.textMobile}</p>
                           <p class="mt-2 hidden text-sm text-gray-700 dark:text-white/80 md:block">{item.text}</p>
                        </>
                     ) : (
                        <p class:list={['text-sm text-gray-700 dark:text-white/80', item.title && 'mt-2']}>{item.text}</p>
                     )}
                  </div>
               </li>
            ))
         }
      </ul>
   </div>
</section>

<style>
   /* --- Progressive enhancement: sin JS no hay progreso de scroll ni nave
      que animar -- la línea/nodos/nave (puramente decorativos) se ocultan y
      las tarjetas vuelven a un apilado simple de ancho completo. CSS propio
      (no Tailwind, apagado en no-js), así que aplica sin depender de JS. */
   :global(html.no-js) .riesgo-linea,
   :global(html.no-js) .riesgo-progreso,
   :global(html.no-js) .riesgo-nodo,
   :global(html.no-js) .riesgo-nave {
      display: none;
   }
   :global(html.no-js) .riesgo-fila {
      display: block;
      padding: 0;
   }
   :global(html.no-js) .riesgo-tarjeta {
      width: 100%;
      max-width: none;
   }

   .riesgo-linea,
   .riesgo-progreso {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 1.25rem;
      width: 2px;
      transform: translateX(-50%);
   }
   .riesgo-linea {
      background: rgba(129, 73, 226, 0.2);
   }
   .riesgo-progreso {
      height: 0%;
      background: linear-gradient(180deg, #8149e2, #b794f6);
      box-shadow: 0 0 8px rgba(129, 73, 226, 0.5);
      transition: height 0.1s linear;
   }
   .riesgo-nave {
      position: absolute;
      top: 0%;
      left: 1.25rem;
      z-index: 2;
      color: #e9d8ff;
      filter: drop-shadow(0 0 6px rgba(129, 73, 226, 0.85));
      transform: translate(-50%, -50%);
      transition: top 0.1s linear;
   }

   .riesgo-fila {
      padding-left: 3.5rem;
   }
   .riesgo-nodo {
      position: absolute;
      top: 50%;
      left: 1.25rem;
      width: 10px;
      height: 10px;
      transform: translate(-50%, -50%);
      border-radius: 999px;
      background: #8149e2;
      box-shadow: 0 0 10px rgba(129, 73, 226, 0.8);
   }
   .riesgo-tarjeta {
      backdrop-filter: blur(4px);
   }

   @media (min-width: 768px) {
      .riesgo-linea,
      .riesgo-progreso,
      .riesgo-nave {
         left: 50%;
      }
      .riesgo-fila {
         display: flex;
         padding-left: 0;
      }
      .riesgo-fila[data-lado='izq'] {
         justify-content: flex-end;
         padding-right: calc(50% + 1.75rem);
      }
      .riesgo-fila[data-lado='der'] {
         justify-content: flex-start;
         padding-left: calc(50% + 1.75rem);
      }
      .riesgo-nodo {
         left: 50%;
      }
      .riesgo-tarjeta {
         width: 100%;
      }
   }
</style>

<script>
   // Relleno de progreso + nave: solo LEEN la posición de scroll para
   // animar un alto/top en porcentaje -- nunca interceptan ni bloquean el
   // scroll real (a diferencia del efecto de glitch que se probó y se
   // abandonó en StarprestaInfo.astro).
   const initRiesgoTrack = (track: HTMLElement) => {
      if (track.dataset.ready === 'true') return;
      track.dataset.ready = 'true';

      const progreso = track.querySelector<HTMLElement>('.riesgo-progreso');
      const nave = track.querySelector<HTMLElement>('.riesgo-nave');
      if (!progreso) return;

      const update = () => {
         const rect = track.getBoundingClientRect();
         const viewportCenter = window.innerHeight * 0.5;
         const total = rect.height + viewportCenter;
         const advanced = viewportCenter - rect.top;
         const ratio = total > 0 ? Math.min(1, Math.max(0, advanced / total)) : 0;
         progreso.style.height = `${ratio * 100}%`;
         if (nave) nave.style.top = `${ratio * 100}%`;
      };

      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
   };

   const initAllRiesgoTracks = () => {
      document.querySelectorAll<HTMLElement>('.riesgo-track').forEach(initRiesgoTrack);
   };

   initAllRiesgoTracks();
   document.addEventListener('astro:page-load', initAllRiesgoTracks);
</script>
