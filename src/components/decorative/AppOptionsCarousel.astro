---
// Carrusel de "otras apps a consultar" (2026-09-02, a pedido: "todas las
// secciones donde se muestran las 'opciones' de las apps, se muestren en
// forma de carrusel... de una card, en una... una se va, otra llega...
// pero que aparezcan las flechas") -- reemplaza el grid de 3 columnas que
// tenían StarprestaOtrasApps.astro/PrestafacilOtrasApps.astro/
// MexicashOtrasApps.astro/FortaprestaOtrasApps.astro/TalaOtrasApps.astro/
// KueskiOtrasApps.astro/KlarOtrasApps.astro/CrediseguroOtrasApps.astro (los
// 8 archivos originales ahora solo arman su propio arreglo de apps y
// delegan el render acá, mismo criterio que RiskTimeline.astro para
// "Señales de riesgo").
//
// Mecanismo: scroll-snap horizontal (1 slide = 100% del track, como el
// carrusel móvil de HomeTrust.astro/BlogCategorySection.astro) en vez de
// una animación de transform hecha a mano -- las flechas solo LEEN
// scrollLeft/clientWidth para calcular a qué slide ir y piden un
// scrollTo({behavior:'smooth'}), el navegador se encarga del deslizamiento
// ("una se va, otra llega"); el swipe táctil funciona gratis, por el mismo
// mecanismo nativo. Sin JS, snap-x/overflow-x-auto no aplican (Tailwind
// gateado) y las 3 apps quedan apiladas, completas, una debajo de otra.
//
// Card en 2 columnas (2026-09-03, a pedido explícito: "las cards con las
// apps que están en carrusel DE TODAS LAS LANDINGS DONDE ESTÉN, mejor
// aparezcan igual que con los heros de cada app. que es, la imagen a la
// izquierda, y el texto a la derecha") -- antes: ícono arriba, texto
// centrado debajo. Ahora, mismo criterio de layout que AppHero.astro:
// grid-cols-1 en móvil (ícono arriba, texto abajo) -> md:grid-cols-2 en
// escritorio (ícono a la izquierda, texto a la derecha, centrado
// verticalmente con "items-center" en el grid). No se copió el "stretch"
// de alto completo que usa AppHero para su imagen -- ahí tiene sentido
// porque el texto vecino es un H1+párrafo+botón, alto y variable; acá el
// texto es corto (nombre + estatus + link), así que el ícono se queda con
// un tamaño fijo (24/28 en vez de estirarse a un rectángulo raro).
import { Image } from 'astro:assets';
import { DIRECTORIO_ICONS, type DirectorioApp } from '@constants/directorioApps.ts';
import StarField from '@components/decorative/StarField.astro';

interface Props {
   id: string;
   // id real del <section> en el DOM, para anclas de scroll (ej.
   // "directorio-reportadas", referenciado desde searchIndex.ts) -- las 8
   // secciones "Otras apps" no lo necesitan y lo omiten.
   sectionId?: string;
   heading: string;
   // Párrafo opcional entre el <h2> y el carrusel -- lo usan
   // DirectorioReportadas.astro/DirectorioReguladas.astro (la landing de
   // /aplicaciones-prestamo), las 8 secciones "Otras apps" no traen.
   description?: string;
   apps: DirectorioApp[];
   // Verde para apps reguladas ("Verificada"), rojo para reportadas
   // ("Reportes verificados") -- mismo criterio que ya usaban los grids.
   statusColor: 'green' | 'red';
}

const { id, sectionId, heading, description, apps, statusColor } = Astro.props;
const statusClass = statusColor === 'green' ? 'text-green-500' : 'text-red-500';
---

<section id={sectionId} class="relative mx-auto my-section w-full max-w-2xl scroll-mt-28 px-4" data-aos="fade-up">
   <StarField id={`${id}-otras-apps`} ambientCount={40} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      {heading}
   </h2>
   {description && <p class="mx-auto mt-4 max-w-2xl text-center text-gray-700 dark:text-white/80">{description}</p>}

   <div class="otras-apps-carousel mt-10 flex items-center gap-3 sm:gap-5">
      <button
         type="button"
         aria-label="Aplicación anterior"
         class="otras-apps-prev flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-purple_mv/40 text-purple_mv transition hover:bg-text_banner hover:text-white dark:border-white/20"
      >
         <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
         </svg>
      </button>

      <ul class="otras-apps-track flex flex-1 snap-x snap-mandatory overflow-x-auto scroll-smooth">
         {
            apps.map((app) => (
               <li class="w-full flex-shrink-0 snap-center px-1">
                  <div class="mx-auto grid max-w-sm grid-cols-1 items-center gap-4 rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:max-w-md md:grid-cols-2 md:gap-5">
                     {DIRECTORIO_ICONS[app.slug] && (
                        <div class="mx-auto flex h-24 w-24 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5 md:mx-0 md:h-28 md:w-28">
                           <Image src={DIRECTORIO_ICONS[app.slug]} alt="" width={112} class="h-full w-full object-contain p-3" loading="lazy" />
                        </div>
                     )}
                     <div class="text-center md:text-left">
                        <h3 class="text-lg font-bold text-text_banner">{app.name}</h3>
                        <p class={`mt-2 text-sm font-semibold ${statusClass}`}>✓ {app.status}</p>
                        <a
                           href={`/aplicaciones-prestamo/${app.slug}`}
                           class="mt-3 inline-block text-sm font-semibold text-text_banner underline-offset-4 hover:underline"
                        >
                           Ver información
                        </a>
                     </div>
                  </div>
               </li>
            ))
         }
      </ul>

      <button
         type="button"
         aria-label="Siguiente aplicación"
         class="otras-apps-next flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-full border border-purple_mv/40 text-purple_mv transition hover:bg-text_banner hover:text-white dark:border-white/20"
      >
         <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
         </svg>
      </button>
   </div>
</section>

<style>
   /* Scrollbar del track oculta -- el swipe/scroll sigue funcionando, solo
      se esconde la barra nativa (el snap ya comunica visualmente "una
      tarjeta por vez", no hace falta ver la barra). */
   .otras-apps-track {
      scrollbar-width: none;
      -ms-overflow-style: none;
   }
   .otras-apps-track::-webkit-scrollbar {
      display: none;
   }
</style>

<script>
   // Las flechas solo LEEN scrollLeft/clientWidth para calcular el próximo
   // slide y piden scrollTo({behavior:'smooth'}) -- nunca interceptan el
   // scroll/swipe real (mismo criterio que .riesgo-track en
   // RiskTimeline.astro). Circular: de la última pasa a la primera y
   // viceversa.
   //
   // Auto-avance cada 5s (2026-09-02, a pedido explícito: "el carrusel...
   // se debe mover sólo. cada 5s" -- las flechas quedan como el cambio
   // manual "por si el usuario quiere cambiar directamente"). Se pausa con
   // el mouse encima o con foco de teclado adentro (no competir con quien
   // está leyendo o navegando con tab), se reinicia el conteo tras un click
   // manual en una flecha, y solo corre mientras el carrusel está
   // realmente visible en pantalla (IntersectionObserver) -- no tiene
   // sentido seguir moviendo un carrusel que no se ve.
   const AUTOPLAY_MS = 5000;

   const initOtrasAppsCarousel = (carousel: HTMLElement) => {
      if (carousel.dataset.ready === 'true') return;
      carousel.dataset.ready = 'true';

      const track = carousel.querySelector<HTMLElement>('.otras-apps-track');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.otras-apps-prev');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.otras-apps-next');
      if (!track || !prevBtn || !nextBtn) return;

      const totalSlides = track.children.length;
      if (totalSlides <= 1) return;

      // Sin auto-avance para quien pide "reducir movimiento" (WCAG
      // 2.2.2 -- contenido que se mueve solo debe poder pausarse; acá
      // directamente no arranca). Las flechas para cambiar manualmente
      // siguen funcionando igual.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const goTo = (delta: number) => {
         const width = track.clientWidth;
         if (width <= 0) return;
         const current = Math.round(track.scrollLeft / width);
         const next = (current + delta + totalSlides) % totalSlides;
         track.scrollTo({ left: next * width, behavior: 'smooth' });
      };

      let timer: ReturnType<typeof setInterval> | null = null;
      let visible = false;
      let paused = false;

      const stopAutoplay = () => {
         if (timer) clearInterval(timer);
         timer = null;
      };
      const startAutoplay = () => {
         stopAutoplay();
         if (reduceMotion || !visible || paused) return;
         timer = setInterval(() => goTo(1), AUTOPLAY_MS);
      };

      prevBtn.addEventListener('click', () => {
         goTo(-1);
         startAutoplay();
      });
      nextBtn.addEventListener('click', () => {
         goTo(1);
         startAutoplay();
      });

      carousel.addEventListener('pointerenter', () => {
         paused = true;
         stopAutoplay();
      });
      carousel.addEventListener('pointerleave', () => {
         paused = false;
         startAutoplay();
      });
      carousel.addEventListener('focusin', () => {
         paused = true;
         stopAutoplay();
      });
      carousel.addEventListener('focusout', () => {
         paused = false;
         startAutoplay();
      });

      if ('IntersectionObserver' in window) {
         const io = new IntersectionObserver(
            (entries) => {
               entries.forEach((entry) => {
                  visible = entry.isIntersecting;
                  if (visible) startAutoplay();
                  else stopAutoplay();
               });
            },
            { threshold: 0.5 },
         );
         io.observe(carousel);
      } else {
         visible = true;
         startAutoplay();
      }
   };

   const initAllOtrasAppsCarousels = () => {
      document.querySelectorAll<HTMLElement>('.otras-apps-carousel').forEach(initOtrasAppsCarousel);
   };

   initAllOtrasAppsCarousels();
   document.addEventListener('astro:page-load', initAllOtrasAppsCarousels);
</script>
