---
// Fondo decorativo reutilizable para las secciones del home (excepto el
// hero, que tiene su propio fondo independiente y no usa este componente).
// Dibuja estrellas titilantes ambiente + estrellas fugaces que cruzan la
// sección de vez en cuando, más el mismo resplandor morado tenue del hero
// (para que el lenguaje visual sea consistente en todo el home).

interface Props {
   id: string;
   ambientCount?: number;
   // false para secciones donde el fondo debe quedarse dentro de su propio
   // contenedor (p. ej. una tarjeta con overflow-hidden) en vez de
   // "sangrar" a todo el ancho de la pantalla como en las demás secciones.
   fullBleed?: boolean;
}

const { id, ambientCount = 45, fullBleed = true } = Astro.props;

// fullBleed: SIN overflow-hidden (ni siquiera "overflow-x-hidden") a
// propósito. El resplandor de abajo está centrado en el borde superior de
// la sección (top-0 -translate-y-1/2) y su blur necesita poder desbordarse
// verticalmente para mezclarse con el resplandor de la sección de arriba y
// de abajo -- si no, la costura entre secciones se ve como un corte duro.
//
// Probamos primero "overflow-x-hidden" solo (para seguir recortando en X
// pero no en Y) y NO funcionó -- confirmado muestreando los píxeles reales
// renderizados. Es una regla real de CSS: si overflow-x no es "visible" y
// overflow-y no se especifica (o incluso si se especifica "visible" a
// mano), el navegador FUERZA el valor computado de overflow-y a "auto" en
// vez de "visible" -- y "auto" sigue recortando igual que "hidden". No hay
// forma de tener "recorta en X, no recorta en Y" en un solo elemento.
//
// Por eso aquí no se recorta en NINGÚN eje. No hace falta: el ancho de este
// div ya es exactamente 100vw (w-screen, centrado con left-1/2 más
// -translate-x-1/2), así que no hay nada adentro que vaya a desbordarse
// horizontalmente en la práctica (ni las estrellas ambiente, acotadas 0-100%,
// ni el resplandor, que mide menos del 100% de ancho) -- y el <body> ya
// trae su propio overflow-x-hidden como red de seguridad general del sitio.
// Las estrellas fugaces tienen su propio overflow-hidden más abajo, así que
// tampoco se escapan por este cambio.
const wrapperClass = fullBleed
   ? 'field-root pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2'
   : 'field-root pointer-events-none absolute inset-0 -z-10 overflow-hidden';
---

<div class={wrapperClass} data-field-id={id} data-ambient={ambientCount} aria-hidden="true">
   <!-- Resplandor superior tenue, mismo tono que el del hero -->
   <div
      class="pointer-events-none absolute left-1/2 top-0 h-40 w-[70%] max-w-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-purple_mv/[0.06] blur-[120px] dark:bg-purple_mv/[0.18]"
   >
   </div>

   <!-- Estrellas ambiente (pobladas por el script de abajo) -->
   <div class="field-stars absolute inset-0 text-purple_mv/40 dark:text-white/70"></div>

   <!-- Estrellas fugaces: cruzan la sección de vez en cuando (JS más abajo) -->
   <div class="field-shooting-stars absolute inset-0 overflow-hidden text-purple_mv/70 dark:text-white"></div>
</div>

<style>
   /*
      box-shadow FIJO (no animado): con hasta ~45 estrellas por sección y
      varias secciones en el Home, animar el radio del box-shadow fuerza un
      repintado por elemento en cada frame -- confirmado con un
      diagnóstico en el propio sitio como causa real de que la barra
      inferior (MobileBottomNav) pareciera "flotar" en móvil. Solo opacity
      anima acá (el compositor la mueve sin tocar el hilo principal); el
      halo queda del tamaño de su punto más brillante todo el tiempo, y su
      intensidad sube/baja igual gracias a que "opacity" afecta el
      elemento completo, box-shadow incluido.
   */
   :global(.field-star) {
      position: absolute;
      transform: translate(-50%, -50%);
      border-radius: 9999px;
      background-color: currentColor;
      box-shadow: 0 0 var(--star-glow, 2px) currentColor;
      animation-name: fieldTwinkle;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
      will-change: opacity;
   }

   @keyframes fieldTwinkle {
      0%,
      100% {
         opacity: var(--star-min, 0.15);
      }
      50% {
         opacity: var(--star-max, 0.9);
      }
   }

   :global(.field-shooting-star) {
      position: absolute;
      top: 0;
      left: 0;
      width: 2.5px;
      height: 2.5px;
      border-radius: 9999px;
      background-color: currentColor;
      box-shadow: 0 0 6px 1px currentColor;
      opacity: 0;
      animation-name: fieldShootingStar;
      animation-duration: var(--shoot-dur, 1.1s);
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.3, 1);
      animation-fill-mode: forwards;
   }
   :global(.field-shooting-star::after) {
      content: '';
      position: absolute;
      top: 50%;
      right: 100%;
      width: var(--trail-length, 90px);
      height: 1px;
      background: linear-gradient(90deg, transparent, currentColor);
      transform: translateY(-50%);
   }

   @keyframes fieldShootingStar {
      0% {
         opacity: 0;
         transform: rotate(var(--angle, 25deg)) translateX(0);
      }
      8% {
         opacity: 1;
      }
      70% {
         opacity: 1;
      }
      100% {
         opacity: 0;
         transform: rotate(var(--angle, 25deg)) translateX(var(--distance, 180px));
      }
   }
</style>

<script>
   const AMBIENT_MIN_SIZE = 1;
   const AMBIENT_MAX_SIZE = 2.2;
   const SHOOT_MIN_INTERVAL_MS = 2500;
   const SHOOT_MAX_INTERVAL_MS = 6000;

   const makeAmbientStar = (size: number) => {
      const star = document.createElement('span');
      star.className = 'field-star';

      const duration = 2 + Math.random() * 3;
      const delay = Math.random() * 5;
      const minOpacity = 0.08 + Math.random() * 0.12;
      const maxOpacity = 0.6 + Math.random() * 0.4;
      const glow = size * 2.2;

      star.style.width = `${size}px`;
      star.style.height = `${size}px`;
      star.style.top = `${Math.random() * 100}%`;
      star.style.left = `${Math.random() * 100}%`;
      star.style.animationDuration = `${duration}s`;
      star.style.animationDelay = `${delay}s`;
      star.style.setProperty('--star-min', minOpacity.toFixed(2));
      star.style.setProperty('--star-max', maxOpacity.toFixed(2));
      star.style.setProperty('--star-glow', `${glow.toFixed(2)}px`);

      return star;
   };

   const hashId = (id: string) => {
      let hash = 0;
      for (let i = 0; i < id.length; i++) {
         hash = (hash * 31 + id.charCodeAt(i)) >>> 0;
      }
      return hash;
   };

   const spawnShootingStar = (container: Element) => {
      const star = document.createElement('span');
      star.className = 'field-shooting-star';

      const startTop = Math.random() * 55;
      const startLeft = Math.random() * 70;
      const angle = 15 + Math.random() * 25;
      const distance = 140 + Math.random() * 140;
      const duration = 0.9 + Math.random() * 0.6;
      const trailLength = distance * 0.5;

      star.style.top = `${startTop}%`;
      star.style.left = `${startLeft}%`;
      star.style.setProperty('--shoot-dur', `${duration}s`);
      star.style.setProperty('--angle', `${angle}deg`);
      star.style.setProperty('--distance', `${distance}px`);
      star.style.setProperty('--trail-length', `${trailLength}px`);

      star.addEventListener('animationend', () => star.remove());
      container.appendChild(star);
   };

   const scheduleShootingStars = (container: Element, initialDelay: number) => {
      const loop = () => {
         spawnShootingStar(container);
         const next = SHOOT_MIN_INTERVAL_MS + Math.random() * (SHOOT_MAX_INTERVAL_MS - SHOOT_MIN_INTERVAL_MS);
         setTimeout(loop, next);
      };
      setTimeout(loop, initialDelay);
   };

   // DIAGNÓSTICO TEMPORAL -- borrar junto con el resto del diagnóstico de
   // "navdebug" una vez resuelto el flote de la barra inferior. ?nostars=1
   // desactiva por completo las estrellas ambiente y fugaces de todas las
   // instancias de StarField en la página, para aislar si son ellas las
   // que disparan el bug (confirmado: pasa en Home real pero no en una
   // página de prueba sin StarField).
   const starsDisabled = new URLSearchParams(location.search).get('nostars') === '1';

   const initField = (root: Element) => {
      if (starsDisabled) return;
      if (root.getAttribute('data-populated') === 'true') return;
      root.setAttribute('data-populated', 'true');

      const starsContainer = root.querySelector('.field-stars');
      const ambientCount = parseInt(root.getAttribute('data-ambient') || '45', 10);
      if (starsContainer) {
         const fragment = document.createDocumentFragment();
         for (let i = 0; i < ambientCount; i++) {
            const size = AMBIENT_MIN_SIZE + Math.random() * (AMBIENT_MAX_SIZE - AMBIENT_MIN_SIZE);
            fragment.appendChild(makeAmbientStar(size));
         }
         starsContainer.appendChild(fragment);
      }

      // Las estrellas fugaces se muestran siempre (incluso con
      // prefers-reduced-motion), igual que el marquee y el flotado: es
      // movimiento mínimo/decorativo que el dueño del sitio pidió ver
      // explícitamente en todas las secciones.
      const shootContainer = root.querySelector('.field-shooting-stars');
      if (shootContainer) {
         // Offset inicial por instancia (según su id) para que las distintas
         // secciones no lancen su primera estrella fugaz todas a la vez.
         const id = root.getAttribute('data-field-id') || '';
         const initialDelay = hashId(id) % 2500;
         scheduleShootingStars(shootContainer, initialDelay);
      }
   };

   const initAllFields = () => {
      document.querySelectorAll('.field-root').forEach(initField);
   };

   initAllFields();
   document.addEventListener('astro:page-load', initAllFields);
</script>
