---
// Fondo decorativo reutilizable para las secciones del home (excepto el
// hero, que tiene su propio fondo independiente y no usa este componente).
// Dibuja estrellas titilantes ambiente + una "constelación" propia por
// sección: unos puntos más grandes/brillantes unidos por líneas finas,
// formando una figura distinta en cada lugar donde se usa.
//
// Los puntos van en un espacio porcentual (0-100 x, 0-100 y); las líneas
// son un <svg> con preserveAspectRatio="none" para que use exactamente ese
// mismo espacio (así los puntos de las estrellas y los extremos de las
// líneas siempre coinciden, sin importar el alto/ancho real de la sección).

interface Point {
   x: number;
   y: number;
}

interface Props {
   points: Point[];
   edges: [number, number][];
   id: string;
   ambientCount?: number;
   // false para secciones donde el fondo debe quedarse dentro de su propio
   // contenedor (p. ej. una tarjeta con overflow-hidden) en vez de
   // "sangrar" a todo el ancho de la pantalla como en las demás secciones.
   fullBleed?: boolean;
}

const { points, edges, id, ambientCount = 45, fullBleed = true } = Astro.props;

const wrapperClass = fullBleed
   ? 'field-root pointer-events-none absolute inset-y-0 left-1/2 -z-10 w-screen -translate-x-1/2 overflow-hidden'
   : 'field-root pointer-events-none absolute inset-0 -z-10 overflow-hidden';
---

<div class={wrapperClass} data-field-id={id} data-ambient={ambientCount} data-points={JSON.stringify(points)} aria-hidden="true">
   <!-- Estrellas ambiente (pobladas por el script de abajo) -->
   <div class="field-stars absolute inset-0 text-purple_mv/40 dark:text-white/70"></div>

   <!-- Líneas de la constelación -->
   <svg
      class="absolute inset-0 h-full w-full text-purple_mv/30 dark:text-white/25"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
   >
      {
         edges.map(([a, b]) => (
            <line
               x1={points[a].x}
               y1={points[a].y}
               x2={points[b].x}
               y2={points[b].y}
               stroke="currentColor"
               stroke-width="1.1"
               vector-effect="non-scaling-stroke"
            />
         ))
      }
   </svg>

   <!-- Nodos de la constelación: estrellas más grandes/brillantes -->
   <div class="field-nodes absolute inset-0 text-purple_mv/80 dark:text-white"></div>
</div>

<style>
   :global(.field-star) {
      position: absolute;
      border-radius: 9999px;
      background-color: currentColor;
      animation-name: fieldTwinkle;
      animation-timing-function: ease-in-out;
      animation-iteration-count: infinite;
   }

   @keyframes fieldTwinkle {
      0%,
      100% {
         opacity: var(--star-min, 0.15);
         transform: scale(0.8);
         box-shadow: 0 0 0 currentColor;
      }
      50% {
         opacity: var(--star-max, 0.9);
         transform: scale(1.3);
         box-shadow: 0 0 var(--star-glow, 2px) currentColor;
      }
   }
</style>

<script>
   const AMBIENT_MIN_SIZE = 1;
   const AMBIENT_MAX_SIZE = 2.2;
   const NODE_MIN_SIZE = 2.5;
   const NODE_MAX_SIZE = 3.5;

   const makeStar = (size: number) => {
      const star = document.createElement('span');
      star.className = 'field-star';

      const duration = 2 + Math.random() * 3;
      const delay = Math.random() * 5;
      const minOpacity = 0.08 + Math.random() * 0.12;
      const maxOpacity = 0.6 + Math.random() * 0.4;
      const glow = size * 2.2;

      star.style.width = `${size}px`;
      star.style.height = `${size}px`;
      star.style.animationDuration = `${duration}s`;
      star.style.animationDelay = `${delay}s`;
      star.style.setProperty('--star-min', minOpacity.toFixed(2));
      star.style.setProperty('--star-max', maxOpacity.toFixed(2));
      star.style.setProperty('--star-glow', `${glow.toFixed(2)}px`);

      return star;
   };

   const initField = (root: Element) => {
      if (root.getAttribute('data-populated') === 'true') return;
      root.setAttribute('data-populated', 'true');

      const starsContainer = root.querySelector('.field-stars');
      const nodesContainer = root.querySelector('.field-nodes');
      if (!starsContainer || !nodesContainer) return;

      const ambientCount = parseInt(root.getAttribute('data-ambient') || '45', 10);
      let points: { x: number; y: number }[] = [];
      try {
         points = JSON.parse(root.getAttribute('data-points') || '[]');
      } catch (e) {
         points = [];
      }

      const ambientFragment = document.createDocumentFragment();
      for (let i = 0; i < ambientCount; i++) {
         const size = AMBIENT_MIN_SIZE + Math.random() * (AMBIENT_MAX_SIZE - AMBIENT_MIN_SIZE);
         const star = makeStar(size);
         star.style.top = `${Math.random() * 100}%`;
         star.style.left = `${Math.random() * 100}%`;
         ambientFragment.appendChild(star);
      }
      starsContainer.appendChild(ambientFragment);

      const nodesFragment = document.createDocumentFragment();
      points.forEach((p) => {
         const size = NODE_MIN_SIZE + Math.random() * (NODE_MAX_SIZE - NODE_MIN_SIZE);
         const star = makeStar(size);
         star.style.top = `${p.y}%`;
         star.style.left = `${p.x}%`;
         nodesFragment.appendChild(star);
      });
      nodesContainer.appendChild(nodesFragment);
   };

   const initAllFields = () => {
      document.querySelectorAll('.field-root').forEach(initField);
   };

   initAllFields();
   document.addEventListener('astro:page-load', initAllFields);
</script>
