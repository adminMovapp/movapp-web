---
import HamburgerIcon from '@assets/HamburgerIcon.astro';
import CloseIcon from '@assets/CloseIcon.astro';
---

<div class="relative flex-1">
   <!-- Botón de menú hamburguesa -->
   <button
      id="menuButton"
      class="flex w-full flex-col items-center justify-center gap-1 py-1 text-gray-500 hover:text-text_banner dark:text-white/60 dark:hover:text-white focus:outline-none"
      aria-label="Abrir menú"
   >
      <div id="hamburgerIcon" class="">
         <HamburgerIcon size={6} />
      </div>

      <div id="closeIcon" class="hidden">
         <CloseIcon size={6} />
      </div>
      <span class="text-[11px] font-medium">Menú</span>
   </button>

   <!-- Menú desplegable (abre hacia arriba: el trigger vive en la barra inferior) -->
   <nav
      id="menuNav"
      class="absolute bottom-14 right-0 w-max bg-background_top/95 backdrop-blur-md shadow-lg rounded-lg p-4 flex flex-col gap-2 z-[999999999] hidden"
   >
      <a href="/nosotros" class="text-white text-sm hover:text-text_banner">Movapp</a>
      <a href="/el-hack" class="text-white text-sm hover:text-text_banner">Hack</a>
      <a href="/collaborations" class="text-white text-sm hover:text-text_banner">Colaboraciones</a>
      <a href="/faqs" class="text-white text-sm hover:text-text_banner">Preguntas frecuentes</a>
      <a href="/testimonials" class="text-white text-sm hover:text-text_banner">Testimonios</a>
      <a href="/mind" class="text-white text-sm hover:text-text_banner">Mente digital</a>
      <a href="/red" class="text-white text-sm hover:text-text_banner">Nuestras redes</a>

      <hr class="border-white/15" />

      <!-- Carrito -->
      <a href="/tienda" id="cartButtonMobile" class="relative flex items-center gap-2 text-white text-sm hover:text-text_banner">
         <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
         </svg>
         <span>Carrito</span>
         <span
            data-cart-count
            class="hidden h-5 w-5 items-center justify-center rounded-full bg-text_banner text-[11px] font-bold text-white"
         >0</span>
      </a>

      <!-- Toggle de tema -->
      <button id="themeToggleMobile" type="button" class="flex items-center gap-2 text-white text-sm hover:text-text_banner">
         <svg
            class="block h-4 w-4 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <svg
            class="hidden h-4 w-4 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
         <span>Cambiar tema</span>
      </button>
   </nav>
</div>

<script>
   // Obtenemos los elementos
   const menuButton = document.getElementById('menuButton');
   const hamburgerIcon = document.getElementById('hamburgerIcon');
   const closeIcon = document.getElementById('closeIcon');
   const menuNav = document.getElementById('menuNav');

   // Manejar el clic en el botón del menú
   menuButton.addEventListener('click', () => {
      // Alternamos el menú visible/oculto
      menuNav.classList.toggle('hidden');

      // Alternamos la visibilidad de los íconos
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
   });
</script>
