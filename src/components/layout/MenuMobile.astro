---

<!-- Botón de menú hamburguesa. El panel (#menuNav) vive aparte, en
     MenuMobilePanel.astro -- ver ese archivo para el porqué. -->
<button
   id="menuButton"
   class="flex flex-1 flex-col items-center justify-center gap-1 py-1 text-gray-500 hover:text-text_banner dark:text-white/60 dark:hover:text-white focus:outline-none"
   aria-label="Abrir menú"
   aria-controls="menuNav"
   aria-expanded="false"
>
   <div id="hamburgerIcon">
      <img src="/img/menu.webp" alt="" class="h-6 w-6" />
   </div>

   <div id="menuButtonCloseIcon" class="hidden">
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
         <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
   </div>

   <span class="text-[11px] font-medium">Menú</span>
</button>
