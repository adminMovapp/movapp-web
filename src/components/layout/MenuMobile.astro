---

<!-- Botón de menú hamburguesa. El panel (#menuNav) vive aparte, en
     MenuMobilePanel.astro -- ver ese archivo para el porqué. -->
<button
   id="menuButton"
   class="flex flex-1 flex-col items-center justify-center py-2 text-purple_mv dark:text-white focus:outline-none"
   aria-label="Abrir menú"
   aria-controls="menuNav"
   aria-expanded="false"
>
   <div id="hamburgerIcon">
      <!-- /img/menu.webp es una silueta negra sobre transparente; con
           mask-image (en vez de <img>) se pinta con bg-current, siguiendo
           el mismo text-purple_mv/dark:text-white del botón. -->
      <span class="menu-icon block h-7 w-7 bg-current" aria-hidden="true"></span>
   </div>

   <div id="menuButtonCloseIcon" class="hidden">
      <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
         <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
   </div>
</button>

<style>
   .menu-icon {
      -webkit-mask-image: url('/img/menu.webp');
      mask-image: url('/img/menu.webp');
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-size: contain;
      mask-size: contain;
   }
</style>
