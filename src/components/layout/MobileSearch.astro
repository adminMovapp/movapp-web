---
// Buscador de móvil: mismo patrón de "despliegue in-place" que
// HeaderSearch.astro (ningún modal a pantalla completa) -- el ícono se
// convierte en un campo que se expande hacia la izquierda del propio botón,
// con el dropdown de sugerencias abriéndose hacia arriba, ambos flotando
// arriba de la barra inferior (que se queda visible, igual que el resto del
// menú). A diferencia de la primera versión de este patrón: ahora SÍ
// bloquea el scroll/toque del resto de la página mientras está abierto (ver
// "backdrop"/"lockBodyScroll" en @utils/searchWidget.ts) -- antes no lo
// hacía y se podía seguir navegando/scrolleando la página de atrás.
---

<!--
   Posicionado igual que el botón original (ver MobileBottomNav.astro): hijo
   "absolute" de #mobileBottomNav ("position: sticky", que también sirve de
   contenedor de referencia para descendientes "position: absolute"), pegado
   arriba de la barra con un pequeño espacio ("-translate-y-3", a pedido).

   "flex-row-reverse" + SIN justify-content explícito (default: flex-start):
   en row-reverse el eje principal corre de derecha a izquierda, así que
   "flex-start" ancla al DOM-primer-hijo (el botón) al lado derecho --
   exactamente donde vive fijo con "right-4" -- y el campo (segundo hijo) se
   despliega hacia la izquierda de ahí.
-->
<div id="mobileSearch" class="absolute bottom-full right-4 z-10 flex -translate-y-3 flex-row-reverse items-center gap-2">
   <button
      id="mobileSearchToggle"
      type="button"
      aria-label="Buscar"
      aria-expanded="false"
      aria-controls="mobileSearchField"
      class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-purple_mv text-white shadow-lg shadow-purple_mv/30 transition hover:bg-purple_mv/90"
   >
      <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
         <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
      </svg>
   </button>

   <div id="mobileSearchField" class="search-field-mobile flex items-center overflow-hidden">
      <div class="flex w-[calc(100vw-7rem)] items-center gap-2 rounded-full border border-purple_mv/25 bg-white px-3 py-2 shadow-lg dark:border-white/10 dark:bg-background_bottom">
         <input
            id="mobileSearchInput"
            type="search"
            autocomplete="off"
            enterkeyhint="search"
            placeholder="Buscar en Movapp…"
            class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none dark:text-white dark:placeholder:text-white/40"
         />
         <!-- "x" pedida explícitamente al lado del cuadro de texto, además
              del propio botón flotante (que también alterna abrir/cerrar). -->
         <button
            id="mobileSearchClose"
            type="button"
            aria-label="Cerrar búsqueda"
            class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full text-gray-500 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 dark:hover:text-white"
         >
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
               <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
         </button>
      </div>
   </div>

   <div
      id="mobileSearchDropdown"
      class="search-dropdown absolute bottom-full right-0 z-50 mb-2 hidden max-h-[65vh] w-[calc(100vw-2rem)] flex-col rounded-2xl border border-purple_mv/20 bg-white p-2 shadow-2xl dark:border-white/10 dark:bg-background_bottom"
   >
      <ul id="mobileSearchResults" class="max-h-[55vh] overflow-y-auto"></ul>
      <p id="mobileSearchEmpty" class="hidden px-3 py-6 text-center text-sm text-gray-500 dark:text-white/60">
         Sin resultados. Prueba con otra palabra.
      </p>
   </div>
</div>

<style>
   /* Mismo mecanismo que ".search-field" de HeaderSearch.astro, espejado
      hacia la izquierda (ver "flex-row-reverse" en el markup). */
   .search-field-mobile {
      width: 0;
      transition: width 220ms ease;
   }
   #mobileSearch.is-open .search-field-mobile {
      width: calc(100vw - 7rem);
      margin-right: 0.5rem;
   }

   @media (prefers-reduced-motion: reduce) {
      .search-field-mobile {
         transition: none;
      }
   }

   .search-result-item.is-active {
      background-color: rgba(129, 73, 226, 0.1);
   }
   :global(html.dark) .search-result-item.is-active {
      background-color: rgba(255, 255, 255, 0.05);
   }
</style>

<script>
   import { initSearchWidget } from '@utils/searchWidget';

   initSearchWidget({
      root: 'mobileSearch',
      toggle: 'mobileSearchToggle',
      input: 'mobileSearchInput',
      dropdown: 'mobileSearchDropdown',
      results: 'mobileSearchResults',
      empty: 'mobileSearchEmpty',
      close: 'mobileSearchClose',
      backdrop: 'mobileSearchBackdrop',
      lockBodyScroll: true,
   });
</script>
