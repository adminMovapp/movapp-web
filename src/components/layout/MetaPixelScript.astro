---
export interface Props {
   pixelId: string;
}

const { pixelId } = Astro.props;
---

<script src="/js/metaPixel.js" defer is:inline></script>
<script define:vars={{ pixelId }}>
   document.addEventListener('DOMContentLoaded', () => {
      if (window.metaPixelUtils) {
         window.metaPixelUtils.initMetaPixel(pixelId);

         // Alias global con verificación mejorada
         // Sin console.log acá: esto corre en cada carga de página del sitio
         // publicado y el nombre de cada evento medido quedaba impreso en la
         // consola de cualquier visitante que la abriera.
         window.metaPixel = {
            track: async (eventName, customData = {}, userData = {}) =>
               await window.metaPixelUtils.trackEvent(eventName, customData, userData),
            trackPageView: async (customData = {}) => await window.metaPixelUtils.trackPageView(customData),
         };
      } else {
         // console.error('❌ Meta Pixel utils not loaded');
      }
   });
</script>

<!--
   Fallback sin JS que pide Meta en sus instrucciones de instalación:
   registra al menos el PageView cuando el navegador no ejecuta scripts.
-->
<noscript>
   <img
      height="1"
      width="1"
      style="display:none"
      alt=""
      src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
   />
</noscript>
