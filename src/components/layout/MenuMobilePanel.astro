---
import { Image } from 'astro:assets';
import ImgLogo from '@assets/Logo.png';
import ImgLogoBlanco from '@assets/Logo-Blanco.png';
import { URLS } from '@/constants/socials';
import ArrowIcon from '@assets/ArrowIcon.astro';

const topLinks = [
   { href: '/', label: 'Inicio' },
   { href: '/nosotros', label: 'Movapp' },
   { href: '/el-hack', label: 'Hack' },
];

// Mismo agrupamiento que el submenú "Contenido" del header de escritorio
// (Header.astro) -- ver ese archivo para la fuente de verdad de estos enlaces.
const contentLinks = [
   { href: '/collaborations', label: 'Colaboraciones' },
   { href: '/faqs', label: 'Preguntas frecuentes' },
   { href: '/testimonials', label: 'Testimonios' },
   { href: '/mind', label: 'Mente digital' },
   { href: '/red', label: 'Nuestras redes' },
];

const socials = [
   { href: URLS.youtube, label: 'YouTube', icon: '/img/logo-youtube.webp' },
   { href: URLS.tiktok, label: 'TikTok', icon: '/img/logo-tiktok.webp' },
   { href: URLS.facebook, label: 'Facebook', icon: '/img/logo-facebook.webp' },
   { href: URLS.instagram, label: 'Instagram', icon: '/img/logo-instagram.webp' },
];
---

<!--
   Vive FUERA de <MobileBottomNav> a propósito (se renderiza como hermano
   suyo desde Layout.astro): ese nav tiene un "transform" inline permanente
   (ver su propio script -- compensación de viewport en iOS) y en CSS,
   cualquier transform en un ancestro convierte a ese ancestro en el
   contenedor de referencia para sus descendientes "position: fixed", en
   vez del viewport. Si este panel viviera anidado ahí adentro, dejaría de
   cubrir toda la pantalla y quedaría encerrado en los ~60px de la barra
   inferior (bug real, encontrado con un test de Playwright: el panel
   medía 390x60 en vez de 390x844).

   El panel YA NO usa "dark-section": debe verse claro en tema claro y
   oscuro en tema oscuro (fondo bg-white/dark:bg-background_bottom más
   abajo), así que se apoya en las variantes "dark:" normales de Tailwind
   en vez del remapeo global de "Secciones que SIEMPRE son oscuras" (ver
   src/styles/global.css) -- ese remapeo es para secciones que deben
   IGNORAR el tema, que ya no es el caso acá.

   Sin StarField de fondo (a pedido): este panel es de navegación, no una
   sección visual de contenido -- solo debe quedar el cambio de tema
   claro/oscuro, sin animación decorativa.
-->
<nav
   id="menuNav"
   class="fixed inset-0 z-[999999999] hidden flex-col bg-white p-6 pt-[calc(1.5rem_+_env(safe-area-inset-top))] pb-[calc(1.5rem_+_env(safe-area-inset-bottom))] dark:bg-background_bottom"
>
   <!-- Encabezado: marca + cerrar (misma estructura que la referencia de diseño) -->
   <div class="relative flex items-center justify-between">
      <a href="/" class="flex items-center" aria-label="Movapp - Inicio" data-home-link>
         <Image src={ImgLogo} alt="Movapp" height={100} class="block h-7 w-auto dark:hidden" />
         <Image src={ImgLogoBlanco} alt="Movapp" height={100} class="hidden h-7 w-auto dark:block" />
      </a>

      <button
         id="menuCloseButton"
         aria-label="Cerrar menú"
         class="flex h-11 w-11 items-center justify-center rounded-full text-gray-500 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/5 dark:hover:text-white"
      >
         <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
         </svg>
      </button>
   </div>

   <!--
      "justify-start" (NO "justify-center") a propósito: con las filas más
      altas de los botones, el contenido suele desbordar el alto disponible,
      y centrar un contenedor flex que desborda dispara un bug real de
      layout -- varios navegadores no implementan "safe center" para
      flexbox, así que el sobrante de ARRIBA queda fuera de rango de scroll
      (scrollTop no puede bajar de 0 para revelarlo). Con "justify-start" el
      primer botón ("Inicio") siempre queda alcanzable, desborde o no.

      "items-start" (a pedido, vuelve a la izquierda -- ya no centrado) +
      "pt-10" (en vez de "py-6") para bajar un poco el bloque completo.
   -->
   <div class="relative flex min-h-0 flex-1 flex-col items-start justify-start gap-5 overflow-y-auto pb-6 pt-10">
      {
         topLinks.map((item) => (
            <a
               href={item.href}
               class="text-lg font-bold uppercase text-gray-800 transition hover:text-text_banner dark:text-white"
            >
               {item.label}
            </a>
         ))
      }

      <!-- "Contenido": acordeón (mismo agrupamiento que el submenú de escritorio),
           igual que la sección expandible de la referencia de diseño. -->
      <button
         id="menuContentToggle"
         type="button"
         aria-expanded="false"
         aria-controls="menuContentSubmenu"
         class="flex items-center gap-3 text-left text-lg font-bold uppercase text-gray-800 transition hover:text-text_banner dark:text-white"
      >
         <span>Contenido</span>
         <span id="menuContentChevron" class="text-base transition-transform duration-200">
            <ArrowIcon size={4} />
         </span>
      </button>
      <div id="menuContentSubmenu" class="hidden flex-col items-start gap-3 pl-1">
         {
            contentLinks.map((item) => (
               <a
                  href={item.href}
                  class="text-lg font-semibold text-gray-600 transition hover:text-text_banner dark:text-white/80"
               >
                  {item.label}
               </a>
            ))
         }
      </div>
   </div>

   <!-- Carrito y tema -->
   <div class="relative flex flex-col items-start gap-4 border-t border-black/10 pt-4 dark:border-white/10">
      <a
         href="/tienda"
         id="cartButtonMobile"
         class="relative flex items-center gap-3 text-lg font-semibold text-gray-800 transition hover:text-text_banner dark:text-white"
      >
         <svg class="h-5 w-5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path
               stroke-linecap="round"
               stroke-linejoin="round"
               d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
         </svg>
         <span>Carrito</span>
         <span
            data-cart-count
            class="hidden h-5 w-5 items-center justify-center rounded-full bg-text_banner text-[11px] font-bold text-white"
         >0</span>
      </a>

      <button
         id="themeToggleMobile"
         type="button"
         class="flex items-center gap-3 text-lg font-semibold text-gray-800 transition hover:text-text_banner dark:text-white"
      >
         <svg
            class="block h-5 w-5 flex-shrink-0 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <svg
            class="hidden h-5 w-5 flex-shrink-0 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
         <span>Cambiar tema</span>
      </button>
   </div>

   <!-- Redes sociales (misma fila inferior que la referencia de diseño) -->
   <div class="relative flex items-center justify-center gap-4 border-t border-black/10 pt-4 mt-4 dark:border-white/10">
      {
         socials.map((s) => (
            <a
               href={s.href}
               target="_blank"
               rel="noopener noreferrer"
               aria-label={s.label}
               class="flex h-10 w-10 items-center justify-center transition hover:-translate-y-0.5"
            >
               <img src={s.icon} alt={s.label} class="h-10 w-10 rounded-full object-cover" />
            </a>
         ))
      }
   </div>
</nav>

<script>
   const menuButton = document.getElementById('menuButton');
   const hamburgerIcon = document.getElementById('hamburgerIcon');
   const menuButtonCloseIcon = document.getElementById('menuButtonCloseIcon');
   const menuNav = document.getElementById('menuNav');
   const contentToggle = document.getElementById('menuContentToggle');
   const contentSubmenu = document.getElementById('menuContentSubmenu');
   const contentChevron = document.getElementById('menuContentChevron');

   function openMenu() {
      menuNav.classList.remove('hidden');
      menuNav.classList.add('flex');
      hamburgerIcon.classList.add('hidden');
      menuButtonCloseIcon.classList.remove('hidden');
      menuButton.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
   }

   function closeMenu() {
      menuNav.classList.add('hidden');
      menuNav.classList.remove('flex');
      hamburgerIcon.classList.remove('hidden');
      menuButtonCloseIcon.classList.add('hidden');
      menuButton.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
      // Colapsar "Contenido" al cerrar, así el menú siempre abre desde el
      // mismo estado la próxima vez.
      contentSubmenu.classList.add('hidden');
      contentSubmenu.classList.remove('flex');
      contentToggle.setAttribute('aria-expanded', 'false');
      contentChevron.classList.remove('rotate-180');
   }

   menuButton.addEventListener('click', () => {
      if (menuNav.classList.contains('hidden')) openMenu();
      else closeMenu();
   });

   // Acordeón "Contenido": solo abre/cierra su submenú, no debe cerrar todo
   // el panel (por eso se excluye explícitamente del cierre delegado de abajo).
   contentToggle.addEventListener('click', () => {
      const isOpen = contentSubmenu.classList.toggle('flex');
      contentSubmenu.classList.toggle('hidden', !isOpen);
      contentToggle.setAttribute('aria-expanded', String(isOpen));
      contentChevron.classList.toggle('rotate-180', isOpen);
   });

   // Cerrar automáticamente al elegir cualquier opción del menú (enlaces,
   // el botón de cerrar, carrito o cambio de tema) -- delegado en vez de
   // un listener por item porque la lista puede crecer sin tener que
   // acordarse de engancharla acá. El toggle de "Contenido" se excluye a
   // propósito (ver arriba: abre/cierra su submenú, no debe cerrar el panel).
   menuNav.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      if (e.target.closest('#menuContentToggle')) return;
      if (e.target.closest('a, button')) closeMenu();
   });
</script>
