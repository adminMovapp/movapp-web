---
import MenuMobile from '@components/layout/MenuMobile.astro';
import StoreIcon from '@assets/StoreIcon.astro';
---

<nav
   class="fixed bottom-0 inset-x-0 z-[999999999] flex items-stretch justify-around bg-white/90 dark:bg-zinc-950/85 backdrop-blur-md border-t border-black/5 dark:border-white/10 pb-[env(safe-area-inset-bottom)] lg:hidden"
>
   <!-- Logo / Home -->
   <a
      href="/"
      class="flex flex-1 flex-col items-center justify-center gap-1 py-2 text-gray-500 hover:text-text_banner dark:text-white/60 dark:hover:text-white"
      aria-label="Movapp - Inicio"
      data-home-link
   >
      <img src="/img/logo_resp.webp" alt="Home" class="block h-7 w-auto dark:hidden" />
      <img src="/img/logo_resp_blanco.webp" alt="Home" class="hidden h-7 w-auto dark:block" />
   </a>

   <!-- Tienda -->
   <a
      href="/tienda"
      class="flex flex-1 flex-col items-center justify-center gap-1 py-2 text-gray-500 hover:text-text_banner dark:text-white/60 dark:hover:text-white"
      aria-label="Tienda"
   >
      <StoreIcon size={6} />
      <span class="text-[11px] font-medium">Tienda</span>
   </a>

   <!-- Menú (hamburguesa con el resto de opciones) -->
   <MenuMobile />
</nav>
