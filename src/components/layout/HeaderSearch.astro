---
// Buscador de escritorio: a diferencia del de móvil (MobileSearch.astro, que
// sigue el mismo patrón adaptado a esa navbar), acá se pidió explícitamente
// que el buscador se "despliegue" dentro de la propia navbar en vez de
// aparecer como un modal centrado. El ícono se convierte en un campo que se
// expande in-place junto al resto de íconos del header, con las sugerencias/
// resultados en un dropdown anclado justo debajo -- vive en su propio
// componente (no inline en Header.astro) por la cantidad de script/estilo
// que necesita, mismo criterio que MenuDesktopPanel/MenuMobilePanel respecto
// de Header.astro/MenuMobile.astro. El comportamiento (abrir/cerrar, buscar,
// teclado) vive en @utils/searchWidget.ts, compartido con MobileSearch.astro.
---

<div id="desktopSearch" class="relative flex items-center">
   <button
      id="desktopSearchToggle"
      type="button"
      aria-label="Buscar"
      aria-expanded="false"
      aria-controls="desktopSearchField"
      class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full icon-tone hover:bg-black/5 dark:hover:bg-white/10 transition"
   >
      <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
         <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
      </svg>
   </button>

   <div id="desktopSearchField" class="search-field flex items-center overflow-hidden">
      <div class="flex w-64 items-center gap-2 rounded-full border border-purple_mv/25 bg-white/80 px-3 py-1.5 dark:border-white/10 dark:bg-white/5">
         <input
            id="desktopSearchInput"
            type="search"
            autocomplete="off"
            placeholder="Buscar en Movapp…"
            class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none dark:text-white dark:placeholder:text-white/40"
         />
      </div>
   </div>

   <div
      id="desktopSearchDropdown"
      class="search-dropdown absolute right-0 top-full z-50 mt-2 hidden w-96 max-w-[calc(100vw-2rem)] flex-col rounded-2xl border border-purple_mv/20 bg-white p-2 shadow-2xl dark:border-white/10 dark:bg-background_bottom"
   >
      <ul id="desktopSearchResults" class="max-h-[60vh] overflow-y-auto"></ul>
      <p id="desktopSearchEmpty" class="hidden px-3 py-6 text-center text-sm text-gray-500 dark:text-white/60">
         Sin resultados. Prueba con otra palabra.
      </p>
   </div>
</div>

<style>
   /*
      El "despliegue" pedido: el campo arranca en width:0 (recortado por
      overflow-hidden) y crece a su ancho final -- NO es un modal que
      aparece/desaparece, es el mismo ícono transformándose en campo de
      texto sin salir del flujo de la navbar.
   */
   .search-field {
      width: 0;
      transition: width 220ms ease;
   }
   #desktopSearch.is-open .search-field {
      width: 16rem; /* debe coincidir con "w-64" del campo interno */
      margin-left: 0.5rem;
   }

   @media (prefers-reduced-motion: reduce) {
      .search-field {
         transition: none;
      }
   }

   .search-result-item.is-active {
      background-color: rgba(129, 73, 226, 0.1);
   }
   :global(html.dark) .search-result-item.is-active {
      background-color: rgba(255, 255, 255, 0.05);
   }
</style>

<script>
   import { initSearchWidget } from '@utils/searchWidget';

   initSearchWidget({
      root: 'desktopSearch',
      toggle: 'desktopSearchToggle',
      input: 'desktopSearchInput',
      dropdown: 'desktopSearchDropdown',
      results: 'desktopSearchResults',
      empty: 'desktopSearchEmpty',
   });
</script>
