---
import MenuMobile from '@components/MenuMobile.astro';
import ArrowIcon from '@assets/ArrowIcon.astro';
---

<header
   class="sticky top-0 z-50 w-full bg-white/90 dark:bg-zinc-950/85 backdrop-blur-md border-b border-black/5 dark:border-white/10 px-6 md:px-10 lg:px-16 py-4 flex justify-between items-center transition-colors duration-300"
>
   <!-- Logo (morado en light, blanco en dark) -->
   <a href="/" class="flex items-center" aria-label="Movapp - Inicio">
      <img src="/img/Logo.png" alt="Movapp" class="block h-9 w-auto dark:hidden md:h-10" />
      <img src="/img/Logo-Blanco.png" alt="Movapp" class="hidden h-9 w-auto dark:block md:h-10" />
   </a>

   <!-- Navegación desktop -->
   <nav class="hidden lg:flex gap-7 text-sm justify-end items-center">
      <a
         href="/"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Inicio</a
      >
      <a
         href="/nosotros"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Movapp</a
      >
      <a
         href="/el-hack"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Hack</a
      >
      <a
         href="/tienda"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Tienda</a
      >

      <div class="relative">
         <button
            id="servicesButton"
            class="flex items-center gap-1.5 font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >
            <span>Contenido</span>
            <div class="arrow-icon transition-transform duration-200">
               <ArrowIcon size={4} />
            </div>
         </button>

         <!-- Submenú -->
         <div
            id="submenu"
            class="absolute right-0 mt-4 w-48 rounded-xl border border-black/5 dark:border-white/10 bg-white dark:bg-zinc-900 backdrop-blur-md p-2 shadow-xl hidden z-50"
         >
            <a
               href="/collaborations"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Colaboraciones</a
            >
            <a
               href="/faqs"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Preguntas frecuentes</a
            >
            <a
               href="/testimonials"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Testimonios</a
            >
            <a
               href="/mind"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Mente digital</a
            >
            <a
               href="/red"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Nuestras redes</a
            >
         </div>
      </div>

      <!-- Carrito (desktop) -->
      <a
         href="/tienda"
         id="cartButton"
         aria-label="Carrito"
         class="relative ml-1 flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
         </svg>
         <span
            data-cart-count
            class="absolute -right-1 -top-1 hidden h-5 w-5 items-center justify-center rounded-full bg-text_banner text-[11px] font-bold text-white"
         >0</span>
      </a>

      <!-- Toggle de tema -->
      <button
         id="themeToggle"
         type="button"
         aria-label="Cambiar tema"
         class="ml-1 flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <!-- Sol (visible en light) -->
         <svg
            class="block h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <!-- Luna (visible en dark) -->
         <svg
            class="hidden h-5 w-5 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
      </button>


   </nav>

   <!-- Toggle + menú móvil -->
   <div class="flex items-center gap-2 lg:hidden">
      <!-- Carrito (móvil) -->
      <a
         href="/tienda"
         id="cartButtonMobile"
         aria-label="Carrito"
         class="relative flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
         </svg>
         <span
            data-cart-count
            class="absolute -right-1 -top-1 hidden h-5 w-5 items-center justify-center rounded-full bg-text_banner text-[11px] font-bold text-white"
         >0</span>
      </a>
      <button
         id="themeToggleMobileTop"
         type="button"
         aria-label="Cambiar tema"
         class="flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <svg
            class="block h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <svg
            class="hidden h-5 w-5 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
      </button>
      <MenuMobile />
   </div>
</header>

