---
import MenuMobile from '@components/MenuMobile.astro';
import ArrowIcon from '@assets/ArrowIcon.astro';
---

<header
   class="sticky top-0 z-50 w-full bg-white/90 dark:bg-zinc-950/85 backdrop-blur-md border-b border-black/5 dark:border-white/10 px-6 md:px-10 lg:px-16 py-4 flex justify-between items-center transition-colors duration-300"
>
   <!-- Logo (morado en light, blanco en dark) -->
   <a href="/" class="flex items-center" aria-label="Movapp - Inicio">
      <img src="/Logo-Morado.png" alt="Movapp" class="block h-9 w-auto dark:hidden md:h-10" />
      <img src="/Logo-Blanco.png" alt="Movapp" class="hidden h-9 w-auto dark:block md:h-10" />
   </a>

   <!-- Navegación desktop -->
   <nav class="hidden lg:flex gap-7 text-sm justify-end items-center">
      <a
         href="/"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Inicio</a
      >
      <a
         href="/nosotros"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Movapp</a
      >
      <a
         href="/el-hack"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Hack</a
      >
      <a
         href="/tienda"
         class="font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >Tienda</a
      >

      <div class="relative">
         <button
            id="servicesButton"
            class="flex items-center gap-1.5 font-medium text-gray-700/80 hover:text-gray-900 dark:text-white/70 dark:hover:text-white transition-colors"
         >
            <span>Contenido</span>
            <div class="arrow-icon transition-transform duration-200">
               <ArrowIcon size={4} />
            </div>
         </button>

         <!-- Submenú -->
         <div
            id="submenu"
            class="absolute right-0 mt-4 w-48 rounded-xl border border-black/5 dark:border-white/10 bg-white dark:bg-zinc-900 backdrop-blur-md p-2 shadow-xl hidden z-50"
         >
            <a
               href="/collaborations"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Colaboraciones</a
            >
            <a
               href="/faqs"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Preguntas frecuentes</a
            >
            <a
               href="/testimonials"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Testimonios</a
            >
            <a
               href="/mind"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Mente digital</a
            >
            <a
               href="/red"
               class="block rounded-lg px-3 py-1.5 text-sm text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/80 dark:hover:bg-white/5"
               >Nuestras redes</a
            >
         </div>
      </div>

      <!-- Toggle de tema -->
      <button
         id="themeToggle"
         type="button"
         aria-label="Cambiar tema"
         class="ml-1 flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <!-- Sol (visible en light) -->
         <svg
            class="block h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <!-- Luna (visible en dark) -->
         <svg
            class="hidden h-5 w-5 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
      </button>

      <!-- CTA -->
      <a
         href="/el-hack"
         class="inline-flex items-center gap-2 rounded-full bg-text_banner px-5 py-2.5 text-xs font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-purple-700"
      >
         Quiero El Hack
         <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
         </svg>
      </a>
   </nav>

   <!-- Toggle + menú móvil -->
   <div class="flex items-center gap-2 lg:hidden">
      <button
         id="themeToggleMobileTop"
         type="button"
         aria-label="Cambiar tema"
         class="flex h-9 w-9 items-center justify-center rounded-full text-gray-700 hover:bg-black/5 hover:text-text_banner dark:text-white/70 dark:hover:bg-white/10 transition"
      >
         <svg
            class="block h-5 w-5 dark:hidden"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <circle cx="12" cy="12" r="4"></circle>
            <path
               d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
            ></path>
         </svg>
         <svg
            class="hidden h-5 w-5 dark:block"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
         >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
         </svg>
      </button>
      <MenuMobile />
   </div>
</header>

<!-- <script>
   const servicesButton = document.getElementById('servicesButton');
   const submenu = document.getElementById('submenu');
   const arrowIcon = document.getElementById('arrowIcon');

   servicesButton.addEventListener('click', () => {
      submenu.classList.toggle('hidden');
      arrowIcon.classList.toggle('rotate-180');
   });
</script> -->

<script is:inline>
   document.addEventListener('click', function (e) {
      if (e.target.closest('#servicesButton')) {
         const submenu = document.getElementById('submenu');
         const arrow = document.querySelector('.arrow-icon');

         if (submenu) submenu.classList.toggle('hidden');
         if (arrow) arrow.classList.toggle('rotate-180');
      }

      // Toggle de tema (desktop y móvil comparten este handler)
      if (
         e.target.closest('#themeToggle') ||
         e.target.closest('#themeToggleMobile') ||
         e.target.closest('#themeToggleMobileTop')
      ) {
         const isDark = document.documentElement.classList.toggle('dark');
         try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
         } catch (err) {}
      }
   });
</script>
