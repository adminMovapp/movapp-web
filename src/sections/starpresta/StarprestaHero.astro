---
// H1 (único H1 de la página). Plantilla "app reportada" -- formato "X: [la
// táctica específica] y qué puedes hacer", mismo criterio que
// MexicashHero.astro/FortaprestaHero.astro.
// Hero de 2 columnas (2026-09-02, a pedido) -- ver AppHero.astro para el
// mecanismo compartido por las 8 apps.
import AppHero from '@components/decorative/AppHero.astro';
---

<AppHero
   id="starpresta"
   breadcrumbLabel="StarPresta"
   h1="StarPresta: el grupo de WhatsApp con tus contactos y qué puedes hacer"
   paragraph="Si StarPresta ya metió a tu familia y a tus compañeros de trabajo en un grupo de WhatsApp para exhibirte, sabemos exactamente lo que estás sintiendo. También sabemos que se puede parar. Aquí está lo que tenemos documentado sobre esta aplicación, por qué está en nuestra lista de apps reportadas y qué puedes hacer hoy mismo."
   whatsappMessage="¡Hola! Quiero orientación sobre StarPresta."
/>
