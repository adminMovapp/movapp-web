---
// Mismo patrón que el resto de la serie "app reportada", incluido el aviso
// de salida (data-external-warn + <ExternalLinkModal />).
import ExternalLinkModal from '@components/ui/ExternalLinkModal.astro';

const REPORT_CHANNELS = [
   {
      title: 'Policía Cibernética',
      text: 'Amenazas, extorsión, suplantación.',
      buttonLabel: 'Contactar',
      href: 'https://www.ssc.cdmx.gob.mx/organizacion-policial/subsecretaria-de-inteligencia-e-investigacion-policial/policia-cibernetica',
   },
   { title: 'CONDUSEF', text: 'Queja contra institución identificada.', buttonLabel: 'Presentar queja', href: 'https://www.condusef.gob.mx/' },
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <!--
      Título distinto en móvil vs. escritorio (2026-08-28, mismo caso que
      MexicashDondeDenunciar.astro): el wireframe de móviles trae el título
      recortado ("Dónde denunciar") -- se aplica SOLO en móvil, el de
      escritorio no se toca.
   -->
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      <span class="md:hidden">Dónde denunciar</span>
      <span class="hidden md:inline">Dónde denunciar o reportar problemas</span>
   </h2>

   <ul class="mt-8 flex flex-col gap-4">
      {
         REPORT_CHANNELS.map((channel) => (
            <li class="flex flex-col items-start justify-between gap-4 rounded-2xl bg-gray-100 p-6 dark:bg-white/5 sm:flex-row sm:items-center">
               <div>
                  <h3 class="font-bold text-text_banner">{channel.title}</h3>
                  <p class="mt-1 text-sm italic text-gray-600 dark:text-white/70">{channel.text}</p>
               </div>
               <a
                  href={channel.href}
                  data-external-warn
                  data-external-label={channel.title}
                  class="inline-flex flex-shrink-0 items-center justify-center rounded-full bg-purple_mv px-5 py-2.5 text-sm font-bold text-white transition hover:bg-purple_mv/85"
               >
                  {channel.buttonLabel}
               </a>
            </li>
         ))
      }
   </ul>

   <ExternalLinkModal />
</section>
