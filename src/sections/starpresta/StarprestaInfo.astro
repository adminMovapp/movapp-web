---
// Tarjetas sin título (mismo criterio que Mexicash/FortaprestaInfo.astro).
// El tercer recuadro que el wireframe de escritorio traía vacío se completó
// en el wireframe de móviles (2026-08-28) -- contenido aditivo, se agrega
// igual en ambos breakpoints (mismo caso que Fortaprest/MexicashInfo.astro).
const INFO_ITEMS = [
   'Sus montos, plazos y tasas exactas no aparecen publicados de forma clara y verificable.',
   'No tenemos confirmado quién opera la aplicación ni cuál es su sitio oficial.',
   'StarPresta aparece con permiso ante CONDUSEF, pero no está regulada por la CNBV.',
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Información disponible sobre StarPresta
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
         INFO_ITEMS.map((text) => (
            <li class="flex items-center justify-center rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
               <p class="text-sm text-gray-700 dark:text-white/80">{text}</p>
            </li>
         ))
      }
   </ul>
</section>
