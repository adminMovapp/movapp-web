---
const steps = [
   {
      title: 'Habla con un asesor real.',
      text: 'Nos escribes por WhatsApp y te escuchamos. Revisamos tu caso y te explicamos las opciones, sin juzgarte.',
   },
   {
      title: 'El asesor te guía para activar El Hack.',
      text: 'Configuras las protecciones disponibles en tu teléfono para reducir las llamadas y los mensajes de acoso y resguardar tus contactos y tu galería, según tu dispositivo.',
   },
   {
      title: 'Recibe seguimiento.',
      text: 'Damos seguimiento para verificar si el acoso baja o cambia, y ajustar el proceso. Si lo necesitas, cuentas con apoyo emocional en el camino.',
   },
];

const cardHover =
   'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';

import ButtonContact from '@components/ui/ButtonContact.astro';
---

<section class="relative mx-auto my-16 w-full max-w-6xl px-4" data-aos="fade-up">
   <div class="mb-10 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">La solución</span>
      <h2 class="mt-1 text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">Cómo funciona El Hack</h2>
      <p class="mx-auto mt-3 max-w-xl text-gray-600 dark:text-white/70">
         Un proceso acompañado, en tres pasos y sin trámites complicados.
      </p>
   </div>

   <!-- Stepper: línea de tiempo con conectores -->
   <div id="howItWorksGrid" class="reveal-stagger relative grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-6">
      <!-- Línea conectora horizontal (desktop) -->
      <div
         class="pointer-events-none absolute left-0 right-0 top-7 hidden h-px bg-gradient-to-r from-transparent via-purple_mv/50 to-transparent md:block"
         aria-hidden="true"
      >
      </div>

      {
         steps.map((s, i) => (
            <div class="group relative flex flex-col items-center text-center">
               <div class="relative z-10 mb-5 flex h-14 w-14 items-center justify-center rounded-full border-2 border-purple_mv bg-gray-50 text-xl font-bold text-text_banner shadow-[0_0_25px_rgba(129,73,226,0.35)] transition-all duration-300 group-hover:scale-110 group-hover:bg-text_banner group-hover:text-white dark:bg-[#050505]">
                  {i + 1}
               </div>
               <div class={`w-full flex-1 rounded-2xl p-6 shadow-lg ${cardHover}`}>
                  <h3 class="mb-2 text-lg font-bold text-gray-900 dark:text-white">{s.title}</h3>
                  <p class="text-sm text-gray-700 dark:text-white/90">{s.text}</p>
               </div>
            </div>
         ))
      }
   </div>

   <div class="mt-10 flex flex-col items-center gap-3">
      <ButtonContact label="Hablar con un asesor por WhatsApp" size="lg" />
      <a href="/el-hack/" class="text-sm text-text_banner underline-offset-4 hover:underline">
         Conocer El Hack a detalle
      </a>
   </div>
</section>

<script>
   // Reveal escalonado de los pasos (también en móvil, AOS está off <768px)
   const grid = document.getElementById('howItWorksGrid');
   if (grid) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
         grid.classList.add('in-view');
      } else {
         const io = new IntersectionObserver(
            (entries) => {
               entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                     entry.target.classList.add('in-view');
                     io.unobserve(entry.target);
                  }
               });
            },
            { threshold: 0.15 },
         );
         io.observe(grid);
      }
   }
</script>
