---
const steps = [
   {
      title: 'Habla con un asesor',
      text: 'Nos escribes por WhatsApp y te escuchamos. Te explicamos qué hacer, sin juzgarte.',
   },
   {
      title: 'Activa El Hack',
      text: 'Instalas la app y bloqueas de inmediato las llamadas y mensajes de acoso, y proteges tus contactos y tu galería.',
   },
   {
      title: 'Recuperas tu vida',
      text: 'Vuelves a tener paz. Y si lo necesitas, cuentas con apoyo emocional en el camino.',
   },
];

import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <StarField id="how-it-works" ambientCount={40} />

   <div class="mb-12 text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">¿Cómo funciona El Hack?</h2>
   </div>

   <!--
      Línea de tiempo vertical (misma estructura que NosotrosTimeline.astro):
      línea conectora centrada, con un punto por paso que alterna de lado en
      escritorio y queda en una sola columna en móvil. La página SIEMPRE
      se mueve con normalidad al hacer scroll -- nada queda "pineado"/fijo
      congelando el scroll (se probó esa versión y se sentía mal, la
      pantalla parecía trabada).

      En vez de eso, cada paso tiene su propio fundido de entrada Y SALIDA:
      a diferencia del sistema [data-aos] global (que revela una vez y se
      queda visible para siempre), acá un IntersectionObserver local marca
      "hiw-active" solo mientras el paso cruza la franja central de la
      pantalla (rootMargin negativo arriba/abajo) y se la quita en cuanto
      sale de esa franja, EN CUALQUIER DIRECCIÓN. El resultado: mientras
      scrolleas a ritmo normal, el paso anterior se desvanece justo cuando
      el siguiente empieza a aparecer, sin detener el scroll en ningún
      momento.
   -->
   <div class="relative" data-hiw-section>
      <div
         class="absolute bottom-2 left-[15px] top-2 w-px bg-gradient-to-b from-purple_mv via-purple_mv/40 to-transparent md:left-1/2"
         aria-hidden="true"
      >
      </div>

      {
         steps.map((s, i) => (
            <div
               class:list={[
                  'hiw-step relative mb-10 flex items-start gap-6 last:mb-0 md:mb-12 md:w-1/2',
                  i % 2 === 0
                     ? 'md:ml-0 md:flex-row-reverse md:pr-12 md:text-right'
                     : 'md:ml-auto md:pl-12 md:flex-row',
               ]}
               data-hiw-step
            >
               {/* Punto en la línea */}
               <span
                  class:list={[
                     'absolute left-0 top-1 z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border-2 border-purple_mv bg-gray-50 dark:bg-[#050505]',
                     i % 2 === 0 ? 'md:-right-4 md:left-auto' : 'md:-left-4',
                  ]}
               >
                  <span class="h-2.5 w-2.5 rounded-full bg-text_banner" />
               </span>

               {/* Contenido */}
               <div class="ml-12 flex-1 md:ml-0">
                  <h3 class="mb-2 text-lg font-bold text-text_banner">{s.title}</h3>
                  <p class="text-sm text-gray-700 dark:text-white/90">{s.text}</p>
               </div>
            </div>
         ))
      }
   </div>

   <div class="mt-10 flex flex-col items-center gap-3">
      <div class="float-anim" style="--float-dur: 5.8s; --float-delay: 0s;">
         <ButtonContact id="whatsapp-home-servicios" label="Hablar con un asesor" />
      </div>
   </div>
</section>

<style>
   .hiw-step {
      opacity: 0;
      transform: translateY(28px);
      transition:
         opacity 0.6s ease,
         transform 0.6s ease;
   }
   .hiw-step.hiw-active {
      opacity: 1;
      transform: translateY(0);
   }
</style>

<script>
   function initHowItWorks() {
      const section = document.querySelector('[data-hiw-section]');
      if (!section || section.getAttribute('data-hiw-init') === 'true') return;
      section.setAttribute('data-hiw-init', 'true');

      const stepEls = Array.from(section.querySelectorAll('[data-hiw-step]'));
      if (!stepEls.length) return;

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
         stepEls.forEach((el) => el.classList.add('hiw-active'));
         return;
      }

      // Franja angosta centrada en la pantalla (10% del alto del viewport,
      // -45% arriba y abajo) en vez de una franja ancha o de una línea
      // exacta:
      // - Una franja ancha (ej. -35%/-35% = 30% del viewport) es más ancha
      //   que la separación entre pasos consecutivos, así que 2 o 3 pasos
      //   caben adentro al mismo tiempo y se ven activos todos juntos, en
      //   vez de ir mostrando uno por uno.
      // - Una franja de 0px exacta (-50%/-50%, viewport colapsado a una
      //   sola línea) tiene área de intersección SIEMPRE igual a 0 con
      //   cualquier elemento -- por definición un rectángulo de alto 0 no
      //   tiene área -- así que el navegador nunca la reporta como
      //   intersección real; confirmado con una prueba: con -50%/-50%
      //   "isIntersecting" prácticamente nunca se activaba.
      // Una franja angosta pero con alto real evita ambos problemas.
      const io = new IntersectionObserver(
         (entries) => {
            entries.forEach((entry) => {
               entry.target.classList.toggle('hiw-active', entry.isIntersecting);
            });
         },
         { threshold: 0, rootMargin: '-45% 0px -45% 0px' },
      );
      stepEls.forEach((el) => io.observe(el));
   }

   initHowItWorks();
   document.addEventListener('astro:page-load', initHowItWorks);
</script>
