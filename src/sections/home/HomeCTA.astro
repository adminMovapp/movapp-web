---
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-8 w-full max-w-5xl px-4" data-aos="fade-up">
   <div
      class="float-anim relative overflow-hidden rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-10 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-14"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <StarField id="cta" ambientCount={25} fullBleed={false} />

      <!-- Resplandor decorativo -->
      <div class="pointer-events-none absolute -right-16 -top-8 h-56 w-56 rounded-full bg-purple_mv/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-purple_mv/20 blur-3xl"></div>

      <div class="relative z-10 grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
         <!-- Mockup de la app en la App Store -->
         <div class="flex aspect-[4/3] items-center justify-center rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5 md:aspect-square">
            <img
               src="/img/migracion/Mockup-celular-movapp-1.webp"
               alt="Vista previa de Movapp en la App Store"
               class="h-full w-full object-contain p-4"
               loading="lazy"
            />
         </div>

         <div class="text-center md:text-left">
            <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Movapp</span>
            <h2 class="mt-1 text-2xl font-bold leading-tight text-gray-900 dark:text-white md:text-3xl">Da el primer paso hoy</h2>
            <p class="mx-auto mt-3 max-w-xl text-sm text-gray-600 dark:text-white/80 md:mx-0 md:text-base">
               No tienes que enfrentar esto solo. Escríbenos por WhatsApp y recupera tu tranquilidad.
            </p>

            <div class="float-anim mt-6 flex justify-center md:justify-start" style="--float-dur: 5.8s; --float-delay: 0.3s;">
               <ButtonContact label="Hablar con un asesor por WhatsApp" size="lg" />
            </div>

            <div class="mt-6 flex flex-col items-center gap-3 md:items-start">
               <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
                  <img src="/img/migracion/play-store-v2.webp" alt="Google Play" class="h-12 w-auto" />
               </a>
               <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
                  <img src="/img/migracion/app-store-v2.webp" alt="App Store" class="h-12 w-auto" />
               </a>
            </div>
         </div>
      </div>
   </div>
</section>
