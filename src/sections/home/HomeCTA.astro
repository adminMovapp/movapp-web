---
import ButtonContact from '@/components/ui/ButtonContact.astro';
---

<section class="relative mx-auto my-8 w-full max-w-5xl px-4" data-aos="fade-up">
   <div class="glass-card relative overflow-hidden rounded-3xl border border-purple_mv/30 p-10 shadow-[0_0_40px_rgba(129,73,226,0.15)] md:p-14">
      <!-- Resplandor decorativo -->
      <div class="pointer-events-none absolute -right-16 -top-8 h-56 w-56 rounded-full bg-purple_mv/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-purple_mv/20 blur-3xl"></div>

      <div class="relative z-10 flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left">
         <div class="max-w-xl">
            <span class="mb-3 inline-flex items-center gap-2 rounded-full border border-purple_mv/30 bg-purple_mv/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-text_banner">
               Asesoría gratuita
            </span>
            <h2 class="text-2xl font-bold leading-tight text-gray-900 dark:text-white md:text-3xl">
               ¿Quieres recuperar tu paz <span class="text-text_banner">hoy</span>?
            </h2>
            <p class="mt-3 text-sm text-gray-600 dark:text-white/80 md:text-base">
               Habla con un asesor que pasó por lo mismo. Sin compromiso y de forma confidencial.
            </p>
         </div>

         <div class="flex-shrink-0">
            <ButtonContact />
         </div>
      </div>
   </div>
</section>
