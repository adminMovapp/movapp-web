---
import { Image } from 'astro:assets';
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
import ImgPlayStore from '@assets/play-store-v2.webp';
import ImgAppStore from '@assets/app-store-v2.webp';
// Mismo logo que Header.astro (navbar de escritorio) -- a pedido, se repite
// acá debajo del título, solo en escritorio (ver ".cta-logo" más abajo).
import ImgLogo from '@assets/Logo.png';
import ImgLogoBlanco from '@assets/Logo-Blanco.png';
import ImgMockup from '@assets/Mockup-celular-movapp-1.webp';
---

<section class="relative mx-auto my-section w-full max-w-5xl px-4" data-aos="fade-up">
   <div
      class="float-anim relative overflow-hidden rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-10 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-14"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <StarField id="cta" ambientCount={25} fullBleed={false} />

      <!-- Resplandor decorativo -->
      <div class="pointer-events-none absolute -right-16 -top-8 h-56 w-56 rounded-full bg-purple_mv/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-purple_mv/20 blur-3xl"></div>

      <!--
         Orden móvil (ver wireframe de estructura móvil): título -> imagen ->
         texto -> resto (botón + badges). En escritorio vuelve al orden
         original (imagen a la izquierda, todo el texto apilado a la
         derecha) -- se logra con grid-template-areas (ver <style> más abajo)
         en vez de un simple "order" de Tailwind, porque el título ya no
         puede estar anidado dentro del mismo div que el párrafo/botón/badges
         (si no, no hay forma de intercalar la imagen entre título y párrafo
         en móvil) y grid-template-areas es lo que permite que, aun con el
         título como celda de grid independiente, en escritorio se siga
         viendo apilado junto al párrafo/resto en la misma columna.
      -->
      <div class="cta-grid relative z-10 gap-8 md:gap-12">
         <!-- Logo de Movapp (mismo que la navbar de escritorio) -- solo en
              escritorio, a pedido; en móvil no se agrega. Va antes que el
              título (a pedido: logo primero, luego "Da el primer paso"). -->
         <div class="cta-logo hidden md:block">
            <Image src={ImgLogo} alt="Movapp" height={100} class="cta-logo-img block h-10 w-auto dark:hidden" />
            <Image src={ImgLogoBlanco} alt="Movapp" height={100} class="cta-logo-img hidden h-10 w-auto dark:block" />
         </div>

         <!-- md:-mt-6 (a pedido): el "gap-12" del grid de escritorio dejaba
              demasiado aire entre el logo y el título -- este margen
              negativo achica solo esa separación puntual, sin tocar el
              "gap" general (que sigue rigiendo la columna de la imagen y el
              espacio hacia el botón/badges de más abajo). -->
         <h2 class="cta-title text-center text-2xl font-bold uppercase leading-tight bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv md:-mt-6 md:text-left md:text-3xl">
            Da el primer paso hoy
         </h2>

         <!-- Mockup de la app en la App Store -->
         <div class="cta-image flex aspect-[4/3] items-center justify-center rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5 md:aspect-square">
            <Image
               src={ImgMockup}
               alt="Vista previa de Movapp en la App Store"
               width={450}
               class="h-full w-full object-contain p-4"
               loading="lazy"
            />
         </div>

         <!-- md:-mt-6: mismo criterio que el título de arriba, para achicar
              el aire entre el título y este párrafo. -->
         <p class="cta-text mx-auto max-w-xl text-center text-sm text-gray-600 dark:text-white/80 md:mx-0 md:-mt-6 md:text-left md:text-base">
            No tienes que enfrentar esto solo. Escríbenos por WhatsApp y recupera tu tranquilidad.
         </p>

         <div class="cta-rest text-center md:text-left">
            <!--
               -mx-6 en móvil: el botón es w-full (fullWidth), así que su
               ancho real depende de cuánto le sobre a esta columna -- y el
               p-10 de la card (40px por lado) le deja poco margen al texto
               del botón. Este margen negativo solo ensancha la FILA del
               botón (no toca el padding del resto de la card: título,
               párrafo, mockup), dándole ~24px más de ancho por lado sin
               afectar el resto del diseño. En md+ se anula (mx-0) porque
               ahí el botón vuelve a su ancho natural (no es fullWidth).
            -->
            <div
               class="float-anim -mx-6 flex justify-center md:mx-0 md:justify-start"
               style="--float-dur: 5.8s; --float-delay: 0.3s;"
            >
               <ButtonContact label="Hablar con un asesor" fullWidth />
            </div>

            <div class="mt-6 flex flex-col items-center gap-3 md:items-start">
               <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
                  <Image src={ImgPlayStore} alt="Google Play" height={96} class="store-badge h-12 w-auto" />
               </a>
               <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
                  <Image src={ImgAppStore} alt="App Store" height={96} class="store-badge h-12 w-auto" />
               </a>
            </div>
         </div>
      </div>
   </div>
</section>

<style>
   /*
      Tamaño real del badge fijado acá (no solo con "h-12" de Tailwind) --
      este <style> con scope de componente se aplica siempre, con o sin JS.
      Mientras Tailwind no ha cargado, el <img> no tiene ninguna regla de
      tamaño y se pinta a su dimensión real (height={96}, pensado para
      retina) -- más grande que los 48px finales de "h-12", lo que puede
      generar un salto de layout (CLS) al cargar Tailwind. Debe coincidir
      con "h-12" si cambia.
   */
   .store-badge {
      height: 3rem;
      width: auto;
   }

   /*
      Tamaño real del logo fijado acá (no solo con "h-10" de Tailwind) --
      este <style> con scope de componente se aplica siempre, con o sin JS.
      Mientras Tailwind no ha cargado, el <img> no tiene ninguna regla de
      tamaño y se pinta a su dimensión real (height={100}, pensado para
      retina) -- más grande que los 40px finales de "h-10", lo que puede
      generar un salto de layout (CLS) al cargar Tailwind. Debe coincidir
      con "h-10" si cambia.
   */
   .cta-logo-img {
      height: 2.5rem;
      width: auto;
   }

   .cta-grid {
      display: grid;
      grid-template-columns: 1fr;
      grid-template-areas: 'title' 'image' 'text' 'rest';
   }
   .cta-title {
      grid-area: title;
   }
   .cta-image {
      grid-area: image;
   }
   .cta-text {
      grid-area: text;
   }
   .cta-rest {
      grid-area: rest;
   }

   /* Escritorio: layout original (imagen a la izquierda, todo el texto
      apilado a la derecha) -- la imagen ocupa las 4 filas de su columna
      ahora que se sumó "logo" arriba del título (a pedido, solo visible en
      escritorio, ver "cta-logo" en el markup). */
   @media (min-width: 768px) {
      .cta-grid {
         grid-template-columns: 1fr 1fr;
         grid-template-areas: 'image logo' 'image title' 'image text' 'image rest';
         align-items: center;
      }
      .cta-logo {
         grid-area: logo;
      }
   }
</style>
