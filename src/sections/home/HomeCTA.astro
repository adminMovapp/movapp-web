---
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-8 w-full max-w-5xl px-4" data-aos="fade-up">
   <div
      class="float-anim glass-card relative overflow-hidden rounded-3xl border border-purple_mv/30 p-10 text-center shadow-[0_0_40px_rgba(129,73,226,0.15)] md:p-14"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <StarField id="cta" ambientCount={25} fullBleed={false} />

      <!-- Resplandor decorativo -->
      <div class="pointer-events-none absolute -right-16 -top-8 h-56 w-56 rounded-full bg-purple_mv/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-16 h-56 w-56 rounded-full bg-purple_mv/20 blur-3xl"></div>

      <div class="relative z-10 flex flex-col items-center gap-6">
         <h2 class="text-2xl font-bold leading-tight text-gray-900 dark:text-white md:text-3xl">Da el primer paso hoy</h2>
         <p class="max-w-xl text-sm text-gray-600 dark:text-white/80 md:text-base">
            No tienes que enfrentar esto solo. Escríbenos por WhatsApp y recupera tu tranquilidad.
         </p>

         <div class="float-anim" style="--float-dur: 5.8s; --float-delay: 0.3s;">
            <ButtonContact label="Hablar con un asesor gratis por WhatsApp" size="lg" />
         </div>

         <div class="mt-2 flex flex-col items-center gap-2">
            <span class="text-xs text-gray-500 dark:text-white/50">Descargar la app de Movapp</span>
            <div class="flex items-center gap-3">
               <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
                  <img src="/img/migracion/play-store-v2.webp" alt="Google Play" class="h-9 w-auto" />
               </a>
               <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
                  <img src="/img/migracion/app-store-v2.webp" alt="App Store" class="h-9 w-auto" />
               </a>
            </div>
         </div>
      </div>
   </div>
</section>
