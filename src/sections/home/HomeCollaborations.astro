---
// Extraído de HomeTrust.astro (a pedido: la cinta de colaboraciones pasó a
// vivir después de "Preguntas frecuentes" en vez de pegada a "¿Por qué
// confiar en Movapp?"). Mismo marcado/estilos que antes, solo movido a su
// propia sección.
import { Image } from 'astro:assets';
import ImgCenepred from '@assets/cenepred.webp';
import ImgMvsNoticias from '@assets/mvs-noticias.webp';
import ImgWerevertumorro from '@assets/werevertumorro.webp';
import ImgOye from '@assets/oye.webp';

const collaborations = [
   { src: ImgCenepred, alt: 'Cenepred' },
   { src: ImgMvsNoticias, alt: 'MVS Noticias' },
   { src: ImgWerevertumorro, alt: 'Werevertumorro' },
   { src: ImgOye, alt: 'Oye' },
];
---

<section class="relative mx-auto my-section w-full max-w-6xl px-4" data-aos="fade-up">
   <h2 class="mb-8 text-center text-lg font-bold uppercase text-text_banner">Algunas de nuestras colaboraciones</h2>
   <div class="marquee relative w-full overflow-hidden py-6 md:py-8">
      <!-- Sin card/marco: la cinta va directo sobre el fondo de la página,
           así que el fade de los bordes usa ese mismo fondo real para no
           dejar una costura visible. -->
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-gray-50 to-transparent dark:from-[#050505]"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-gray-50 to-transparent dark:from-[#050505]"></div>

      <div class="marquee-track flex w-max items-center">
         {
            /* 4 copias (no 2): con solo 2, una vez que la copia visible termina de
               desplazarse, el contenedor (más ancho que una sola copia de logos) se
               queda sin contenido a la derecha hasta que la siguiente copia entra —
               eso se veía como que los logos "desaparecían" unos segundos. Con 4
               copias siempre hay suficiente contenido cubriendo el contenedor. */
            Array.from({ length: 4 }).map((_, groupIndex) => (
               <div class="flex items-center gap-8 pr-8" aria-hidden={groupIndex > 0 ? 'true' : undefined}>
                  {
                     collaborations.map((logo) => (
                        <div class="flex h-20 flex-shrink-0 items-center justify-center rounded-xl bg-white/90 px-8 py-4 shadow-md">
                           <Image
                              src={logo.src}
                              height={128}
                              alt={logo.alt}
                              class="collab-logo h-12 w-auto object-contain grayscale opacity-60 transition duration-300 hover:grayscale-0 hover:opacity-100 md:h-16"
                           />
                        </div>
                     ))
                  }
               </div>
            ))
         }
      </div>
   </div>
</section>

<style>
   /*
      Tamaño real fijado acá (no solo "h-12"/"md:h-16" de Tailwind) -- mismo
      bug de CLS que el resto de los logos del sitio (ver skill Rendimiento):
      el height={128} del <Image> es para retina, más grande que el tamaño
      final en pantalla, así que sin esto el logo se pinta grande mientras
      Tailwind no ha cargado y se encoge de golpe al cargar.
   */
   .collab-logo {
      height: 3rem; /* = h-12 */
      width: auto;
   }
   @media (min-width: 768px) {
      .collab-logo {
         height: 4rem; /* = md:h-16 */
      }
   }
</style>
