---
const cardHover = 'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';
---

<section class="relative mx-auto my-16 w-full max-w-6xl px-4" data-aos="fade-up">
   <div class={`flex flex-col items-center gap-8 md:flex-row rounded-2xl p-8 shadow-lg ${cardHover}`}>
      <!-- Mockup -->
      <div class="flex-1 flex justify-center">
         <img
            src="/img/migracion/Mockup-celular-movapp-1.webp"
            alt="App Movapp"
            class="max-h-96 w-auto drop-shadow-[0_0_40px_rgba(129,73,226,0.35)]"
         />
      </div>

      <!-- Texto + badges -->
      <div class="flex-1 text-center md:text-left">
         <img src="/img/Logo.png" alt="Movapp" class="mx-auto md:mx-0 mb-4 block h-12 w-auto dark:hidden" />
         <img src="/img/Logo-Blanco.png" alt="Movapp" class="mx-auto md:mx-0 mb-4 hidden h-12 w-auto dark:block" />
         <h2 class="mb-5 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">Descarga nuestra app</h2>
         <p class="mb-6 text-sm md:text-base text-gray-700 dark:text-white/90">
            Únete a los millones que ya disfrutan de paz. Descarga la app de Movapp y aplica El Hack hoy.
         </p>
         <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
            <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
               <img src="/img/migracion/play-store-v2.webp" alt="Google Play" class="h-12 w-auto" />
            </a>
            <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
               <img src="/img/migracion/app-store-v2.webp" alt="App Store" class="h-12 w-auto" />
            </a>
         </div>
      </div>
   </div>
</section>
