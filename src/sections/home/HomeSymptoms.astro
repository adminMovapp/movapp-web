---
import { Image } from 'astro:assets';
import ImgTelefono from '@assets/telefono.webp';
import ImgMensajes from '@assets/mensajes.webp';
import ImgContacto from '@assets/contacto.webp';
import ImgAngustia from '@assets/angustia.webp';
import StarField from '@components/decorative/StarField.astro';

// "titleDesktop" es solo para escritorio (a pedido) -- en móvil se deja
// "title" tal cual, sin cambios.
const symptoms = [
   {
      title: 'Llamadas de acoso',
      titleDesktop: 'Llamadas de acoso sin parar',
      text: 'Te llaman a toda hora, incluso desde números distintos.',
      icon: ImgTelefono,
   },
   {
      title: 'Mensajes amenazantes',
      titleDesktop: 'Mensajes que amenazan',
      text: 'Recibes textos con insultos o amenazas para presionarte a pagar.',
      icon: ImgMensajes,
   },
   {
      title: 'Contactos en riesgo',
      titleDesktop: 'Contactan a tu familia y amigos',
      text: 'Usan tu lista de contactos para avergonzarte y presionarte.',
      icon: ImgContacto,
   },
   {
      title: 'Angustia',
      titleDesktop: 'Angustia que no te deja vivir',
      text: 'El miedo y la ansiedad se apoderan de tu día a día.',
      icon: ImgAngustia,
   },
];
---

<section class="relative mx-auto my-section w-full max-w-5xl px-4" data-aos="fade-up">
   <StarField id="symptoms" ambientCount={40} />

   <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">¿Te está pasando esto?</h2>
      <p class="mt-3 text-gray-600 dark:text-white/70">
         Si reconoces alguna de estas situaciones, no estás solo. Tenemos una solución.
      </p>
   </div>

   <ul class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">
      {
         symptoms.map((s, i) => (
            <li
               class="float-anim relative flex flex-col items-center overflow-hidden rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-6"
               style={`--float-dur: ${5.6 + i * 0.3}s; --float-delay: ${i * 0.2}s;`}
            >
               <!-- Ícono y título ligeramente más grandes en móvil (a pedido):
                    compensan el espacio que deja libre quitar la descripción,
                    que ahí solo se muestra desde escritorio. -->
               <div class="relative mb-4 h-16 w-16 md:h-14 md:w-14">
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-purple_mv to-purple_mv/60 p-2.5 shadow-[0_0_16px_rgba(129,73,226,0.3)] md:h-14 md:w-14">
                     {i === 0 ? (
                        // Elemento LCP de esta página (primera card, "arriba del
                        // pliegue"): sin "loading=lazy" (default de <Image>) y con
                        // fetchpriority alto, para que el navegador lo descubra y
                        // priorice desde el HTML inicial en vez de demorar su
                        // descarga -- Lighthouse lo marcaba como el mayor tramo del
                        // LCP ("retraso en la carga de recursos", 250ms).
                        <Image src={s.icon} width={150} alt="" loading="eager" fetchpriority="high" class="h-full w-full object-contain" />
                     ) : (
                        <Image src={s.icon} width={150} alt="" class="h-full w-full object-contain" />
                     )}
                  </div>
               </div>
               <!-- Morado en escritorio (a pedido): todo texto en negritas va
                    en color morado (text_banner) -- mismo criterio que el H1
                    de HomeHero.astro. "md:dark:text-text_banner" además de
                    "md:text-text_banner": el tema por defecto es oscuro
                    (<html class="dark">), y sin la variante compuesta
                    "dark:text-white" le seguía ganando al morado en
                    escritorio (confirmado con Playwright). -->
               <h3 class="relative text-lg font-bold text-gray-900 dark:text-white md:text-base md:text-text_banner md:dark:text-text_banner">
                  <span class="md:hidden">{s.title}</span>
                  <span class="hidden md:inline">{s.titleDesktop || s.title}</span>
               </h3>
               <p class="relative mt-1 hidden text-sm text-gray-600 dark:text-white/70 md:block">{s.text}</p>
            </li>
         ))
      }
   </ul>
</section>
