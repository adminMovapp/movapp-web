---
import StarField from '@components/decorative/StarField.astro';

// Selección editorial de guías evergreen (no las últimas publicadas), para
// estabilizar el enlazado interno estratégico del home. Pendiente: sustituir
// por los 3 artículos reales del blog cuando existan.
const guides = [
   { title: '[Título real del artículo 1]', href: '/blog/' },
   { title: '[Título real del artículo 2]', href: '/blog/' },
   { title: '[Título real del artículo 3]', href: '/blog/' },
];
---

<section class="relative mx-auto my-16 w-full max-w-4xl px-4" data-aos="fade-up">
   <StarField id="resources" ambientCount={35} />

   <div class="text-center">
      <h2 class="text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">Aprende a defenderte</h2>
      <p class="mt-3 text-gray-600 dark:text-white/70">
         Guías y artículos para conocer tus derechos y protegerte de las apps montadeudas.
      </p>
   </div>

   <div
      class="float-anim mx-auto mt-8 max-w-xl overflow-hidden rounded-2xl border border-purple_mv/25 bg-gradient-to-br from-purple_mv/[0.07] to-transparent shadow-[0_0_20px_rgba(129,73,226,0.1)] dark:border-white/10 dark:from-purple_mv/[0.14] dark:to-black/20"
      style="--float-dur: 6s; --float-delay: 0s;"
   >
      {
         guides.map((g, i) => (
            <a
               href={g.href}
               class:list={[
                  'group flex items-center justify-between gap-4 px-5 py-4 transition-colors hover:bg-purple_mv/10 dark:hover:bg-purple_mv/[0.12]',
                  i > 0 ? 'border-t border-purple_mv/15 dark:border-white/10' : '',
               ]}
            >
               <span class="flex items-center gap-4">
                  <span class="bg-gradient-to-br from-purple_mv to-purple_mv/50 bg-clip-text text-2xl font-extrabold tabular-nums text-transparent">
                     {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-sm font-semibold text-gray-800 transition-colors group-hover:text-text_banner dark:text-white/80">
                     {g.title}
                  </span>
               </span>
               <span class="flex-shrink-0 text-text_banner transition-transform duration-300 group-hover:translate-x-1">
                  →
               </span>
            </a>
         ))
      }
   </div>
</section>
