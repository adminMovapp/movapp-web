---
// Selección editorial de guías evergreen (no las últimas publicadas), para
// estabilizar el enlazado interno estratégico del home. Pendiente: sustituir
// por los 3 artículos reales del blog cuando existan.
const guides = [
   { title: '[Título real del artículo 1]', href: '/blog/' },
   { title: '[Título real del artículo 2]', href: '/blog/' },
   { title: '[Título real del artículo 3]', href: '/blog/' },
];
---

<section class="relative mx-auto my-16 w-full max-w-4xl px-4" data-aos="fade-up">
   <div class="text-center">
      <h2 class="text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">Aprende a defenderte</h2>
      <p class="mt-3 text-gray-600 dark:text-white/70">
         Guías y artículos para conocer tus derechos y protegerte de las apps montadeudas.
      </p>
   </div>

   <ul class="mx-auto mt-8 flex max-w-xl flex-col gap-3">
      {
         guides.map((g) => (
            <li>
               <a
                  href={g.href}
                  class="flex items-center justify-between rounded-xl border border-gray-200 px-5 py-4 text-sm font-semibold text-gray-800 transition hover:border-purple_mv/50 hover:text-text_banner dark:border-white/10 dark:text-white/80"
               >
                  {g.title}
                  <span class="text-text_banner">→</span>
               </a>
            </li>
         ))
      }
   </ul>
</section>
