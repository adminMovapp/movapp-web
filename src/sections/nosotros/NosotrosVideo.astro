---
import { CARD_STYLE, CARD_HOVER } from '@constants/cardStyles';
import { VIDEOS } from '@utils/config.jsx';

const cardHover = `${CARD_STYLE} ${CARD_HOVER}`;
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <div class={`overflow-hidden rounded-2xl p-2 ${cardHover}`}>
      <div class="aspect-video w-full overflow-hidden rounded-xl">
         <iframe
            src={VIDEOS.movapp}
            title="Conoce Movapp"
            class="h-full w-full"
            loading="lazy"
            frameborder="0"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
      </div>
   </div>
</section>
