---
import { VIDEOS } from '@constants/socials.ts';

const cardHover = 'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';
---

<section class="relative mx-auto my-16 w-full max-w-3xl px-4" data-aos="fade-up">
   <div class={`overflow-hidden rounded-2xl p-2 shadow-lg ${cardHover}`}>
      <div class="aspect-video w-full overflow-hidden rounded-xl">
         <iframe
            src={VIDEOS.movapp}
            title="Conoce Movapp"
            class="h-full w-full"
            loading="lazy"
            frameborder="0"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen></iframe>
      </div>
   </div>
</section>
