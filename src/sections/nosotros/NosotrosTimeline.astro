---
const story = [
   {
      title: 'El problema',
      text: 'La idea surgió de una necesidad real. Hace algunos años, Erik Mann pidió un préstamo en una app, pero pronto se vio atrapado en un ciclo de hostigamiento digital que afectó a él y a sus contactos.',
   },
   {
      title: 'Erik sufrió las amenazas',
      text: 'Su tranquilidad fue anulada por las amenazas y deudas generadas por apps no reguladas. Al llegar al límite, Erik compartió su experiencia en el podcast Urban Arts y conectó con otras personas que pasaban por lo mismo.',
   },
   {
      title: 'Creación de El Hack',
      text: 'Erik se dio a la tarea de crear El Hack, una herramienta que protege a los usuarios de aplicaciones fraudulentas, ofreciéndoles una solución confiable y efectiva.',
   },
];
---

<section class="relative mx-auto my-20 w-full max-w-3xl px-4" data-aos="fade-up">
   <div class="mb-12 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Nuestra historia</span>
      <h2 class="mt-1 text-2xl md:text-4xl font-bold text-gray-900 dark:text-white">
         ¿Cómo nació <span class="text-text_banner">Movapp</span>?
      </h2>
   </div>

   <!-- Línea de tiempo vertical -->
   <div id="storyGrid" class="reveal-stagger relative">
      <!-- Línea conectora -->
      <div
         class="absolute left-[15px] top-2 bottom-2 w-px bg-gradient-to-b from-purple_mv via-purple_mv/40 to-transparent md:left-1/2"
         aria-hidden="true"
      >
      </div>

      {
         story.map((s, i) => (
            <div
               class:list={[
                  'relative mb-10 flex items-start gap-6 md:mb-12 md:w-1/2',
                  i % 2 === 0
                     ? 'md:ml-0 md:pr-12 md:flex-row-reverse md:text-right'
                     : 'md:ml-auto md:pl-12 md:flex-row',
               ]}
            >
               {/* Punto en la línea */}
               <span
                  class:list={[
                     'absolute left-0 top-1 z-10 flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full border-2 border-purple_mv bg-gray-50 dark:bg-[#050505]',
                     i % 2 === 0 ? 'md:-right-4 md:left-auto' : 'md:-left-4',
                  ]}
               >
                  <span class="h-2.5 w-2.5 rounded-full bg-text_banner" />
               </span>

               {/* Contenido */}
               <div class="ml-12 md:ml-0 flex-1">
                  <h3 class="mb-2 text-lg font-bold text-text_banner">{s.title}</h3>
                  <p class="text-sm text-gray-700 dark:text-white/90">{s.text}</p>
               </div>
            </div>
         ))
      }
   </div>
</section>

<script is:inline>
   // Reveal escalonado de la historia (también en móvil, AOS está off <768px)
   var grid = document.getElementById('storyGrid');
   if (grid) {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
         grid.classList.add('in-view');
      } else {
         var io = new IntersectionObserver(
            function(entries) {
               entries.forEach(function(entry) {
                  if (entry.isIntersecting) {
                     entry.target.classList.add('in-view');
                     io.unobserve(entry.target);
                  }
               });
            },
            { threshold: 0.15 }
         );
         io.observe(grid);
      }
   }
</script>
