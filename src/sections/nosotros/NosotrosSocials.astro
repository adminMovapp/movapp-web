---
import { SOCIALS } from '@constants/socials.ts';
import { Picture } from 'astro:assets';

import ImgFacebook from '@assets/Icono-Facebook.png';
import ImgInstagram from '@assets/Icono-Instagram.png';
import ImgTiktok from '@assets/Icono-Tik-Tok.png';

const ICONS = {
   'Icono-Facebook.png': ImgFacebook,
   'Icono-Instagram.png': ImgInstagram,
   'Icono-Tik-Tok.png': ImgTiktok,
};

const cardHover = 'glass-card border border-purple_mv/20 dark:border-white/10 transition duration-300 ease-in-out hover:-translate-y-1 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] hover:border-purple_mv/50';
---

<section class="relative mx-auto my-section w-full max-w-4xl px-4" data-aos="fade-up">
   <div class="mb-10 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-text_banner">Síguenos</span>
      <h2 class="mt-1 text-2xl md:text-3xl font-bold gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         Redes Sociales de Nuestro CEO - Erik Mann
      </h2>
   </div>

   <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {
         SOCIALS.filter((social) => social.name !== 'YouTube').map((social) => (
            <a
               href={social.url}
               target="_blank"
               rel="noopener noreferrer"
               class={`flex flex-col items-center rounded-2xl p-8 text-center shadow-lg ${cardHover}`}
            >
               <div class="mb-4">
                  <Picture
                     src={social.icon ? ICONS[social.icon] : undefined}
                     alt={social.name}
                     class="h-14 w-14"
                  />
               </div>
               <div class="text-lg font-bold text-gray-900 dark:text-white">{social.name}</div>
               <span
                  class="counter mt-1 text-2xl font-bold text-text_banner drop-shadow-[0_0_20px_rgba(129,73,226,0.4)]"
                  data-target={social.count ?? 0}
               >
                  0
               </span>
            </a>
         ))
      }
   </div>
</section>

<script is:inline>
   // Contador animado
   document.querySelectorAll('.counter').forEach(function(counter) {
      var updateCounter = function() {
         var target = +counter.getAttribute('data-target');
         var current = +counter.textContent.replace(/,/g, '');
         var increment = target / 500;

         if (current < target) {
            current = Math.ceil(current + increment);
            counter.textContent = current.toLocaleString();
            setTimeout(updateCounter, 1);
         } else {
            counter.textContent = target.toLocaleString();
         }
      };
      updateCounter();
   });
</script>
