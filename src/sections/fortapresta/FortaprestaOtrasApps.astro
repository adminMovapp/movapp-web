---
// Cross-sell de otras apps REPORTADAS -- mismo criterio que
// PrestafacilOtrasApps.astro (título "ilegales" correcto acá: FortaPrest es
// una app reportada). Excluye FortaPrest, muestra StarPresta/MexiCash/PrestaFácil.
// Carrusel de 1 tarjeta por vez (2026-09-02, a pedido) -- ver
// AppOptionsCarousel.astro para el mecanismo compartido por las 8 apps.
import { REPORTED_APPS } from '@constants/directorioApps.ts';
import AppOptionsCarousel from '@components/decorative/AppOptionsCarousel.astro';

const OTHER_APPS = REPORTED_APPS.filter((app) => ['starpresta', 'mexicash', 'prestafacil'].includes(app.slug));
---

<AppOptionsCarousel
   id="fortapresta"
   heading="Otras aplicaciones ilegales que podrías consultar"
   apps={OTHER_APPS}
   statusColor="red"
/>
