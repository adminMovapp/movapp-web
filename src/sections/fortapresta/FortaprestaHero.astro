---
// H1 (único H1 de la página). Plantilla "app reportada" (ver
// PrestafacilHero.astro), pero acá el H1 usa formato "X: qué nos reportan
// los usuarios..." en vez de la pregunta de confiabilidad de PrestaFácil --
// se sigue el wireframe verbatim, cada app de este lado de la serie puede
// traer su propia variante de H1.
// Slug de ruta "fortapresta" (no "fortaprest") -- ver comentario en
// directorioApps.ts: es el slug canónico del documento maestro de SEO. El
// nombre visible de la app sigue siendo "FortaPrest".
import { Image } from 'astro:assets';
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { DIRECTORIO_ICONS } from '@constants/directorioApps.ts';
---

<section class="relative mx-auto max-w-3xl px-4 pt-16 text-center md:pt-8" data-aos="fade-up">
   <StarField id="fortapresta-hero" ambientCount={35} />

   <Breadcrumbs items={[{ label: 'Aplicaciones', href: '/aplicaciones-prestamo' }, { label: 'FortaPrest' }]} />

   <h1 class="relative z-10 mx-auto max-w-2xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
      FortaPrest: qué nos reportan los usuarios y qué puedes hacer
   </h1>

   <div class="relative z-10 mx-auto mt-8 grid max-w-xl grid-cols-1 items-center gap-6 text-left sm:grid-cols-[auto_1fr] sm:text-left">
      <div class="mx-auto flex h-28 w-28 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-gray-100 dark:bg-white/5 sm:mx-0">
         <Image src={DIRECTORIO_ICONS.fortapresta} alt="" width={112} class="h-full w-full object-contain p-3" loading="lazy" />
      </div>
      <p class="text-center text-gray-700 dark:text-white/80 sm:text-left">
         FortaPrest se presenta como una app de préstamos rápidos. Estuvo un tiempo fuera de las tiendas de
         aplicaciones y volvió a aparecer, que es algo que solemos ver en este tipo de plataformas.
      </p>
   </div>

   <div class="relative z-10 mt-8">
      <ButtonContact
         id="whatsapp-fortapresta-hero"
         label="Solicitar orientación"
         message="¡Hola! Quiero orientación sobre FortaPrest."
      />
   </div>
</section>
