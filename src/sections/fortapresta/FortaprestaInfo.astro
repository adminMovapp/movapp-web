---
// A diferencia de PrestafacilInfo.astro, este wireframe trae las tarjetas
// SIN título -- solo el dato en texto, así se sigue verbatim (no se inventa
// un h3 que no está en la fuente). Los 2 recuadros que el wireframe de
// escritorio traía vacíos se completaron en el wireframe de móviles
// (2026-08-28) -- contenido puramente aditivo (no contradice nada ya
// construido), así que se agrega igual en ambos breakpoints.
const INFO_ITEMS = [
   'Presta hasta $20,000 pesos.',
   'Ofrece plazos de 91 a 365 días.',
   'Te pide solo tu INE, ser mayor de edad y una cuenta bancaria mexicana.',
   'No pide aval ni comprobante de ingresos.',
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Información disponible sobre FortaPrest
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
         INFO_ITEMS.map((text) => (
            <li class="flex items-center justify-center rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
               <p class="text-sm text-gray-700 dark:text-white/80">{text}</p>
            </li>
         ))
      }
   </ul>
</section>
