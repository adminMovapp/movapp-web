---
// Estructura semántica pedida en la revisión de contenido (Angel Martínez,
// comentarios sobre /contacto):
// - "¡Sigue nuestras redes!" es <h2>.
// - Las redes son un conjunto de elementos relacionados: <ul> con un <li>
//   por perfil, y cada tarjeta completa (ícono + nombre) es un solo <a>.
// - alt="" en el ícono: el texto del enlace ya dice la plataforma (name),
//   así que el alt del ícono sería redundante.
// - width/height explícitos en el ícono para evitar CLS.
// - El texto del enlace es el NOMBRE DE LA PLATAFORMA (social.name:
//   "YouTube"/"Facebook"/"Instagram"/"TikTok"), no un usuario/handle --
//   el mockup fuente traía "Movappbyman" repetido (el handle, no la
//   plataforma) y hasta un "El Hack Funciona" suelto en el lugar de YouTube,
//   que no tiene relación con ninguna red -- se ignoró ese texto y se siguió
//   la instrucción explícita de la revisión en su lugar.
//
// Mismos íconos que el Footer (Footer.astro, /img/logo-*.webp -- a pedido,
// "que sean las mismas que las del footer") en vez de los Icono-*.png que
// usa NosotrosSocials.astro: son dos sets de assets distintos en el
// proyecto para la misma red, y esta sección debe usar el del footer.
// Mismas URLs de siempre (@utils/config.jsx), sin inventar links nuevos.
import StarField from '@components/decorative/StarField.astro';
import { SOCIALS } from '@utils/config.jsx';

const FOOTER_ICONS: Record<string, string> = {
   YouTube: '/img/logo-youtube.webp',
   TikTok: '/img/logo-tiktok.webp',
   Facebook: '/img/logo-facebook.webp',
   Instagram: '/img/logo-instagram.webp',
};
---

<section class="relative mx-auto my-section w-full max-w-xl px-4 text-center" data-aos="fade-up">
   <StarField id="contacto-socials" ambientCount={30} />

   <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¡Sigue nuestras redes!
   </h2>

   <ul class="mt-10 flex flex-col gap-4">
      {
         SOCIALS.map((social) => (
            <li>
               <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="glass-card flex items-center gap-4 rounded-2xl border border-purple_mv/20 p-4 text-left transition duration-300 hover:-translate-y-1 hover:border-purple_mv/50 hover:shadow-[0_0_25px_rgba(129,73,226,0.25)] dark:border-white/10"
               >
                  <img src={FOOTER_ICONS[social.name]} alt="" width="40" height="40" class="h-10 w-10 rounded-full object-cover" />
                  <span class="font-bold text-gray-900 dark:text-white">{social.name}</span>
               </a>
            </li>
         ))
      }
   </ul>
</section>
