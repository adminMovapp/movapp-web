---
// Estructura semántica pedida en la revisión de contenido (Angel Martínez,
// comentarios sobre /contacto):
// - "Nombres"/"Apellido"/"Correo"/"Mensaje" NO son <h3> -- cada uno es un
//   <label for="..."> asociado al id de su <input>/<textarea>, con name,
//   autocomplete y required (los 4 campos son obligatorios).
// - "Enviar" es <button type="submit"> (no <a>, envía el formulario), con
//   id="contacto-formulario-enviar" como identificador estable para medición
//   (mismo criterio que el id de ButtonContact.astro). Los eventos GA4 de
//   este formulario (form_error / generate_lead) se emiten en el <script>
//   de abajo vía pushToDataLayer.
import StarField from '@components/decorative/StarField.astro';

const fieldClass =
   'rounded-xl border border-purple_mv/25 bg-purple_mv/5 px-4 py-3 text-gray-900 placeholder:text-gray-500 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-white/40';
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4" data-aos="fade-up">
   <StarField id="contacto-form" ambientCount={30} />

   <div class="text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         ¿Tienes alguna pregunta?
      </h2>
      <p class="mt-3 text-gray-700 dark:text-white/80">Pregúntanos cómo podemos ayudarte.</p>
   </div>

   <form id="contactoForm" class="glass-card mt-10 flex flex-col gap-5 rounded-2xl border border-purple_mv/20 p-6 dark:border-white/10 md:p-8">
      <div class="flex flex-col gap-2 text-left">
         <label for="contacto-nombre" class="text-sm font-semibold text-gray-900 dark:text-white">Nombres</label>
         <input
            id="contacto-nombre"
            name="nombre"
            type="text"
            autocomplete="given-name"
            required
            class={fieldClass}
         />
      </div>

      <div class="flex flex-col gap-2 text-left">
         <label for="contacto-apellido" class="text-sm font-semibold text-gray-900 dark:text-white">Apellido</label>
         <input
            id="contacto-apellido"
            name="apellido"
            type="text"
            autocomplete="family-name"
            required
            class={fieldClass}
         />
      </div>

      <div class="flex flex-col gap-2 text-left">
         <label for="contacto-correo" class="text-sm font-semibold text-gray-900 dark:text-white">Correo electrónico</label>
         <input
            id="contacto-correo"
            name="correo"
            type="email"
            autocomplete="email"
            required
            class={fieldClass}
         />
      </div>

      <div class="flex flex-col gap-2 text-left">
         <label for="contacto-mensaje" class="text-sm font-semibold text-gray-900 dark:text-white">Mensaje</label>
         <textarea id="contacto-mensaje" name="mensaje" rows="5" required class={fieldClass}></textarea>
      </div>

      <p
         id="contactoFormStatus"
         role="status"
         class="hidden rounded-xl border border-purple_mv/25 bg-purple_mv/10 p-3 text-center text-sm font-medium text-purple_mv dark:border-white/10"
      >
         ¡Gracias! Recibimos tu mensaje y te contactaremos pronto.
      </p>

      <p id="contactoFormError" role="alert" class="hidden text-center text-sm font-medium text-red-500">
         No pudimos enviar tu mensaje. Intenta de nuevo en unos minutos.
      </p>

      <button
         id="contacto-formulario-enviar"
         type="submit"
         class="rounded-full bg-purple_mv px-6 py-4 text-base font-bold text-white transition hover:bg-purple_mv/85 disabled:cursor-not-allowed disabled:opacity-60"
      >
         Enviar
      </button>
   </form>
</section>

<script>
   import { pushToDataLayer } from '@utils/dataLayer.js';
   import { ERROR_TYPES } from '@constants/tracking.ts';

   // Envía a netlify/functions/contact-form.js vía /api/contact-form
   // (redirect en netlify.toml). generate_lead y el Lead de Meta Pixel solo
   // se disparan tras un 200 real del backend (doc maestro hoja 04, QA-031):
   // antes de esto el "éxito" era un mock en el submit y contaba prospectos
   // que nunca llegaban a nadie.
   const initContactoForm = (form: HTMLFormElement) => {
      if (form.getAttribute('data-ready') === 'true') return;
      form.setAttribute('data-ready', 'true');

      const status = document.getElementById('contactoFormStatus');
      const errorStatus = document.getElementById('contactoFormError');
      const submitButton = form.querySelector<HTMLButtonElement>('#contacto-formulario-enviar');
      const FORM_ID = 'contactanos';
      const FORM_NAME = 'formulario_contacto';

      // form_error: UN solo evento por intento de envío con todos los campos
      // inválidos (plan de eventos GA4, fase 1). La validación nativa
      // (required/type="email") bloquea el submit sin disparar "submit" --
      // lo único que dispara es "invalid", una vez por campo y de forma
      // síncrona en el mismo tick. En vez de acumular nombres a mano push
      // por push (QA de tracking, sept. 2026: el error_message arrastraba
      // campos de intentos anteriores), se lee el DOM directo con
      // form.querySelectorAll(':invalid') al vaciarse la pila -- siempre
      // refleja los campos inválidos DE ESE intento, sin memoria entre
      // envíos. error_message lleva nombres de campo, nunca valores
      // escritos por el usuario.
      let errorPushedForAttempt = false;
      form.addEventListener(
         'invalid',
         () => {
            if (errorPushedForAttempt) return;
            errorPushedForAttempt = true;
            queueMicrotask(() => {
               const invalidFields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(':invalid')).map(
                  (field) => field.name || field.id || 'desconocido',
               );
               pushToDataLayer('form_error', {
                  form_id: FORM_ID,
                  form_name: FORM_NAME,
                  error_type: ERROR_TYPES.validationError,
                  error_message: invalidFields.join(','),
                  page_location: location.href,
               });
               errorPushedForAttempt = false;
            });
         },
         true,
      );

      form.addEventListener('submit', (e) => {
         e.preventDefault();
         status?.classList.add('hidden');
         errorStatus?.classList.add('hidden');
         // form_submit a mano: el automático de la medición mejorada de GA4
         // no llega en este formulario (preventDefault, comprobado en
         // staging por el plan de eventos, fase 1).
         pushToDataLayer('form_submit', {
            form_id: FORM_ID,
            form_name: FORM_NAME,
            form_submit_text: 'Enviar',
            page_location: location.href,
         });

         const fd = new FormData(form);
         const nombre = String(fd.get('nombre') || '');
         const apellido = String(fd.get('apellido') || '');
         const correo = String(fd.get('correo') || '');
         const mensaje = String(fd.get('mensaje') || '');

         if (submitButton) submitButton.disabled = true;

         fetch('/api/contact-form', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nombre, apellido, correo, mensaje }),
         })
            .then(async (response) => {
               if (!response.ok) throw new Error(`status ${response.status}`);

               status?.classList.remove('hidden');
               // generate_lead y el Lead de Meta Pixel solo se disparan tras
               // este 200 real del backend (doc maestro hoja 04, QA-031): un
               // envío simulado no debe contar como prospecto.
               pushToDataLayer('generate_lead', {
                  form_id: FORM_ID,
                  form_name: FORM_NAME,
                  lead_type: 'contacto_general',
                  page_location: location.href,
               });
               window.metaPixel?.track(
                  'Lead',
                  { content_name: FORM_NAME, content_category: 'lead_generation', lead_type: 'contacto_general' },
                  {
                     em: correo ? [correo] : undefined,
                     fn: nombre ? [nombre] : undefined,
                     ln: apellido ? [apellido] : undefined,
                     country: ['mx'],
                  },
               );
               form.reset();
            })
            .catch(() => {
               errorStatus?.classList.remove('hidden');
               pushToDataLayer('form_error', {
                  form_id: FORM_ID,
                  form_name: FORM_NAME,
                  error_type: ERROR_TYPES.backendError,
                  error_message: 'contact_form_submit_failed',
                  page_location: location.href,
               });
            })
            .finally(() => {
               if (submitButton) submitButton.disabled = false;
            });
      });
   };

   const initAllContactoForms = () => {
      document.querySelectorAll<HTMLFormElement>('#contactoForm').forEach(initContactoForm);
   };

   initAllContactoForms();
   document.addEventListener('astro:page-load', initAllContactoForms);
</script>
