---
import { Image } from 'astro:assets';
import StormField from '@components/decorative/StormField.astro';
import ImagePlaceholder from '@components/ui/ImagePlaceholder.astro';
import ImgPlayStore from '@assets/play-store-v2.webp';
import ImgAppStore from '@assets/app-store-v2.webp';
import ImgMockup from '@assets/Mockup-celular-movapp-1.webp';

const features = [
   {
      title: 'Bloquea las llamadas de acoso',
      text: 'Deja de recibir llamadas a toda hora.',
   },
   {
      title: 'Silencia los mensajes amenazantes',
      text: 'Los textos con insultos o amenazas dejan de llegarte.',
   },
];
---

<section class="relative mx-auto my-16 w-full max-w-5xl px-4" data-aos="fade-up">
   <StormField id="el-hack-features" boltCount={4} />

   <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase text-gray-900 dark:text-white">¿Qué hace El Hack por ti?</h2>
   </div>

   <!--
      Estructura solo para móvil (ver mockup): carrusel horizontal con swipe
      en vez del grid apilado -- mismo lenguaje visual que el carrusel móvil
      de Home (HomeFeatured.astro/HomeTrust.astro): peek de tarjeta en "vw",
      sin scrollbar visible, tarjeta activa resaltada (is-dimmed en las
      demás) y una pista de swipe con flechas debajo. Desde md vuelve
      exactamente al grid de 2 columnas de siempre (sin scroll, sin snap).
   -->
   <ul
      id="featuresCarousel"
      class="no-scrollbar mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-[11vw] pb-2 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pb-0 md:snap-none"
   >
      {
         features.map((f, i) => (
            <li
               class="features-card float-anim relative flex w-[78vw] flex-shrink-0 snap-center flex-col items-center overflow-hidden rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:w-auto md:flex-shrink md:p-6"
               style={`--float-dur: ${5.6 + i * 0.3}s; --float-delay: ${i * 0.2}s;`}
            >
               <ImagePlaceholder class="relative mb-3 aspect-[4/3] w-full max-w-[140px]" />
               <h3 class="relative font-bold text-text_banner dark:text-text_banner">
                  {f.title}
               </h3>
               <p class="relative mt-1 text-sm text-gray-600 dark:text-white/70">{f.text}</p>
            </li>
         ))
      }
   </ul>

   <!-- Pista de swipe: solo en móvil, siempre visible en el HTML (no depende
        de JS) -- mismo componente que HomeFeatured.astro/HomeTrust.astro. -->
   <div class="swipe-hint mx-auto mt-5 flex w-fit items-center gap-2 rounded-full border border-purple_mv/25 bg-purple_mv/5 px-4 py-1.5 text-[11px] font-medium text-gray-500 dark:border-white/10 dark:bg-white/5 dark:text-white/50 md:hidden">
      <button id="featuresSwipePrev" type="button" aria-label="Ver feature anterior" class="-m-1 flex items-center justify-center p-1">
         <svg class="swipe-hint-arrow h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
         </svg>
      </button>
      Desliza para ver más
      <button id="featuresSwipeNext" type="button" aria-label="Ver siguiente feature" class="-m-1 flex items-center justify-center p-1">
         <svg class="swipe-hint-arrow h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
         </svg>
      </button>
   </div>

   <!-- Disponibilidad -->
   <div class="mx-auto mt-12 flex max-w-xl flex-col items-center gap-4 text-center">
      <!-- Misma imagen y tratamiento que la card del CTA de Home (HomeCTA.astro). -->
      <div
         class="flex aspect-[4/3] w-full max-w-[220px] items-center justify-center rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5"
      >
         <Image
            src={ImgMockup}
            alt="Vista previa de Movapp en la App Store"
            width={450}
            class="h-full w-full object-contain p-4"
            loading="lazy"
         />
      </div>
      <p class="text-sm font-semibold uppercase tracking-widest text-text_banner">El Hack está disponible para:</p>
      <div class="flex flex-col items-center gap-3 sm:flex-row">
         <a href="#" aria-label="Descargar en Google Play" class="transition hover:scale-105">
            <Image src={ImgPlayStore} alt="Google Play" height={96} class="store-badge h-12 w-auto" />
         </a>
         <a href="#" aria-label="Descargar en App Store" class="transition hover:scale-105">
            <Image src={ImgAppStore} alt="App Store" height={96} class="store-badge h-12 w-auto" />
         </a>
      </div>
   </div>

   <!-- Seguridad -->
   <div class="mx-auto mt-14 max-w-2xl rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-8 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-10">
      <h2 class="text-xl font-bold uppercase text-gray-900 dark:text-white md:text-2xl">
         ¿Es seguro? Tu información está protegida
      </h2>
      <p class="mt-3 text-sm text-gray-700 dark:text-white/80 md:text-base">
         El Hack pide únicamente los permisos necesarios para bloquear el acoso y proteger tus contactos.
      </p>
   </div>
</section>

<style>
   /*
      Tamaño real del badge fijado acá (no solo con "h-12" de Tailwind) --
      este <style> con scope de componente se aplica siempre, con o sin JS.
      Mientras Tailwind no ha cargado, el <img> no tiene ninguna regla de
      tamaño y se pinta a su dimensión real (height={96}, pensado para
      retina) -- más grande que los 48px finales de "h-12", lo que puede
      generar un salto de layout (CLS) al cargar Tailwind. Debe coincidir
      con "h-12" si cambia.
   */
   .store-badge {
      height: 3rem;
      width: auto;
   }

   /* Carrusel móvil: mismas reglas que HomeFeatured.astro/HomeTrust.astro. */
   .no-scrollbar::-webkit-scrollbar {
      display: none;
   }
   .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
   }

   .features-card {
      transition:
         transform 0.4s ease,
         opacity 0.4s ease,
         filter 0.4s ease;
   }
   .features-card.is-dimmed {
      opacity: 0.5;
      transform: scale(0.94);
      filter: saturate(0.7);
   }

   @keyframes swipeNudge {
      0%,
      100% {
         transform: translateX(0);
      }
      50% {
         transform: translateX(3px);
      }
   }
   .swipe-hint-arrow {
      animation: swipeNudge 1.6s ease-in-out infinite;
   }
   .swipe-hint-arrow:first-child {
      animation-direction: reverse;
   }
</style>

<script>
   // Mismo comportamiento que initFeaturedCarousel/initTrustCarousel en
   // HomeFeatured.astro/HomeTrust.astro -- ver esos archivos para el detalle
   // completo de por qué el click de las flechas se intercepta por
   // coordenadas (widget de chat con overlay fixed de z-index gigante) y por
   // qué el desplazamiento va detrás de un doble rAF (reprocesamiento
   // forzado al leer offsetLeft/offsetWidth).
   const initFeaturesCarousel = () => {
      const track = document.getElementById('featuresCarousel');
      if (!track || track.getAttribute('data-carousel-ready') === 'true') return;
      track.setAttribute('data-carousel-ready', 'true');

      const cards = Array.from(track.querySelectorAll('.features-card'));
      if (!cards.length || track.scrollWidth <= track.clientWidth + 1) return;

      const setActive = (activeEl: Element) => {
         cards.forEach((c) => c.classList.toggle('is-dimmed', c !== activeEl));
      };

      if ('IntersectionObserver' in window) {
         const io = new IntersectionObserver(
            (entries) => {
               let best: IntersectionObserverEntry | null = null;
               entries.forEach((entry) => {
                  if (entry.isIntersecting && (!best || entry.intersectionRatio > best.intersectionRatio)) {
                     best = entry;
                  }
               });
               if (best) setActive(best.target);
            },
            { root: track, threshold: [0.5, 0.6, 0.7, 0.8, 0.9, 1] },
         );
         cards.forEach((c) => io.observe(c));
      }

      const getActiveIndex = () => {
         const center = track.scrollLeft + track.clientWidth / 2;
         let closest = 0;
         let minDist = Infinity;
         cards.forEach((c, i) => {
            const cardEl = c as HTMLElement;
            const dist = Math.abs(cardEl.offsetLeft + cardEl.offsetWidth / 2 - center);
            if (dist < minDist) {
               minDist = dist;
               closest = i;
            }
         });
         return closest;
      };

      const scrollToIndex = (i: number) => {
         const clamped = Math.max(0, Math.min(cards.length - 1, i));
         cards[clamped].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      };

      const prevBtn = document.getElementById('featuresSwipePrev');
      const nextBtn = document.getElementById('featuresSwipeNext');

      const isInside = (el: Element, x: number, y: number) => {
         const r = el.getBoundingClientRect();
         return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
      };
      const goToRelativeCard = (delta: number) => {
         requestAnimationFrame(() => {
            requestAnimationFrame(() => {
               scrollToIndex(getActiveIndex() + delta);
            });
         });
      };

      window.addEventListener(
         'click',
         (e) => {
            if (prevBtn && isInside(prevBtn, e.clientX, e.clientY)) {
               e.stopPropagation();
               goToRelativeCard(-1);
            } else if (nextBtn && isInside(nextBtn, e.clientX, e.clientY)) {
               e.stopPropagation();
               goToRelativeCard(1);
            }
         },
         { capture: true },
      );

      prevBtn?.addEventListener('click', () => goToRelativeCard(-1));
      nextBtn?.addEventListener('click', () => goToRelativeCard(1));
   };

   initFeaturesCarousel();
   document.addEventListener('astro:page-load', initFeaturesCarousel);
</script>
