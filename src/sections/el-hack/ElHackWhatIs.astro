---
import StormField from '@components/decorative/StormField.astro';
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <StormField id="el-hack-what-is" />

   <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">¿Qué es El Hack?</h2>
      <p class="mt-4 text-gray-700 dark:text-white/80">
         Es el servicio de Movapp para frenar el acoso de las apps montadeudas a ti y a tus contactos. Se solicita
         con un asesor que confirma el alcance y el precio, y lo aplica nuestro equipo técnico.
      </p>
      <div class="mt-8">
         <a
            id="cta-elhack-tienda"
            href="/tienda/"
            data-cta="el_hack_tienda"
            data-page-type="el_hack"
            data-section-name="que_es"
            data-destination-type="internal_page"
            class="inline-flex items-center justify-center rounded-full bg-purple_mv px-6 py-4 text-base font-bold text-white transition hover:bg-purple_mv/85 md:text-lg"
         >
            Quiero el hack
         </a>
      </div>
   </div>
</section>
