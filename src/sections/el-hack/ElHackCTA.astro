---
import ButtonContact from '@components/ui/ButtonContact.astro';
import StormField from '@components/decorative/StormField.astro';
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <!-- StormField a nivel de sección (fullBleed), igual que el resto de las secciones de El Hack --
        no adentro de la card, que se vería como una caja de niebla aparte en vez de fondo de página. -->
   <StormField id="el-hack-cta" />

   <!--
      Misma tarjeta "panel" que el bloque de seguridad en ElHackFeatures.astro
      (rounded-3xl, border-purple_mv/25, mismo degradado, shadow-card, mismo
      padding) -- antes tenía 2 glows morados extra + más padding, y por eso
      se veía mucho más saturada/grande que el resto de las cards de la página.
   -->
   <div
      class="float-anim relative rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-8 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-10"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <div class="relative z-10 flex flex-col items-center gap-5">
         <h2 class="text-2xl md:text-3xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">Empieza hoy</h2>
         <p class="max-w-md text-sm md:text-base text-gray-600 dark:text-white/80">
            Da el primer paso para recuperar tu tranquilidad.
         </p>
         <div class="float-anim mt-2" style="--float-dur: 5.8s; --float-delay: 0.3s;">
            <ButtonContact id="cta_whatsapp_elhack_empiezahoy_02" label="Hablar con un asesor" fullWidth />
         </div>
      </div>
   </div>
</section>
