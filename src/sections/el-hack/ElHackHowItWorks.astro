---
import { Image } from 'astro:assets';
import StormField from '@components/decorative/StormField.astro';
import ImgAsesor from '@assets/habla-con-un-asesor-real.webp';
import ImgInstala from '@assets/instala-y-activa-el-hack.webp';
import ImgTranquilidad from '@assets/recupera-tu-tranquilidad.webp';

import { EL_HACK_STEPS as steps, EL_HACK_HOW_IT_WORKS_TITLE } from '@constants/elhack.ts';

// Una foto real por paso (mismo orden que EL_HACK_STEPS) -- reemplaza el
// ImagePlaceholder que había antes. Ancho pedido (700) bien por encima del
// hueco real en pantalla (tarjeta de ~300-400px de ancho) para cubrir
// retina, pero muy por debajo del tamaño original de los archivos fuente
// (1400-1800px) -- servir el original completo para esta tarjeta chica
// sería exactamente el desperdicio que señala la skill de Rendimiento.
const stepImages = [ImgAsesor, ImgInstala, ImgTranquilidad];
---

<section class="relative mx-auto my-section w-full max-w-4xl px-4" data-aos="fade-up">
   <StormField id="el-hack-how-it-works" boltCount={4} />

   <div class="mb-10 text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">{EL_HACK_HOW_IT_WORKS_TITLE}</h2>
      <p class="mt-3 text-gray-700 dark:text-white/80">Tres pasos para volver a tener el control:</p>
   </div>

   <!--
      Grilla de tarjetas (no timeline): los 2 primeros pasos van lado a lado
      desde sm+, el tercero queda centrado debajo, con el mismo ancho que una
      columna -- mismo layout que el documento maestro (2 arriba + 1 abajo
      centrado), no la línea de tiempo con puntos que usa HomeHowItWorks.
   -->
   <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-10">
      {
         steps.map((s, i) => (
            <div
               class:list={[
                  'float-anim flex flex-col items-center rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-6 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30',
                  i === 2 && 'sm:col-span-2 sm:mx-auto sm:w-full sm:max-w-[calc(50%-0.75rem)]',
               ]}
               style={`--float-dur: ${5.6 + i * 0.3}s; --float-delay: ${i * 0.2}s;`}
            >
               <div class="mb-4 aspect-[4/3] w-full overflow-hidden rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5">
                  <Image src={stepImages[i]} alt="" width={700} class="h-full w-full object-cover" loading="lazy" />
               </div>
               <h3 class="mb-2 text-lg font-bold text-text_banner dark:text-text_banner">
                  {s.title}
               </h3>
               <p class="text-sm text-gray-700 dark:text-white/80">{s.text}</p>
            </div>
         ))
      }
   </div>
</section>
