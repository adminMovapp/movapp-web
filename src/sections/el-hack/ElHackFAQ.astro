---
import StormField from '@components/decorative/StormField.astro';
import { EL_HACK_FAQS as faqs } from '@constants/elhack.ts';

// Un ícono por pregunta, representando de qué trata cada una (no son
// decorativos genéricos) -- en el mismo orden que EL_HACK_FAQS. Se guardan
// acá (no en el archivo de constantes) porque son puramente visuales, sin
// relación con el copy que también alimenta el JSON-LD.
const faqIcons = [
   // "¿El Hack elimina mi deuda?" -- billete (tema: deuda/dinero)
   '<rect x="2" y="6" width="20" height="12" rx="2"></rect><circle cx="12" cy="12" r="3"></circle><path d="M6 10h.01M18 14h.01"></path>',
   // "¿Cuánto cuesta?" -- etiqueta de precio
   '<path d="M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3H4a1 1 0 0 0-1 1v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l4.59-4.59a2 2 0 0 0 0-2.83Z"></path><circle cx="7.5" cy="7.5" r="1.2" fill="currentColor" stroke="none"></circle>',
   // "¿Qué pasa después de escribirles por WhatsApp?" -- burbuja de chat
   '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"></path>',
   // "¿Cuánto tarda El Hack?" -- reloj
   '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path>',
];
---

<section class="relative mx-auto my-16 w-full max-w-3xl px-4" data-aos="fade-up">
   <StormField id="el-hack-faq" />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase text-gray-900 dark:text-white">
      Preguntas frecuentes sobre El Hack
   </h2>

   <div class="mt-10 flex flex-col gap-4">
      {
         faqs.map((item, i) => (
            <details
               class="float-anim group glass-card rounded-2xl border border-purple_mv/20 p-5 dark:border-white/10"
               style={`--float-dur: ${5.6 + i * 0.3}s; --float-delay: ${i * 0.2}s;`}
            >
               <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-gray-900 dark:text-white">
                  <span class="flex items-center gap-3">
                     <svg
                        class="h-5 w-5 flex-shrink-0 text-text_banner"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={faqIcons[i]}
                     />
                     <h3 class="font-semibold text-text_banner dark:text-text_banner">{item.q}</h3>
                  </span>
                  <svg
                     class="h-5 w-5 flex-shrink-0 text-text_banner transition-transform duration-200 group-open:rotate-180"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                  >
                     <path d="M6 9l6 6 6-6" />
                  </svg>
               </summary>
               <p class="mt-3 text-sm text-gray-600 dark:text-white/70">{item.a}</p>
            </details>
         ))
      }
   </div>
</section>
