---
// Tarjetas gris planas -- mismo criterio que CrediseguroInfo.astro/etc. El
// tercer recuadro que el primer wireframe traía vacío (sin título ni texto)
// se completó en la actualización de Santiago (2026-08-28): "Registro
// CONDUSEF: No localizada".
const INFO_CARDS = [
   { title: 'Desarrollador', text: 'No disponible' },
   { title: 'Registro CONDUSEF', text: 'No localizada' },
   { title: 'Tipo de servicio', text: 'Préstamo corto plazo' },
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Información disponible sobre PrestaFácil
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
         INFO_CARDS.map((card) => (
            <li class="rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
               <h3 class="font-bold text-text_banner">{card.title}</h3>
               <p class="mt-2 text-sm italic text-gray-600 dark:text-white/70">{card.text}</p>
            </li>
         ))
      }
   </ul>
</section>
