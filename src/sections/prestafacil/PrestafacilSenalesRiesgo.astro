---
// Mismo tratamiento visual que PrestafacilInfo.astro. El tercer recuadro que
// el primer wireframe traía vacío se completó en la actualización de
// Santiago (2026-08-28): "Cobranza con amenazas".
//
// "Acceso a contactos" -- ese mismo wireframe también trajo un texto nuevo
// para esta tarjeta ("Localizada en el registro de CONDUSEF..."), pero es
// literalmente el mismo texto de la tarjeta "Registro vigente" de CrediSeguro
// y contradice la tarjeta de Info de esta misma página ("Registro CONDUSEF:
// No localizada"). Confirmado con Santiago: se aplica ÚNICAMENTE en móvil
// (textMobile) -- el texto de escritorio ya construido no se toca. Mismo
// patrón responsive que HomeSymptoms.astro.
const RISK_SIGNS = [
   {
      title: 'Acceso a contactos',
      text: 'Solicita permiso para leer la agenda telefónica.',
      textMobile: 'Localizada en el registro de CONDUSEF a la fecha de revisión.',
   },
   { title: 'Comisiones poco claras', text: 'No se especifican tasas antes de aceptar.' },
   { title: 'Cobranza con amenazas', text: 'Reportes de mensajes intimidatorios.' },
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Señales de riesgo relacionadas con PrestaFácil
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
         RISK_SIGNS.map((sign) =>
            sign.textMobile ? (
               <li class="rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
                  <h3 class="font-bold text-gray-900 dark:text-white">{sign.title}</h3>
                  <p class="mt-2 text-sm italic text-gray-600 dark:text-white/70 md:hidden">{sign.textMobile}</p>
                  <p class="mt-2 hidden text-sm italic text-gray-600 dark:text-white/70 md:block">{sign.text}</p>
               </li>
            ) : (
               <li class="rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
                  <h3 class="font-bold text-gray-900 dark:text-white">{sign.title}</h3>
                  <p class="mt-2 text-sm italic text-gray-600 dark:text-white/70">{sign.text}</p>
               </li>
            ),
         )
      }
   </ul>
</section>
