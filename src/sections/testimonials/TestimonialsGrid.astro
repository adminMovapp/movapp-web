---
// Estructura semántica pedida en la revisión de contenido (Angel Martínez,
// comentarios sobre /testimonials):
// - Cada tarjeta es un <li> dentro de un <ul> (no <div>s sueltos).
// - El nombre va como <p><strong>Nombre</strong></p> -- NO <h3>: un nombre
//   de persona no funciona como encabezado de una sección independiente.
// - El testimonio va como <p>texto</p> normal.
// - El avatar es un <img> real con alt="[Nombre], testimonio de Movapp"
//   (no un ícono/div decorativo aria-hidden como ImagePlaceholder.astro,
//   que no tiene semántica de imagen real).
//
// Foto real por testimonio (ver constants/testimonials.ts, t.photo) --
// migradas de public/img/testimonios a src/assets siguiendo la skill de
// Rendimiento. El generador de iniciales de abajo queda como fallback (no se
// usa hoy, los 9 ya tienen foto) por si se agrega un testimonio nuevo sin
// foto todavía.
import { Image } from 'astro:assets';
import StarField from '@components/decorative/StarField.astro';
import { TESTIMONIALS } from '@constants/testimonials.ts';

const AVATAR_COLORS = ['#8149e2', '#10b981', '#0ea5e9', '#f59e0b', '#ec4899', '#14b8a6'];

const initialsOf = (name: string) =>
   name
      .split(' ')
      .filter(Boolean)
      .slice(0, 2)
      .map((w) => w[0])
      .join('')
      .toUpperCase();

const avatarSrc = (name: string, color: string) => {
   const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96"><rect width="96" height="96" rx="48" fill="${color}"/><text x="48" y="49" font-family="Segoe UI, Arial, sans-serif" font-size="34" font-weight="700" fill="#ffffff" text-anchor="middle" dominant-baseline="central">${initialsOf(name)}</text></svg>`;
   return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

// Inclinación "desencuadrada" por tarjeta, alternando de lado y variando la
// magnitud (4°/5.5°/7°, cíclico) para que no se vea como una sola rotación
// repetida -- determinístico por índice (no Math.random(), mismo criterio
// que --faq-spin-from en FAQAccordion.astro) para que el SSR sea consistente
// entre requests.
const tiltOf = (i: number) => (i % 2 === 0 ? -1 : 1) * (4 + (i % 3) * 1.5);
---

<section class="relative mx-auto my-section w-full max-w-6xl px-4" data-aos="fade-up" data-testimonials-grid>
   <StarField id="testimonials-grid" ambientCount={50} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Historias reales de personas que recuperaron su tranquilidad
   </h2>
   <p class="mx-auto mt-4 max-w-2xl text-center text-gray-700 dark:text-white/80">
      Estas son experiencias de personas que enfrentaron el acoso de las apps de préstamo y hoy viven con más paz. Cada
      testimonio es real y se publica con su consentimiento.
   </p>

   <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
      {
         TESTIMONIALS.map((t, i) => (
            <li
               class="testimonial-card flex flex-col items-center rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-3 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 sm:p-5"
               style={`--tilt: ${tiltOf(i)}deg;`}
            >
               {t.photo ? (
                  <Image
                     src={t.photo}
                     alt={`${t.name}, testimonio de Movapp`}
                     width={100}
                     class="testimonial-avatar h-10 w-10 rounded-full object-cover sm:h-12 sm:w-12"
                     loading="lazy"
                  />
               ) : (
                  <img
                     src={avatarSrc(t.name, AVATAR_COLORS[i % AVATAR_COLORS.length])}
                     alt={`${t.name}, testimonio de Movapp`}
                     width="40"
                     height="40"
                     class="testimonial-avatar h-10 w-10 rounded-full sm:h-12 sm:w-12"
                     loading="lazy"
                  />
               )}
               <p class="mt-3">
                  <strong class="text-sm text-purple_mv sm:text-base">{t.name}</strong>
               </p>
               <p class="mt-2 text-xs text-gray-700 dark:text-white/80 sm:text-sm">“{t.text}”</p>
            </li>
         ))
      }
   </ul>
</section>

<style>
   /*
      Tamaño real del avatar fijado acá (no solo con "h-10 w-10 sm:h-12
      sm:w-12" de Tailwind) -- mismo criterio de CLS que .site-logo en
      Header.astro (ver skill de Rendimiento): dos tamaños según breakpoint
      necesitan su propio <style> con scope de componente (siempre
      inlineado, con o sin JS) para que no haya salto entre el
      width/height=40 del <img> y el tamaño final en pantalla.
   */
   .testimonial-avatar {
      height: 2.5rem;
      width: 2.5rem;
   }
   @media (min-width: 640px) {
      .testimonial-avatar {
         height: 3rem;
         width: 3rem;
      }
   }

   /*
      "Desencuadradas": cada tarjeta arranca con su propia inclinación
      (--tilt, ver arriba) como si fueran fotos puestas de cualquier forma, y
      se "cuadran" (rotate(0)) al interactuar -- con mouse real, al pasar el
      cursor; sin mouse (touch), al entrar en viewport (ver <script> más
      abajo, agrega "is-aligned").

      OJO -- este componente usaba antes "@media (hover: hover)"/"(hover:
      none)" para separar ambos casos, y se cambió tras un reporte real: en
      un Galaxy A52s con el navegador Samsung Internet las tarjetas nunca se
      cuadraban al hacer scroll. Causa confirmada: Samsung Internet tiene un
      bug conocido donde "(hover: hover)" da TRUE en pantallas táctiles puras
      (sin mouse ni lápiz) -- el navegador entra por la rama "de escritorio"
      (espera un :hover real) y como nunca llega, el tilt queda inclinado
      para siempre. La media query de CSS no es confiable para esto en la
      práctica. En vez de eso, el <script> de abajo detecta touch por JS
      (navigator.maxTouchPoints/ontouchstart, no depende del media feature)
      y agrega ".is-touch-device" a este section -- el CSS decide el cuadre
      según esa clase, no según "(hover: ...)".
   */
   .testimonial-card {
      transform: rotate(var(--tilt, 0deg));
      transition:
         transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
         border-color 0.3s ease,
         box-shadow 0.3s ease;
   }
   [data-testimonials-grid].is-touch-device .testimonial-card.is-aligned {
      transform: rotate(0deg);
   }
   [data-testimonials-grid]:not(.is-touch-device) .testimonial-card:hover {
      transform: rotate(0deg);
   }
</style>

<script>
   // Cuadra cada tarjeta al entrar en viewport -- sólo tiene efecto visual en
   // touch (ver ".is-touch-device" arriba); en desktop la clase "is-aligned"
   // se agrega igual pero el CSS la ignora, el cuadre ahí depende únicamente
   // del :hover real.
   const initTestimonialTilt = (root: Element) => {
      if (root.getAttribute('data-tilt-ready') === 'true') return;
      root.setAttribute('data-tilt-ready', 'true');

      // Ver nota arriba: detección real de touch por JS, NO por
      // "matchMedia('(hover: none)')" -- Samsung Internet (confirmado en
      // Galaxy A52s) reporta "hover: hover" incluso sin mouse/lápiz.
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
      root.classList.toggle('is-touch-device', isTouchDevice);

      const cards = Array.from(root.querySelectorAll('.testimonial-card'));
      if (!cards.length) return;

      if (!('IntersectionObserver' in window)) {
         cards.forEach((c) => c.classList.add('is-aligned'));
         return;
      }

      const observer = new IntersectionObserver(
         (entries, obs) => {
            entries.forEach((entry) => {
               if (entry.isIntersecting) {
                  entry.target.classList.add('is-aligned');
                  obs.unobserve(entry.target);
               }
            });
         },
         { threshold: 0.4 },
      );
      cards.forEach((c) => observer.observe(c));
   };

   const initAllTestimonialTilts = () => {
      document.querySelectorAll('[data-testimonials-grid]').forEach(initTestimonialTilt);
   };

   initAllTestimonialTilts();
   document.addEventListener('astro:page-load', initAllTestimonialTilts);
</script>
