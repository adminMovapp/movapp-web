---
// CTA de cierre de la página, según la revisión de estructura semántica
// (Angel Martínez): H2 + <p> descriptivo + <a> (no <button>, redirige a una
// conversación externa de WhatsApp) con id "whatsapp-testimonios-cta" --
// mismo patrón de nombre "whatsapp-<página>-<sección>" que el resto de los
// CTAs de WhatsApp del sitio (ver Home/ElHackHero.astro/ElHackCTA.astro).
//
// "Mismo diseño LITERAL que el botón de Home" a pedido: se reutiliza
// ButtonContact.astro tal cual (mismo componente, mismo estilo/ícono/
// animación en todo el sitio) en vez de construir un botón nuevo -- solo
// cambian label, id y el mensaje precargado de WhatsApp (prop "message",
// agregado a ButtonContact.astro para esto sin tocar su diseño).
//
// Pendiente de validación (ver anotación original): la URL de destino de
// WhatsApp. Por ahora usa el mismo número que el resto del sitio
// (URLS.whatsapp.principal, vía ButtonContact.astro) -- swap directo si el
// número/URL de testimonios termina siendo distinto.
import StarField from '@components/decorative/StarField.astro';
import ButtonContact from '@components/ui/ButtonContact.astro';
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4 text-center" data-aos="fade-up">
   <StarField id="testimonials-cta" ambientCount={30} />

   <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¿Quieres compartir tu experiencia?
   </h2>
   <p class="mx-auto mt-4 max-w-xl text-gray-700 dark:text-white/80">
      Si Movapp te ayudó, tu historia puede darle esperanza a alguien más. Escríbenos y cuéntanos tu caso.
   </p>

   <div class="mt-8 flex justify-center">
      <ButtonContact
         id="whatsapp-testimonios-cta"
         label="Compartir mi experiencia"
         message="¡Hola! Quiero compartir mi experiencia con Movapp."
      />
   </div>
</section>
