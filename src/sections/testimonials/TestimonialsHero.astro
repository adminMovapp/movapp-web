---
// H1 (único H1 de la página). Sin doc maestro de SEO para esta página
// todavía (a diferencia de Home/El Hack) -- copy propio, a pedido
// ("sorpréndeme"), pensado alrededor de la metáfora visual de abajo: "de la
// tormenta a la calma", el mismo viaje emocional que cuenta cada testimonio.
//
// Fondo: StormField (rayos/niebla, el mismo que usan las secciones de
// El Hack) y StarField (estrellas/calma, el resto del sitio) superpuestos en
// el mismo contenedor, cada uno con su propia animación de opacidad en
// contrafase (ver <style>) -- un ciclo lento y perpetuo de tormenta
// disolviéndose en cielo estrellado y de vuelta, en vez de una animación de
// una sola vez: encaja con el resto del sitio, donde todo el fondo decorativo
// es ambiente en loop (StarField, StormField, el marquee de colaboraciones),
// nunca una narrativa de una sola pasada.
import StormField from '@components/decorative/StormField.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto flex min-h-[60vh] max-w-4xl flex-col items-center justify-center px-4 pt-16 text-center md:min-h-[55vh] md:pt-8">
   <div class="testimonials-weather-layer testimonials-storm-layer absolute inset-0 -z-10" aria-hidden="true">
      <StormField id="testimonials-hero-storm" boltCount={4} />
   </div>
   <div class="testimonials-weather-layer testimonials-calm-layer absolute inset-0 -z-10" aria-hidden="true">
      <StarField id="testimonials-hero-calm" ambientCount={45} />
   </div>

   <h1 class="mx-auto max-w-3xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
      De <span class="text-text_banner">la</span> tormenta <span class="text-text_banner">a</span> la <span class="text-text_banner">tranquilidad</span>
   </h1>
   <p class="mx-auto mt-5 max-w-xl text-gray-700 dark:text-white/80">
      Después de la tormenta, siempre puede volver la calma. Estas son historias reales de personas que lo lograron.
   </p>
</section>

<style>
   /*
      Contrafase: mientras una capa entra la otra sale, con un tramo de
      "meseta" (0-35% / 55-95%) en cada extremo para que se lea como un
      estado estable, no un parpadeo constante -- mismo criterio de ritmo
      lento que storm-fog (26-32s) en StormField.astro, pero un poco más
      corto (18s) por ser la pieza protagonista del hero, no fondo ambiente
      de una sección de contenido.
   */
   .testimonials-weather-layer {
      will-change: opacity;
   }
   .testimonials-storm-layer {
      animation: testimonialsWeatherStorm 18s ease-in-out infinite;
   }
   .testimonials-calm-layer {
      animation: testimonialsWeatherCalm 18s ease-in-out infinite;
   }

   @keyframes testimonialsWeatherStorm {
      0%,
      35% {
         opacity: 1;
      }
      55%,
      95% {
         opacity: 0;
      }
      100% {
         opacity: 1;
      }
   }
   @keyframes testimonialsWeatherCalm {
      0%,
      35% {
         opacity: 0;
      }
      55%,
      95% {
         opacity: 1;
      }
      100% {
         opacity: 0;
      }
   }

   /*
      Excepción a la regla global de prefers-reduced-motion (ver
      global.css), mismo criterio ya documentado en StormField.astro/
      StarField.astro: es puramente decorativo, no compite con contenido
      real. Sin esto, la regla global congelaría el ciclo a mitad de
      transición (tormenta y calma superpuestas a medias) en vez de dejarlo
      seguir su curso.
   */
   @media (prefers-reduced-motion: reduce) {
      .testimonials-storm-layer {
         animation-duration: 18s !important;
         animation-iteration-count: infinite !important;
      }
      .testimonials-calm-layer {
         animation-duration: 18s !important;
         animation-iteration-count: infinite !important;
      }
   }
</style>
