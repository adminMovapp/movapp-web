---
// Tarjetas gris planas (mismo estilo que la card del buscador en
// DirectorioBuscador.astro, no el card con borde/degradado morado del grid
// de apps) -- así se ve en el mockup: bloques de info neutros, distintos del
// card de "app con ícono" que sí usa el tratamiento morado en otro lado de
// esta misma página.
const INFO_CARDS = [
   { title: 'Desarrollador', text: 'Financiera CrediSeguro S.A. de C.V.' },
   { title: 'Registro CONDUSEF', text: 'Localizada · folio 00234' },
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Información disponible sobre CrediSeguro
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
         INFO_CARDS.map((card) => (
            <li class="rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
               <h3 class="font-bold text-text_banner">{card.title}</h3>
               <p class="mt-2 text-sm italic text-gray-600 dark:text-white/70">{card.text}</p>
            </li>
         ))
      }
   </ul>
</section>
