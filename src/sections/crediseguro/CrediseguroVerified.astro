---
import StarField from '@components/decorative/StarField.astro';

const reasons = [
   { title: 'Registro vigente', text: 'Localizada en el registro de CONDUSEF a la fecha de revisión.' },
   { title: 'Aviso de privacidad publicado', text: 'Disponible en el sitio oficial identificado.' },
   { title: 'Condiciones visibles antes de contratar', text: 'Tasas y comisiones publicadas previo a la aceptación.' },
];
---

<section class="relative mx-auto my-16 w-full max-w-3xl px-4" data-aos="fade-up">
   <StarField id="crediseguro-verified" />

   <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl md:text-4xl font-bold uppercase text-gray-900 dark:text-white">
         ¿Por qué se considera verificada?
      </h2>
   </div>

   <div class="mt-10 flex flex-col gap-4">
      {
         reasons.map((item, i) => (
            <div
               class="float-anim rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30"
               style={`--float-dur: ${5.6 + i * 0.3}s; --float-delay: ${i * 0.2}s;`}
            >
               <h3 class="font-bold text-text_banner dark:text-text_banner">{item.title}</h3>
               <p class="mt-1 text-sm text-gray-600 dark:text-white/70">{item.text}</p>
            </div>
         ))
      }
   </div>
</section>
