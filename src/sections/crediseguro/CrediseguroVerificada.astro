---
// Tarjetas transparentes + StarField (2026-09-01, a pedido) -- mismo
// criterio que CrediseguroInfo.astro.
import StarField from '@components/decorative/StarField.astro';

const VERIFIED_REASONS = [
   {
      title: 'Registro vigente',
      text: 'Localizada en el registro de CONDUSEF a la fecha de revisión.',
   },
   {
      title: 'Aviso de privacidad publicado',
      text: 'Disponible en el sitio oficial identificado.',
   },
   {
      title: 'Condiciones visibles antes de contratar',
      text: 'Tasas y comisiones publicadas previo a la aceptación.',
   },
];
---

<section class="relative mx-auto my-section w-full max-w-4xl px-4" data-aos="fade-up">
   <StarField id="crediseguro-verificada" ambientCount={40} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¿Por qué se considera verificada?
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
         VERIFIED_REASONS.map((reason) => (
            <li class="rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-6 text-center dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30">
               <h3 class="font-bold text-text_banner">{reason.title}</h3>
               <p class="mt-2 text-sm italic text-gray-600 dark:text-white/70">{reason.text}</p>
            </li>
         ))
      }
   </ul>
</section>
