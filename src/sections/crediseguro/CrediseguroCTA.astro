---
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-16 w-full max-w-3xl px-4" data-aos="fade-up">
   <StarField id="crediseguro-cta" />

   <div
      class="float-anim rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-8 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-10"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <div class="flex flex-col items-center gap-5">
         <h2 class="text-2xl md:text-3xl font-bold uppercase text-gray-900 dark:text-white">
            ¿Necesitas orientación sobre CrediSeguro?
         </h2>
         <p class="max-w-md text-sm md:text-base text-gray-600 dark:text-white/80">
            Si necesitas orientación antes de contratar o tienes preguntas sobre sus condiciones, podemos ayudarte.
         </p>
         <div class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row">
            <a
               href="/directorio-de-apps/"
               class="inline-flex w-full items-center justify-center rounded-full border-2 border-purple_mv px-6 py-4 text-base font-bold text-text_banner transition hover:bg-purple_mv hover:text-white dark:border-white/20 sm:w-auto"
            >
               Ver todas las apps
            </a>
            <ButtonContact id="cta_whatsapp_crediseguro_final_02" label="Solicitar orientación" />
         </div>
      </div>
   </div>
</section>
