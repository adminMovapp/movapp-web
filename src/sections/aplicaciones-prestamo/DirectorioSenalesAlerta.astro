---
import { WARNING_SIGNS } from '@constants/directorioApps.ts';
import StarField from '@components/decorative/StarField.astro';
---

<section id="directorio-senales-alerta" class="relative mx-auto my-section w-full max-w-2xl scroll-mt-28 px-4" data-aos="fade-up">
   <StarField id="directorio-senales-alerta-field" ambientCount={35} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Señales de alerta en una app de préstamos
   </h2>

   <!--
      Card transparente estándar (antes: píldora rounded-full + fondo plano
      bg-purple_mv/5, distinta al resto del sitio) -- a pedido, 2026-09-02:
      "estandariza... deja todas las cards con el diseño que ya tenemos".

      Animación de entrada (2026-09-02, segunda vuelta a pedido explícito:
      "dije que cada sección tenga una diferente" -- UNA sola animación
      para TODA esta sección, distinta a la de "¿Cómo identificamos...?"
      -- y "más llamativo... no me gusta que se vean como simples cards"):
      giro 3D de -100° a 0° ("alerta-card", clase local, ver <style>
      abajo), desfasado por índice (--reveal-delay) para que las 6 cards
      giren en cascada. (Se probó además un halo continuo tipo
      "respiración" después de aparecer -- se sacó a pedido: "no pongas el
      destello/color en la card, sólo deja la animación de cuando se
      muestran".)
   -->
   <ul class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
      {
         WARNING_SIGNS.map((label, i) => (
            <li
               class="alerta-card rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent px-5 py-3 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30"
               data-aos="card-flip"
               style={`--reveal-delay: ${i * 90}ms`}
            >
               <span class="font-semibold text-gray-900 dark:text-white">{label}</span>
            </li>
         ))
      }
   </ul>
</section>

<style>
   li.alerta-card[data-aos] {
      opacity: 0;
      transform: perspective(1000px) rotateY(-100deg);
      transition: none;
   }
   li.alerta-card[data-aos].aos-animate {
      opacity: 1;
      transform: none;
      animation: alertaCardFlip 0.85s cubic-bezier(0.2, 0.65, 0.3, 1) forwards;
      animation-delay: var(--reveal-delay, 0s);
   }
   @keyframes alertaCardFlip {
      0% {
         opacity: 0;
         transform: perspective(1000px) rotateY(-100deg);
      }
      50% {
         opacity: 1;
      }
      100% {
         opacity: 1;
         transform: perspective(1000px) rotateY(0deg);
      }
   }

   @media (prefers-reduced-motion: reduce) {
      li.alerta-card[data-aos].aos-animate {
         animation: none;
      }
   }
</style>
