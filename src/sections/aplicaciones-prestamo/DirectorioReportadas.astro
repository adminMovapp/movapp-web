---
// Grid de apps con reportes verificados. Los íconos ya llegaron (ver
// DIRECTORIO_ICONS en directorioApps.ts) -- "alt" vacío a propósito: cada
// ícono es puramente redundante con el nombre de la app que ya está en el
// <h3> de al lado (ver skill Importaciones, excepción de "íconos
// redundantes con texto visible junto a ellos").
import { Image } from 'astro:assets';
import { REPORTED_APPS, DIRECTORIO_ICONS } from '@constants/directorioApps.ts';
import StarField from '@components/decorative/StarField.astro';
---

<section id="directorio-reportadas" class="relative mx-auto my-section w-full max-w-5xl scroll-mt-28 px-4" data-aos="fade-up">
   <StarField id="directorio-reportadas-field" ambientCount={45} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Apps de préstamos reportadas
   </h2>
   <p class="mx-auto mt-4 max-w-2xl text-center text-gray-700 dark:text-white/80">
      Revisa el historial de apps con reportes verificados por extorsión o cobros indebidos. Detecta señales de riesgo
      al instante y aprende qué hacer para bloquear el acoso, resguardar tus contactos y presentar tu denuncia ante las
      autoridades.
   </p>

   <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
         REPORTED_APPS.map((app) => (
            <li class="flex flex-col items-center rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-center shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30">
               {DIRECTORIO_ICONS[app.slug] && (
                  <div class="mb-3 flex h-14 w-14 items-center justify-center overflow-hidden rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5">
                     <Image src={DIRECTORIO_ICONS[app.slug]} alt="" width={112} class="h-full w-full object-contain p-2" loading="lazy" />
                  </div>
               )}
               <h3 class="text-lg font-bold text-text_banner">{app.name}</h3>
               <p class="mt-2 text-sm font-semibold text-red-500">✓ {app.status}</p>
               <a
                  href={`/aplicaciones-prestamo/${app.slug}`}
                  class="mt-3 text-sm font-semibold text-text_banner underline-offset-4 hover:underline"
               >
                  Ver información
               </a>
            </li>
         ))
      }
   </ul>
</section>
