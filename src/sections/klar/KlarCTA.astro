---
import ButtonContact from '@components/ui/ButtonContact.astro';
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4" data-aos="fade-up">
   <div class="rounded-3xl bg-gray-100 p-8 text-center dark:bg-white/5 md:p-10">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         ¿Necesitas orientación sobre Klar?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-gray-700 dark:text-white/80">
         Si necesitas orientación antes de contratar o tienes preguntas sobre sus condiciones, podemos ayudarte.
      </p>
      <div class="mt-6 flex justify-center">
         <ButtonContact id="whatsapp-klar-cta" label="Solicitar orientación" message="¡Hola! Quiero orientación sobre Klar." />
      </div>
   </div>
</section>
