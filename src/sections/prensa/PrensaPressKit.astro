---
// Recursos oficiales. Los archivos reales (logotipos vectoriales,
// fotos de portavoces, dossier en PDF) todavía no existen en /public -- los
// botones quedan deshabilitados con un estado "Próximamente" en vez de
// apuntar a un archivo inexistente (404) o mostrar un tamaño de archivo
// inventado (ver @constants/prensa.ts).
import StarField from '@components/decorative/StarField.astro';
import { PRESS_KIT_ITEMS } from '@constants/prensa.ts';

const RESOURCE_ICONS: Record<string, string> = {
   'kit-identidad': 'M12 2l3 6 6 .9-4.5 4.4 1 6.2L12 16.9 6.5 19.5l1-6.2L3 8.9 9 8z',
   'kit-fotografia': 'M4 8h3l1.5-2h7L17 8h3a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1zM12 12a3 3 0 100 6 3 3 0 000-6z',
   'kit-dossier': 'M6 3h9l5 5v13a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1zM14 3v5h5M9 13h6M9 17h6M9 9h2',
};
---

<section class="relative mx-auto mt-16 w-full max-w-5xl px-4 md:mt-20">
   <!-- Antes esta sección no tenía ningún fondo decorativo propio (a
        diferencia del resto de la página), por eso se leía como un bloque
        negro plano pegado justo debajo de PrensaMediaGrid.astro -- mismo
        StarField que usan las demás secciones, cuyo resplandor superior
        además se mezcla con el de la sección de arriba (ver comentario de
        cabecera de StarField.astro) y así queda una transición real entre
        ambas en vez de un corte duro. -->
   <StarField id="prensa-press-kit" ambientCount={20} />

   <div
      class="pointer-events-none absolute left-1/2 top-24 -z-10 h-[300px] w-[300px] -translate-x-1/2 rounded-full bg-purple_mv/20 blur-[120px]"
      aria-hidden="true"
   />

   <h2 class="gradient-text-move mx-auto max-w-2xl bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-center text-2xl font-bold uppercase text-transparent dark:from-white dark:to-purple_mv md:text-3xl">
      Recursos oficiales
   </h2>
   <p class="mx-auto mt-3 max-w-xl text-center text-sm text-gray-600 dark:text-white/60">
      Centro de descargas para periodistas y aliados. Los archivos se están preparando -- vuelve pronto.
   </p>

   <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
         PRESS_KIT_ITEMS.map((item) => (
            <div class="glass-card flex flex-col justify-between overflow-hidden rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-6 shadow-card transition-shadow duration-300 hover:border-purple_mv/45 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.12] dark:to-black/20 dark:hover:border-white/25">
               <div>
                  <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full border border-purple_mv/30 bg-purple_mv/20 text-purple_mv dark:border-purple_mv/40 dark:bg-purple_mv/25 dark:text-purple-300">
                     <svg class="h-5 w-5 drop-shadow-[0_0_8px_rgba(147,51,234,0.35)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path d={RESOURCE_ICONS[item.id]} stroke-linecap="round" stroke-linejoin="round" />
                     </svg>
                  </div>
                  <h3 class="mt-4 text-lg font-bold text-gray-900 dark:text-white">{item.title}</h3>
                  <p class="mt-2 text-sm text-gray-600 dark:text-white/60">{item.detail}</p>
               </div>

               <div class="mt-6">
                  <p class="font-mono text-[11px] uppercase tracking-wider text-purple_mv dark:text-purple-300/70">
                     archivo // pendiente de carga
                  </p>
                  <button
                     type="button"
                     disabled
                     aria-disabled="true"
                     class="mt-2 flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-full border border-purple_mv/30 bg-purple_mv/5 px-4 py-2.5 text-sm font-bold text-purple_mv/70 dark:border-purple_mv/30 dark:bg-purple_mv/5 dark:text-purple_mv/60"
                  >
                     <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" stroke-linecap="round" stroke-linejoin="round" />
                     </svg>
                     Próximamente
                  </button>
               </div>
            </div>
         ))
      }
   </div>
</section>
