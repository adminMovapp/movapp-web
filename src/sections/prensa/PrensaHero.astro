---
// Hero de /prensa: mismo fondo que el resto del Home (StarField, igual que
// TestimonialsHero.astro -- el hero de Home es el único con fondo propio
// hand-rolled, ver comentario de cabecera de StarField.astro) + badge HUD +
// H1 limpio (SEO) con una línea de tagline aparte (no es un segundo
// encabezado) + barra de búsqueda/filtro que controla la grilla de medios de
// PrensaMediaGrid.astro más abajo en la página (comunicación cross-componente
// por atributos data-* + querySelector, mismo criterio que el resto del
// sitio -- ver CartContext/Header para el equivalente con CustomEvents).
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { PRESS_FILTERS } from '@constants/prensa.ts';
---

<section class="relative mx-auto flex flex-col items-center px-4 pt-16 text-center md:pt-8">
   <StarField id="prensa-hero" ambientCount={60} />

   <Breadcrumbs />

   <!-- Badge HUD: punto parpadeante + texto tipo telemetría, borde ultra-fino -->
   <div
      class="glass-card inline-flex items-center gap-2 rounded-full border border-purple_mv/30 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-purple_mv dark:border-white/10 dark:text-white/80"
   >
      <span class="press-live-dot relative flex h-2 w-2">
         <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple_mv opacity-75"></span>
         <span class="relative inline-flex h-2 w-2 rounded-full bg-purple_mv"></span>
      </span>
      Sala de prensa // transmisión oficial
   </div>

   <h1
      class="mx-auto mt-5 max-w-3xl text-4xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-6xl"
   >
      <span class="gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         Sala de Prensa
      </span>
   </h1>

   <!-- Tagline cinematográfico: NO es un h2 (evita saltar de nivel/duplicar
        la jerarquía de encabezados) -- es un párrafo de apoyo con el mismo
        tratamiento de glow morado que el resto del sitio. -->
   <p class="mx-auto mt-3 max-w-2xl text-lg font-semibold text-text_banner drop-shadow-[0_0_25px_rgba(129,73,226,0.35)] md:text-xl">
      La verdad detrás de las sombras digitales
   </p>

   <p class="mx-auto mt-4 max-w-xl text-base text-gray-700 dark:text-white/70">
      Más de <strong class="font-bold text-text_banner">5,000 personas</strong> ya usan El Hack para frenar el acoso de
      apps de préstamo. Aquí reunimos nuestros comunicados oficiales, apariciones en medios y recursos para
      periodistas y aliados.
   </p>

   <!-- Buscador / filtro táctico -->
   <div class="mt-8 w-full max-w-2xl">
      <div class="glass-card flex items-center gap-3 rounded-2xl border border-purple_mv/25 px-4 py-3 transition focus-within:border-purple_mv dark:border-white/10">
         <svg class="h-5 w-5 flex-shrink-0 text-purple_mv" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M21 21l-4.35-4.35" stroke-linecap="round"></path>
         </svg>
         <input
            id="press-search-input"
            type="search"
            placeholder="Buscar en comunicados y apariciones..."
            class="w-full bg-transparent text-sm text-gray-900 outline-none placeholder:text-gray-500 dark:text-white dark:placeholder:text-white/40"
            aria-label="Buscar en la sala de prensa"
         />
      </div>

      <div id="press-filter-bar" class="mt-3 flex flex-wrap justify-center gap-2">
         {
            PRESS_FILTERS.map((filter, i) => (
               <button
                  type="button"
                  data-press-filter={filter}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  class:list={[
                     'press-filter-chip rounded-full border px-4 py-1.5 text-xs font-semibold uppercase tracking-wide transition',
                     i === 0
                        ? 'border-purple_mv bg-purple_mv/15 text-purple_mv dark:text-white'
                        : 'border-purple_mv/20 text-gray-600 hover:border-purple_mv/50 dark:border-white/10 dark:text-white/60',
                  ]}
               >
                  {filter}
               </button>
            ))
         }
      </div>
   </div>
</section>

<style>
   .press-live-dot {
      /* animate-ping ya trae su propia animación de Tailwind -- sin estilos
         extra necesarios acá, la clase queda solo como ancla semántica. */
   }
</style>

<script>
   // Filtro cliente-side de la grilla de medios (PrensaMediaGrid.astro, más
   // abajo en la misma página): las tarjetas se marcan con data-press-card +
   // data-press-category; este script vive en el Hero (donde están los
   // controles) y opera sobre document, no sobre un contenedor propio --
   // mismo patrón cross-componente que StarField.astro (clases/atributos
   // compartidos, sin acoplar los dos componentes entre sí).
   function initPressFilters() {
      const bar = document.getElementById('press-filter-bar');
      const searchInput = document.getElementById('press-search-input') as HTMLInputElement | null;
      if (!bar || bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      let activeCategory = 'Todos';

      function applyFilters() {
         const query = (searchInput?.value ?? '').trim().toLowerCase();
         const cards = document.querySelectorAll<HTMLElement>('[data-press-card]');
         cards.forEach((card) => {
            const category = card.dataset.pressCategory ?? '';
            const label = (card.dataset.pressLabel ?? '').toLowerCase();
            const matchesCategory = activeCategory === 'Todos' || category === activeCategory;
            const matchesQuery = query === '' || label.includes(query) || category.toLowerCase().includes(query);
            card.classList.toggle('hidden', !(matchesCategory && matchesQuery));
         });
      }

      bar.querySelectorAll<HTMLButtonElement>('[data-press-filter]').forEach((chip) => {
         chip.addEventListener('click', () => {
            activeCategory = chip.dataset.pressFilter ?? 'Todos';
            bar.querySelectorAll<HTMLButtonElement>('[data-press-filter]').forEach((c) => {
               const isActive = c === chip;
               c.setAttribute('aria-pressed', String(isActive));
               c.classList.toggle('border-purple_mv', isActive);
               c.classList.toggle('bg-purple_mv/15', isActive);
               c.classList.toggle('text-purple_mv', isActive);
               c.classList.toggle('border-purple_mv/20', !isActive);
            });
            applyFilters();
         });
      });

      searchInput?.addEventListener('input', applyFilters);
   }

   initPressFilters();
   document.addEventListener('astro:page-load', initPressFilters);
</script>
