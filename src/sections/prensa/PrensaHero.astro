---
// Hero de /prensa: mismo fondo que el resto del sitio (StarField, igual que
// TestimonialsHero.astro) + badge HUD + H1. Sin copy de apoyo a propósito:
// la página es solo la "transmisión" de vídeos de PrensaBroadcast.astro, que
// arranca justo debajo.
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
---

<section class="relative mx-auto flex flex-col items-center px-4 pt-16 text-center md:pt-8">
   <StarField id="prensa-hero" ambientCount={60} />

   <Breadcrumbs />

   <div
      class="glass-card inline-flex items-center gap-2 rounded-full border border-purple_mv/30 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.2em] text-purple_mv dark:border-white/10 dark:text-white/80"
   >
      <span class="relative flex h-2 w-2" aria-hidden="true">
         <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-500 opacity-75"></span>
         <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
      </span>
      Movapp en los medios
   </div>

   <h1 class="mx-auto mt-5 max-w-3xl text-4xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-6xl">
      <span class="gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         Sala de Prensa
      </span>
   </h1>
</section>
