---
// Muro de apariciones en medios. Sin datos reales todavía (ver
// @constants/prensa.ts -- decisión explícita de no inventar logos/nombres de
// medios reales): cada tarjeta es un placeholder visualmente distinto de una
// mención real (borde punteado, "Espacio reservado") para que nadie lo
// confunda con cobertura confirmada. Filtrable desde la barra de
// búsqueda/chips de PrensaHero.astro vía data-press-card/data-press-category.
import StarField from '@components/decorative/StarField.astro';
import { PRESS_MENTIONS_PLACEHOLDER } from '@constants/prensa.ts';

const CATEGORY_ICONS: Record<string, string> = {
   Televisión: 'M4 5h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1zM8 21h8M12 17v4',
   'Prensa escrita': 'M4 4h16v16H4V4zM8 8h8M8 12h8M8 16h5',
   Radio: 'M4 10h16v10H4V10zM8 10V6l8-2v6M8 15h.01M12 15a2 2 0 11-4 0 2 2 0 014 0z',
   'Medios digitales': 'M12 3v3m0 12v3m9-9h-3M6 12H3m14.5-6.5l-2.1 2.1M8.6 15.4l-2.1 2.1m11-2.1l-2.1-2.1M8.6 8.6L6.5 6.5',
};
---

<section class="relative mx-auto mt-16 w-full max-w-5xl px-4 md:mt-20">
   <StarField id="prensa-media-grid" ambientCount={30} />

   <h2 class="gradient-text-move mx-auto max-w-2xl bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-center text-2xl font-bold uppercase text-transparent dark:from-white dark:to-purple_mv md:text-3xl">
      Apariciones en medios
   </h2>
   <p class="mx-auto mt-3 max-w-xl text-center text-sm text-gray-600 dark:text-white/60">
      Iremos sumando aquí cada aparición confirmada de Movapp en televisión, prensa escrita, radio y medios
      digitales.
   </p>

   <div id="pressMediaGrid" class="reveal-stagger mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
         PRESS_MENTIONS_PLACEHOLDER.map((mention) => (
            <div
               data-press-card
               data-press-category={mention.category}
               data-press-label={mention.placeholderLabel}
               class="press-media-card group relative flex flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-purple_mv/30 bg-gradient-to-b from-purple_mv/[0.08] to-white/40 p-8 text-center backdrop-blur-sm transition-all duration-300 hover:border-purple_mv/60 hover:shadow-[0_0_25px_rgba(147,51,234,0.2)] hover:-translate-y-1 dark:border-white/15 dark:from-purple_mv/[0.1] dark:to-neutral-900/90 dark:hover:border-purple_mv/60"
            >
               <div class="press-media-glow pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true" />

               <div class="relative flex h-12 w-12 items-center justify-center rounded-full border border-purple_mv/30 bg-purple_mv/15 text-purple_mv dark:border-purple_mv/40 dark:bg-purple_mv/20 dark:text-purple-300">
                  <svg class="h-6 w-6 drop-shadow-[0_0_8px_rgba(147,51,234,0.35)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                     <path d={CATEGORY_ICONS[mention.category]} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
               </div>

               <span class="relative rounded-full border border-purple_mv/40 bg-purple_mv/20 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-purple_mv dark:border-purple_mv/50 dark:bg-purple_mv/25 dark:text-purple-300">
                  {mention.category}
               </span>
               <p class="relative text-sm text-gray-500 dark:text-white/40">{mention.placeholderLabel}</p>
            </div>
         ))
      }
   </div>

   <p id="press-empty-state" class="mt-8 hidden text-center text-sm text-gray-500 dark:text-white/50">
      No encontramos resultados para tu búsqueda.
   </p>
</section>

<style>
   .press-media-glow {
      background: radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%), rgba(147, 51, 234, 0.28), transparent 70%);
   }
</style>

<script>
   // Glow posicional en hover, mismo criterio que PrensaSpotlight.astro (solo
   // puntero fino) -- acá con un solo listener delegado en el grid en vez de
   // uno por tarjeta, ya que pueden ser muchas.
   function initMediaGlow() {
      const grid = document.getElementById('pressMediaGrid');
      if (!grid || grid.dataset.glowReady === 'true') return;
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      if (!canHover) return;
      grid.dataset.glowReady = 'true';

      grid.addEventListener('mousemove', (e) => {
         const card = (e.target as HTMLElement).closest<HTMLElement>('.press-media-card');
         if (!card) return;
         const rect = card.getBoundingClientRect();
         const glow = card.querySelector<HTMLElement>('.press-media-glow');
         if (!glow) return;
         glow.style.setProperty('--mx', `${((e.clientX - rect.left) / rect.width) * 100}%`);
         glow.style.setProperty('--my', `${((e.clientY - rect.top) / rect.height) * 100}%`);
      });
   }

   // Entrada escalonada (mismo patrón que NosotrosTimeline.astro: .reveal-stagger + IntersectionObserver)
   function initGridReveal() {
      const grid = document.getElementById('pressMediaGrid');
      if (!grid) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
         grid.classList.add('in-view');
         return;
      }
      const io = new IntersectionObserver(
         (entries) => {
            entries.forEach((entry) => {
               if (entry.isIntersecting) {
                  entry.target.classList.add('in-view');
                  io.unobserve(entry.target);
               }
            });
         },
         { threshold: 0.15 },
      );
      io.observe(grid);
   }

   // Muestra el mensaje de "sin resultados" cuando el filtro de PrensaHero.astro
   // oculta todas las tarjetas -- observa cambios de clase en vez de acoplarse
   // al script del filtro.
   function initEmptyState() {
      const grid = document.getElementById('pressMediaGrid');
      const emptyState = document.getElementById('press-empty-state');
      if (!grid || !emptyState) return;

      const update = () => {
         const cards = grid.querySelectorAll('[data-press-card]');
         const allHidden = Array.from(cards).every((c) => c.classList.contains('hidden'));
         emptyState.classList.toggle('hidden', !allHidden);
      };

      const observer = new MutationObserver(update);
      grid.querySelectorAll('[data-press-card]').forEach((card) => {
         observer.observe(card, { attributes: true, attributeFilter: ['class'] });
      });
      update();
   }

   initMediaGlow();
   initGridReveal();
   initEmptyState();
   document.addEventListener('astro:page-load', () => {
      initMediaGlow();
      initGridReveal();
      initEmptyState();
   });
</script>
