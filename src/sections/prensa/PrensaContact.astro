---
// Línea directa para periodistas: WhatsApp (ButtonContact, mismo componente
// de todo el sitio) + botón de copiar el correo institucional de prensa, con
// feedback animado -- mismo patrón de navigator.clipboard.writeText/try-catch
// que BlogArticleShare.astro usa para "copiar enlace".
import ButtonContact from '@components/ui/ButtonContact.astro';
import { PRESS_CONTACT_EMAIL } from '@constants/prensa.ts';
---

<section class="relative mx-auto mt-16 w-full max-w-3xl px-4 pb-4 md:mt-20">
   <div class="glass-card rounded-3xl border border-purple_mv/25 p-6 text-center shadow-card dark:border-white/10 md:p-10">
      <h2 class="gradient-text-move mx-auto max-w-xl bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-2xl font-bold uppercase text-transparent dark:from-white dark:to-purple_mv md:text-3xl">
         ¿Eres periodista o medio de comunicación?
      </h2>
      <p class="mx-auto mt-3 max-w-lg text-gray-700 dark:text-white/70">
         Conecta con nuestro equipo de prensa y te respondemos a la brevedad.
      </p>

      <div class="mt-6 flex flex-col items-center gap-3 md:flex-row md:justify-center">
         <ButtonContact
            id="whatsapp-prensa-contacto"
            label="Hablar con prensa"
            message="¡Hola! Soy periodista/medio de comunicación y quiero más información sobre Movapp."
            pageType="prensa"
            sectionName="contacto_prensa"
            placement="contenido"
         />

         <button
            type="button"
            id="press-copy-email"
            data-email={PRESS_CONTACT_EMAIL}
            class="inline-flex items-center gap-3 rounded-full border border-purple_mv/30 bg-transparent px-6 py-4 text-base font-bold text-purple_mv transition hover:border-purple_mv hover:bg-purple_mv/10 dark:border-white/15 dark:text-white"
         >
            <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
               <path d="M4 4h16v16H4V4zM4 6l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span data-copy-label>{PRESS_CONTACT_EMAIL}</span>
         </button>
      </div>
   </div>
</section>

<script>
   function initCopyEmail() {
      const button = document.getElementById('press-copy-email');
      const label = button?.querySelector<HTMLElement>('[data-copy-label]');
      if (!button || !label || button.dataset.copyReady === 'true') return;
      button.dataset.copyReady = 'true';

      const email = button.dataset.email ?? '';
      const originalText = label.textContent ?? email;
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener('click', async () => {
         try {
            await navigator.clipboard.writeText(email);
            label.textContent = '¡Copiado al portapapeles!';
         } catch {
            // Clipboard no disponible -- el correo ya está visible en el botón.
            return;
         }
         clearTimeout(resetTimer);
         resetTimer = setTimeout(() => {
            label.textContent = originalText;
         }, 2000);
      });
   }

   initCopyEmail();
   document.addEventListener('astro:page-load', initCopyEmail);
</script>
