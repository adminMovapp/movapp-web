---
// Nota destacada / spotlight: tarjeta grande con efecto tilt 3D al mover el
// cursor (solo escritorio, con puntero fino -- en móvil no hay cursor que
// mover). Contenido propio de Movapp (NO una supuesta cobertura de un medio
// externo -- no hay ninguna aparición en medios confirmada todavía, ver
// @constants/prensa.ts), reutilizando el mismo dato real que ya usa
// HomeHero.astro ("5000+ Descargas") en vez de inventar una cifra nueva.
const currentLabel = new Date().toLocaleDateString('es-MX', { year: 'numeric', month: 'long' });
---

<section class="relative mx-auto mt-16 w-full max-w-5xl px-4 md:mt-20">
   <div
      id="press-spotlight-card"
      class="press-tilt-card glass-card group relative overflow-hidden rounded-3xl border border-purple_mv/25 p-6 shadow-card transition-shadow duration-300 hover:shadow-card-hover dark:border-white/10 md:p-10"
   >
      <!-- Glow que sigue al cursor (radial-gradient posicional, controlado por --mx/--my vía JS) -->
      <div class="press-tilt-glow pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true"></div>

      <div class="relative grid gap-6 md:grid-cols-[1fr_auto] md:items-center md:gap-10">
         <div>
            <div class="flex flex-wrap items-center gap-3">
               <span class="rounded-full border border-purple_mv/40 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-purple_mv dark:text-white">
                  Actualización oficial
               </span>
               <span class="font-mono text-xs text-gray-500 dark:text-white/50">{currentLabel}</span>
            </div>

            <h2 class="gradient-text-move mt-4 bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-2xl font-bold uppercase text-transparent dark:from-white dark:to-purple_mv md:text-3xl">
               Movapp ya protege a más de 5,000 personas
            </h2>

            <p class="mt-3 max-w-2xl text-gray-700 dark:text-white/75">
               El Hack detiene las llamadas y mensajes de acoso de apps de préstamo no reguladas, protege a los
               contactos de la víctima y la acompaña con un asesor real por WhatsApp. Esta es la cifra oficial de
               personas que ya usan el servicio -- la seguimos actualizando a medida que crece.
            </p>

            <a
               href="/el-hack/"
               data-cta="prensa_spotlight_conocer_mas"
               data-placement="contenido"
               data-destination-type="internal"
               class="mt-6 inline-flex items-center gap-2 rounded-full border border-purple_mv/40 px-5 py-2.5 text-sm font-bold text-purple_mv transition hover:border-purple_mv hover:bg-purple_mv/10 dark:text-white"
            >
               Conocer El Hack
               <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
               </svg>
            </a>
         </div>

         <div
            class="flex h-28 w-28 flex-shrink-0 items-center justify-center justify-self-center rounded-2xl border border-purple_mv/25 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5 md:h-36 md:w-36"
            aria-hidden="true"
         >
            <span class="text-3xl font-bold text-text_banner drop-shadow-[0_0_20px_rgba(129,73,226,0.4)] md:text-4xl">5,000+</span>
         </div>
      </div>
   </div>
</section>

<style>
   .press-tilt-card {
      transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
      transition: transform 0.15s ease-out;
      will-change: transform;
   }
   .press-tilt-glow {
      background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), rgba(129, 73, 226, 0.25), transparent 70%);
   }
   @media (prefers-reduced-motion: reduce) {
      .press-tilt-card {
         transition: none;
         transform: none !important;
      }
   }
</style>

<script>
   // Tilt 3D + glow posicional -- solo con puntero fino (mouse/trackpad) y
   // sin prefers-reduced-motion, mismo criterio de accesibilidad que el resto
   // de las animaciones "ambientales" del sitio (ver HomeHero.astro).
   function initPressTilt() {
      const card = document.getElementById('press-spotlight-card');
      if (!card || card.dataset.tiltReady === 'true') return;

      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!canHover || reduceMotion) return;

      card.dataset.tiltReady = 'true';
      const MAX_TILT_DEG = 4;

      card.addEventListener('mousemove', (e) => {
         const rect = card.getBoundingClientRect();
         const px = (e.clientX - rect.left) / rect.width;
         const py = (e.clientY - rect.top) / rect.height;

         card.style.setProperty('--tilt-y', `${(px - 0.5) * MAX_TILT_DEG * 2}deg`);
         card.style.setProperty('--tilt-x', `${(0.5 - py) * MAX_TILT_DEG * 2}deg`);
         card.style.setProperty('--mx', `${px * 100}%`);
         card.style.setProperty('--my', `${py * 100}%`);
      });

      card.addEventListener('mouseleave', () => {
         card.style.setProperty('--tilt-x', '0deg');
         card.style.setProperty('--tilt-y', '0deg');
      });
   }

   initPressTilt();
   document.addEventListener('astro:page-load', initPressTilt);
</script>
