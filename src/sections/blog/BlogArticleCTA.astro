---
// CTA de cierre de la plantilla de artículo individual del blog (ver
// src/pages/blog/[articulo].astro) -- copy propio, distinto al de
// BlogCategoryCTA.astro (esa es para el final del listado de una
// categoría completa; ésta para el final de UN artículo). El "id" del
// botón de WhatsApp distingue el origen en GA4, mismo criterio que
// BlogCategoryCTA.astro.
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';

interface Props {
   slug: string;
}
const { slug } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4 text-center" data-aos="fade-up">
   <StarField id={`blog-article-cta-${slug}`} ambientCount={30} />

   <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¿Ya descargaste una app y tienes dudas?
   </h2>

   <p class="relative z-10 mx-auto mt-4 max-w-xl text-base text-gray-700 dark:text-white/80 md:text-lg">
      Podemos orientarte sobre los siguientes pasos según tu caso.
   </p>

   <div class="mt-8 flex justify-center">
      <ButtonContact
         id={`whatsapp-blog-articulo-${slug}`}
         label="Solicitar orientación"
         message="¡Hola! Tengo dudas sobre una app que descargué."
      />
   </div>
</section>
