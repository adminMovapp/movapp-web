---
// CTA de cierre de la plantilla de categoría del blog (ver
// src/pages/blog/[categoria].astro) -- mismo copy en todas las categorías
// (no viene de @constants/blogCategoryPages.ts), solo el "id" del botón de
// WhatsApp cambia por categoría para poder distinguir el origen del CTA en
// GA4 (ver skill Importaciones).
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';

interface Props {
   categorySlug: string;
}
const { categorySlug } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4 text-center" data-aos="fade-up">
   <StarField id={`blog-category-cta-${categorySlug}`} ambientCount={30} />

   <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¿Tienes problemas con una app de préstamos?
   </h2>

   <div class="mt-8 flex justify-center">
      <ButtonContact
         id={`whatsapp-blog-${categorySlug}`}
         label="Solicitar orientación por WhatsApp"
         message="¡Hola! Quiero orientación sobre una app de préstamos."
      />
   </div>
</section>
