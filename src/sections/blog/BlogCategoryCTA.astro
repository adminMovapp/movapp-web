---
// CTA de cierre de la plantilla de categoría del blog (ver
// src/pages/blog/[categoria].astro) -- mismo copy en todas las categorías
// (no viene de @constants/blogCategoryPages.ts), solo el "id" del botón de
// WhatsApp cambia por categoría para poder distinguir el origen del CTA en
// GA4 (ver skill Importaciones).
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';

interface Props {
   categorySlug: string;
}
const { categorySlug } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4" data-aos="fade-up">
   <!-- StarField a nivel de sección (fullBleed), igual que el resto de las secciones de El Hack --
        no adentro de la card, que se vería como una caja de niebla aparte en vez de fondo de página. -->
   <StarField id={`blog-category-cta-${categorySlug}`} ambientCount={30} />

   <!--
      Misma tarjeta "panel" que ElHackCTA.astro/ElHackFeatures.astro
      (rounded-3xl, border-purple_mv/25, mismo degradado, shadow-card, mismo
      padding) -- a pedido, para que este CTA se vea consistente con los
      demás del sitio.
   -->
   <div
      class="float-anim relative rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-8 text-center shadow-card dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-10"
      style="--float-dur: 6.2s; --float-delay: 0s;"
   >
      <div class="relative z-10 flex flex-col items-center gap-5">
         <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
            ¿Tienes problemas con una app de préstamos?
         </h2>

         <ButtonContact
            id={`whatsapp-blog-${categorySlug}`}
            label="Solicitar orientación"
            message="¡Hola! Quiero orientación sobre una app de préstamos."
         />
      </div>
   </div>
</section>
