---
// Grid de artículos reutilizable para la plantilla de categoría del blog
// (ver src/pages/blog/[categoria].astro) -- las dos secciones "Noticias
// recientes" y "Noticias antiguas" son la MISMA estructura (H2 + grid de
// tarjetas), solo cambia el título y la lista de artículos, así que viven en
// un solo componente parametrizado en vez de duplicar el markup dos veces.
//
// A diferencia del carrusel de BlogCategorySection.astro (la sección de
// categorías del /blog general, con 1 solo artículo hoy por categoría), acá
// siempre hay varios artículos de una vez -- se muestra como grid estático
// (sin scroll horizontal ni "Desliza para ver más"), apilado en móvil y de
// hasta 3 columnas en escritorio.
import { Image } from 'astro:assets';
import ImagePlaceholder from '@components/ui/ImagePlaceholder.astro';
import StarField from '@components/decorative/StarField.astro';
import { BLOG_IMAGES } from '@constants/blogImages.ts';

interface Article {
   slug: string;
   title: string;
}
interface Props {
   id: string;
   title: string;
   articles: Article[];
}
const { id, title, articles } = Astro.props;
---

<section class="relative mx-auto my-section w-full max-w-5xl px-4" data-aos="fade-up">
   <StarField id={`blog-articles-${id}`} ambientCount={45} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      {title}
   </h2>

   <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
         articles.map((a) => (
            <li class="overflow-hidden rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 text-left shadow-card transition-colors duration-300 hover:border-purple_mv/50 hover:shadow-card-hover dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30">
               {BLOG_IMAGES[a.slug] ? (
                  <Image src={BLOG_IMAGES[a.slug]} alt={a.title} width={700} class="aspect-[16/9] w-full rounded-xl object-cover" loading="lazy" />
               ) : (
                  <ImagePlaceholder class="aspect-[16/9] w-full" />
               )}
               <h3 class="mt-4 font-bold text-purple_mv">{a.title}</h3>
               <a href={`/blog/${a.slug}`} class="mt-2 inline-block text-sm font-medium text-gray-900 dark:text-white underline">
                  Ver noticia
               </a>
            </li>
         ))
      }
   </ul>
</section>
