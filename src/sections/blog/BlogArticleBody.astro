---
// Cuerpo del artículo (párrafos) + tarjeta de bio del equipo autor. Mismo
// contenedor angosto que BlogArticleHero.astro (max-w-3xl) para que el
// texto se lea cómodo en una sola columna, en vez de estirarse a todo el
// ancho de la página.
interface Props {
   paragraphs: string[];
   authorBio: { name: string; text: string };
}
const { paragraphs, authorBio } = Astro.props;
---

<section class="relative mx-auto max-w-3xl px-4" data-aos="fade-up">
   <div class="space-y-4 text-base text-gray-700 dark:text-white/80 md:text-lg">
      {paragraphs.map((p) => <p>{p}</p>)}
   </div>

   <div class="mt-10 flex items-start gap-4 rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30">
      <span class="h-12 w-12 flex-shrink-0 rounded-full bg-purple_mv/15 dark:bg-white/10" aria-hidden="true"></span>
      <div>
         <h3 class="font-bold text-gray-900 dark:text-white">{authorBio.name}</h3>
         <p class="mt-1 text-sm italic text-gray-600 dark:text-white/60">{authorBio.text}</p>
      </div>
   </div>
</section>
