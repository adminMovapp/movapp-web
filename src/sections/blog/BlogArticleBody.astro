---
// Cuerpo del artículo (secciones de párrafos, cada una con un H2 opcional) +
// bloque de compartir + tarjeta de bio del equipo autor, en ese orden (ver
// wireframe). Mismo contenedor angosto que BlogArticleHero.astro
// (max-w-3xl) para que el texto se lea cómodo en una sola columna, en vez de
// estirarse a todo el ancho de la página.
//
// "sections" en vez de un solo array plano de párrafos (2026-08-29,
// artículo "prestamax-es-confiable"): ese artículo trae un H2 intermedio
// ("¿Qué pasa si no pago Prestamax?") antes de retomar párrafos -- el
// primer artículo (sin subtítulo) sigue funcionando igual, solo con una
// sección sin "heading".
//
// Cada sección es una secuencia de "blocks" (no solo párrafos, 2026-08-29,
// artículo "lista-montadeudas"): ese artículo intercala grids de íconos de
// apps entre párrafos dentro de la misma sección/país, de ahí el tipo unión
// 'paragraph' | 'appGrid' en vez de un simple array de strings.
//
// Texto justificado (2026-09-03, a pedido explícito: "justifica todo el
// texto de la parte del blog. el contenido que se lee") -- "text-justify"
// en el contenedor del cuerpo (párrafos y listas, por herencia de
// text-align) y en el párrafo de bio del autor. Los títulos H2 y el nombre
// del autor no se ven afectados visualmente: "justify" solo estira el
// espaciado entre palabras en líneas que SÍ envuelven a una siguiente
// línea, un texto de una sola línea se ve igual que con text-align normal.
import { Image } from 'astro:assets';
import ImagePlaceholder from '@components/ui/ImagePlaceholder.astro';
import BlogInline from '@sections/blog/BlogInline.astro';
import BlogArticleShare from '@sections/blog/BlogArticleShare.astro';
import FAQAccordion from '@components/ui/FAQAccordion.astro';
import StarField from '@components/decorative/StarField.astro';
import type { BlogBlock } from '@constants/blogArticles.ts';

// Tipos de bloque: ver BlogBlock en @constants/blogArticles.ts (fuente única
// desde 2026-11-10; antes la unión se repetía aquí). Además de los de antes,
// "subheading" (H3), "callout" (recuadro) y "table" llegaron con las fichas
// ART-001..027, junto con las preguntas frecuentes (H2 + H3 por pregunta,
// las mismas que alimentan el FAQPage del schema) y la lista "Fuentes".
interface Props {
   slug: string;
   sections: { heading?: string; blocks: BlogBlock[] }[];
   faqHeading?: string;
   faqs?: { q: string; a: string }[];
   sourcesList?: string[];
   authorBio: { name: string; text: string };
   shareUrl: string;
   shareTitle: string;
}
const { slug, sections, faqHeading, faqs, sourcesList, authorBio, shareUrl, shareTitle } = Astro.props;

// Negritas inline (2026-08-30, "como-identificar-apps-montadeudas"),
// enlaces y llamadas a fuentes (2026-11-05, Octopus Conference 2026) --
// ver BlogInline.astro.
---

<section class="relative mx-auto max-w-3xl px-4" data-aos="fade-up">
   <StarField id={`blog-article-body-${slug}`} ambientCount={40} />

   <div class="relative z-10 space-y-6 text-justify text-base text-gray-700 dark:text-white/80 md:text-lg">
      {
         sections.map((s) => (
            <div class="space-y-4">
               {s.heading && <h2 class="text-xl font-bold text-text_banner md:text-2xl">{s.heading}</h2>}
               {s.blocks.map((block) =>
                  block.type === 'paragraph' ? (
                     block.mobileText ? (
                        <p>
                           <span class="md:hidden">
                              <BlogInline text={block.mobileText} />
                           </span>
                           <span class="hidden md:inline">
                              <BlogInline text={block.text} />
                           </span>
                        </p>
                     ) : (
                        <p>
                           <BlogInline text={block.text} />
                        </p>
                     )
                  ) : block.type === 'appGrid' ? (
                     <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
                        {block.apps.map((app) => (
                           <li class="flex flex-col items-center rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-4 text-center dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30">
                              {app.icon ? (
                                 <div class="mb-2 flex h-14 w-14 items-center justify-center overflow-hidden rounded-2xl border border-purple_mv/20 bg-purple_mv/5 dark:border-white/10 dark:bg-white/5">
                                    <img
                                       src={app.icon}
                                       alt=""
                                       width="56"
                                       height="56"
                                       class="h-full w-full object-contain p-2"
                                       loading="lazy"
                                    />
                                 </div>
                              ) : (
                                 <ImagePlaceholder class="mb-2 h-14 w-14" />
                              )}
                              <h3 class="text-sm font-bold text-text_banner">{app.name}</h3>
                           </li>
                        ))}
                     </ul>
                  ) : block.type === 'orderedList' ? (
                     <ol
                        start={block.start}
                        class="list-decimal space-y-2 pl-5 marker:font-bold marker:text-text_banner"
                     >
                        {block.items.map((item) => (
                           <li>
                              <BlogInline text={item} />
                           </li>
                        ))}
                     </ol>
                  ) : block.type === 'unorderedList' ? (
                     <ul class="list-disc space-y-2 pl-5 marker:text-text_banner">
                        {block.items.map((item) => (
                           <li>
                              <BlogInline text={item} />
                           </li>
                        ))}
                     </ul>
                  ) : block.type === 'letteredList' ? (
                     <ul class="list-none space-y-1">
                        {block.items.map((item) => (
                           <li>
                              <BlogInline text={item} />
                           </li>
                        ))}
                     </ul>
                  ) : block.type === 'subheading' ? (
                     <h3 class="pt-2 text-left text-lg font-bold text-text_banner md:text-xl">{block.text}</h3>
                  ) : block.type === 'callout' ? (
                     <p class="rounded-r-2xl border-l-4 border-purple_mv bg-purple_mv/[0.06] px-4 py-3 dark:bg-purple_mv/[0.12]">
                        {block.title && <strong class="block font-bold text-text_banner">{block.title}</strong>}
                        <BlogInline text={block.text} />
                     </p>
                  ) : block.type === 'table' ? (
                     // Scroll horizontal propio en móvil: la tabla nunca
                     // empuja el ancho de la página (estándar mobile-first).
                     <div class="overflow-x-auto rounded-2xl border border-purple_mv/25 dark:border-white/10">
                        <table class="w-full min-w-[32rem] border-collapse text-left text-sm md:text-base">
                           <thead class="bg-purple_mv/[0.08] dark:bg-purple_mv/[0.15]">
                              <tr>
                                 {block.head.map((cell) => (
                                    <th scope="col" class="px-3 py-2 font-bold text-text_banner">
                                       <BlogInline text={cell} />
                                    </th>
                                 ))}
                              </tr>
                           </thead>
                           <tbody>
                              {block.rows.map((row) => (
                                 <tr class="border-t border-purple_mv/15 align-top dark:border-white/10">
                                    {row.map((cell) => (
                                       <td class="px-3 py-2">
                                          <BlogInline text={cell} />
                                       </td>
                                    ))}
                                 </tr>
                              ))}
                           </tbody>
                        </table>
                     </div>
                  ) : block.type === 'faqAccordion' ? (
                     // Mismo componente de FAQs del resto del sitio, en modo
                     // "embedded" (ancho/fondo los pone este cuerpo).
                     <FAQAccordion id={`blog-faq-${slug}`} title={block.title} items={block.items} embedded />
                  ) : block.type === 'sources' ? (
                     <ol class="list-none space-y-2 text-left text-sm md:text-base">
                        {block.items.map((item, i) => (
                           <li id={`fuente-${i + 1}`} class="scroll-mt-24">
                              <span class="font-bold text-text_banner">[{i + 1}]</span> <BlogInline text={item} />
                           </li>
                        ))}
                     </ol>
                  ) : block.src ? (
                     // Foto vertical (2026-11-23, EC3): a ancho completo medía
                     // ~1150px de alto en escritorio; se limita a max-w-md y
                     // se centra. En móvil (<448px) no cambia nada.
                     <figure class={block.src.height > block.src.width ? 'mx-auto max-w-md' : undefined}>
                        <Image
                           src={block.src}
                           alt={block.alt}
                           width={1000}
                           class="h-auto w-full rounded-2xl"
                           loading="lazy"
                        />
                        {block.caption && (
                           <figcaption class="mt-2 text-center text-sm italic text-gray-500 dark:text-white/60">
                              {block.caption}
                           </figcaption>
                        )}
                     </figure>
                  ) : (
                     <ImagePlaceholder class="aspect-[16/10] w-full" />
                  ),
               )}
            </div>
         ))
      }

      {
         faqs && faqs.length > 0 && (
            // id = el "#preguntas-frecuentes" del @id del FAQPage (schema).
            <div id="preguntas-frecuentes" class="scroll-mt-24 space-y-4">
               <h2 class="text-xl font-bold text-text_banner md:text-2xl">{faqHeading ?? 'Preguntas frecuentes'}</h2>
               {faqs.map((faq) => (
                  <div class="space-y-1">
                     <h3 class="text-left text-lg font-bold text-text_banner md:text-xl">{faq.q}</h3>
                     <p>
                        <BlogInline text={faq.a} />
                     </p>
                  </div>
               ))}
            </div>
         )
      }

      {
         sourcesList && sourcesList.length > 0 && (
            <div class="space-y-4">
               <h2 class="text-xl font-bold text-text_banner md:text-2xl">Fuentes</h2>
               <ul class="list-disc space-y-2 break-words pl-5 text-left text-sm marker:text-text_banner md:text-base">
                  {sourcesList.map((item) => (
                     <li>
                        <BlogInline text={item} />
                     </li>
                  ))}
               </ul>
            </div>
         )
      }
   </div>

   <BlogArticleShare url={shareUrl} title={shareTitle} slug={slug} />

   <div
      class="mt-10 flex items-start gap-4 rounded-2xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-5 dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30"
   >
      <span class="h-12 w-12 flex-shrink-0 rounded-full bg-purple_mv/15 dark:bg-white/10" aria-hidden="true"></span>
      <div>
         <h3 class="font-bold text-text_banner">{authorBio.name}</h3>
         <p class="mt-1 text-justify text-sm italic text-gray-600 dark:text-white/60">{authorBio.text}</p>
      </div>
   </div>
</section>
