---
// Texto inline de un bloque del cuerpo del artículo (párrafo o item de
// lista). Antes vivía como renderInline() dentro de BlogArticleBody.astro y
// solo entendía negritas; se movió a componente (2026-11-05, artículo de
// Octopus Conference 2026) al sumar enlaces y llamadas a fuentes, para no
// repetir el mismo map en cada tipo de bloque. Sintaxis en los datos:
//   **texto**      -> <strong> negrita Y morado (regla de la skill Importaciones)
//   [texto](href)  -> <a> rastreable; los externos abren en pestaña nueva
//   [^n]           -> llamada [n] que salta a la fuente #fuente-n del bloque
//                     "sources" (BlogArticleBody.astro)
// Cada <a> va en una sola línea a propósito: un salto de línea dentro del
// enlace se renderiza como un espacio subrayado.
interface Props {
   text: string;
}
const { text } = Astro.props;

type Segment = string | { bold: string } | { link: string; href: string } | { ref: string };

const segments: Segment[] = text
   .split(/(\*\*[^*]+\*\*|\[[^\]^][^\]]*\]\([^)]+\)|\[\^\d+\])/g)
   .filter(Boolean)
   .map((part) => {
      if (part.startsWith('**') && part.endsWith('**')) return { bold: part.slice(2, -2) };
      const ref = /^\[\^(\d+)\]$/.exec(part);
      if (ref) return { ref: ref[1] };
      const link = /^\[([^\]]+)\]\(([^)]+)\)$/.exec(part);
      if (link) return { link: link[1], href: link[2] };
      return part;
   });

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
   segments.map((seg) =>
      typeof seg === 'string' ? (
         seg
      ) : 'bold' in seg ? (
         <strong class="font-bold text-text_banner">{seg.bold}</strong>
      ) : 'ref' in seg ? (
         <sup><a href={`#fuente-${seg.ref}`} class="text-text_banner hover:underline" aria-label={`Fuente ${seg.ref}`}>[{seg.ref}]</a></sup>
      ) : isExternal(seg.href) ? (
         <a href={seg.href} target="_blank" rel="noopener" class="font-semibold text-text_banner underline underline-offset-2 hover:no-underline">{seg.link}</a>
      ) : (
         <a href={seg.href} class="font-semibold text-text_banner underline underline-offset-2 hover:no-underline">{seg.link}</a>
      ),
   )
}
