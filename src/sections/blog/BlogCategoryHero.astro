---
// Hero de la plantilla de categoría del blog (ver
// src/pages/blog/[categoria].astro). H1 (único H1 de la página) + texto de
// cuerpo, ambos recibidos por props desde @constants/blogCategoryPages.ts --
// este componente no tiene copy propio, así que sirve igual para cualquier
// categoría nueva que se agregue a ese archivo.
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';

interface Props {
   h1: string;
   intro: string;
   categorySlug: string;
}
const { h1, intro, categorySlug } = Astro.props;
---

<section class="relative mx-auto max-w-3xl px-4 pt-16 text-center md:pt-8" data-aos="fade-up">
   <StarField id={`blog-category-hero-${categorySlug}`} ambientCount={40} />

   <!-- Se resuelve solo desde PAGE_SCHEMA[Astro.url.pathname] (ver
        Breadcrumbs.astro) -- cada categoría nueva en blogCategoryPages.ts YA
        necesita su propia entrada en PAGE_SCHEMA (ver ese archivo), así que
        no hace falta pasarle nada acá. -->
   <Breadcrumbs />

   <h1 class="relative z-10 mx-auto max-w-2xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
      {h1}
   </h1>

   <p class="relative z-10 mx-auto mt-6 max-w-2xl text-base text-gray-700 dark:text-white/80 md:text-lg">
      {intro}
   </p>
</section>
