---
// H1 (único H1 de la página). Breadcrumb visible "Inicio | Aplicaciones" --
// primer uso de este patrón en el sitio (antes solo existía como
// BreadcrumbList invisible en schema.js, ver PAGE_SCHEMA['/directorio-de-apps']),
// ahora vía el componente compartido Breadcrumbs.astro (ver ese archivo:
// resuelve el label solo desde PAGE_SCHEMA, no puede divergir del schema).
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
---

<section class="relative mx-auto max-w-3xl px-4 pt-16 text-center md:pt-8" data-aos="fade-up">
   <StarField id="directorio-hero" ambientCount={40} />

   <Breadcrumbs />

   <h1 class="relative z-10 mx-auto max-w-2xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
      Apps de préstamos legales e ilegales en México
   </h1>

   <p class="relative z-10 mx-auto mt-6 max-w-2xl text-base text-gray-700 dark:text-white/80 md:text-lg">
      Encuentra un listado actualizado con el estatus legal de las apps de crédito en México. Te mostramos las señales de
      alerta para detectar fraudes o "montadeudas" y una guía directa con qué hacer para proteger tu información o
      realizar denuncias de forma segura.
   </p>

   <div class="relative z-10 mt-8">
      <ButtonContact
         id="whatsapp-directorio-hero"
         label="Solicitar orientación por WhatsApp"
         message="¡Hola! Quiero orientación sobre una app de préstamos."
      />
   </div>
</section>
