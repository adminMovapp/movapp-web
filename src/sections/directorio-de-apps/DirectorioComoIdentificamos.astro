---
import { IDENTIFICATION_CRITERIA } from '@constants/directorioApps.ts';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4" data-aos="fade-up">
   <StarField id="directorio-como-identificamos" ambientCount={35} />

   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      ¿Cómo identificamos el estatus de una app?
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-2">
      {
         IDENTIFICATION_CRITERIA.map((label) => (
            <li class="flex items-center gap-3 rounded-full border border-purple_mv/20 bg-purple_mv/5 px-5 py-3 dark:border-white/10 dark:bg-white/5">
               <svg class="h-5 w-5 flex-shrink-0 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 13l4 4L19 7" />
               </svg>
               <span class="font-semibold text-gray-900 dark:text-white">{label}</span>
            </li>
         ))
      }
   </ul>
</section>
