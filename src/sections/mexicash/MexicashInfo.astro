---
// Tarjetas sin título (mismo criterio que FortaprestaInfo.astro). Los 2
// recuadros que el wireframe de escritorio traía vacíos se completaron en
// el wireframe de móviles (2026-08-28) -- contenido aditivo, se agrega igual
// en ambos breakpoints (mismo caso que FortaprestaInfo.astro).
const INFO_ITEMS = [
   'Presta hasta $50,000 pesos.',
   'Ofrece plazos de hasta 360 días.',
   'Anuncia una tasa máxima de 32% anual.',
   'Cobra comisiones adicionales de entre $48 y $180 pesos.',
];
---

<section class="relative mx-auto my-section w-full max-w-3xl px-4" data-aos="fade-up">
   <h2 class="text-center text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
      Información disponible sobre Mexicash
   </h2>

   <ul class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {
         INFO_ITEMS.map((text) => (
            <li class="flex items-center justify-center rounded-2xl bg-gray-100 p-6 text-center dark:bg-white/5">
               <p class="text-sm text-gray-700 dark:text-white/80">{text}</p>
            </li>
         ))
      }
   </ul>
</section>
