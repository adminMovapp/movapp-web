---
// StarField + tarjeta transparente (2026-09-01, a pedido) -- mismo criterio
// que TalaInfo.astro/TalaVerificada.astro.
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
---

<section class="relative mx-auto my-section w-full max-w-2xl px-4" data-aos="fade-up">
   <StarField id="tala-cta" ambientCount={30} />

   <div class="rounded-3xl border border-purple_mv/25 bg-gradient-to-b from-purple_mv/[0.06] to-transparent p-8 text-center dark:border-white/10 dark:from-purple_mv/[0.1] dark:to-black/30 md:p-10">
      <h2 class="text-2xl md:text-4xl font-bold uppercase gradient-text-move bg-gradient-to-r from-gray-900 to-purple_mv bg-clip-text text-transparent dark:from-white dark:to-purple_mv">
         ¿Necesitas orientación sobre Tala?
      </h2>
      <p class="mx-auto mt-4 max-w-md text-gray-700 dark:text-white/80">
         Si necesitas orientación antes de contratar o tienes preguntas sobre sus condiciones, podemos ayudarte.
      </p>
      <div class="mt-6 flex justify-center">
         <ButtonContact id="whatsapp-tala-cta" label="Solicitar orientación" message="¡Hola! Quiero orientación sobre Tala." />
      </div>
   </div>
</section>
