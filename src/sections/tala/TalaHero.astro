---
// H1 (único H1 de la página). Breadcrumb de 2 niveles ("Inicio | Aplicaciones
// | Tala") -- mismo criterio que CrediseguroHero.astro, ver
// PAGE_SCHEMA['/aplicaciones-prestamo/tala'] en schema.js.
import { Image } from 'astro:assets';
import ButtonContact from '@components/ui/ButtonContact.astro';
import StarField from '@components/decorative/StarField.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import { DIRECTORIO_ICONS } from '@constants/directorioApps.ts';
---

<section class="relative mx-auto max-w-3xl px-4 pt-16 text-center md:pt-8" data-aos="fade-up">
   <StarField id="tala-hero" ambientCount={35} />

   <Breadcrumbs items={[{ label: 'Aplicaciones', href: '/aplicaciones-prestamo' }, { label: 'Tala' }]} />

   <h1 class="relative z-10 mx-auto max-w-2xl text-3xl font-bold uppercase leading-tight text-gray-900 dark:text-white md:text-5xl">
      Tala: información verificada, registro y datos de contacto
   </h1>

   <div class="relative z-10 mx-auto mt-8 grid max-w-xl grid-cols-1 items-center gap-6 text-left sm:grid-cols-[auto_1fr] sm:text-left">
      <div class="mx-auto flex h-28 w-28 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-gray-100 dark:bg-white/5 sm:mx-0">
         <Image src={DIRECTORIO_ICONS.tala} alt="" width={112} class="h-full w-full object-contain p-3" loading="lazy" />
      </div>
      <p class="text-center text-gray-700 dark:text-white/80 sm:text-left">
         Consulta los datos disponibles sobre Tala, su registro ante la autoridad correspondiente y la información de
         contacto verificada.
      </p>
   </div>

   <div class="relative z-10 mt-8">
      <ButtonContact id="whatsapp-tala-hero" label="Solicitar orientación" message="¡Hola! Quiero orientación sobre Tala." />
   </div>
</section>
